# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Local secrets never go in the repo
.env
.env.*

# Editors and systems
.DS_Store
.idea/
.vscode/

# Web apps
node_modules/
apps/*/dist/

# TrainMeet Catalog's pictures on disk, when run locally (CATALOG_PICTURES_DIR)
.catalog/

# TrainMeet CAD's module photos on disk, when run locally (CAD_PHOTOS_DIR)
.cad-foton/

# TrainMeet ID: the extension is built by id/Dockerfile
id/email-code/target/

# The background removal's model (CATALOG_BACKGROUND_MODEL): fetched by catalog/Dockerfile, never in the repo
*.onnx
