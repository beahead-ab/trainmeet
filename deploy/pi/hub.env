# Hubbens inställningar på Pi:n. Inga hemligheter här: hubbens egna nycklar ligger i
# /var/lib/trainmeet och skrivs aldrig ut.
TRAINMEET_PREVIEW_DB=/var/lib/trainmeet/provbanan.sqlite3
HUB_WEB_DIR=/opt/trainmeet/current/web
TRAINMEET_USB_DIR=/media/trainmeet-usb
TRAINMEET_HUB_NAME=Pi:n
TRAINMEET_UPDATE_STATUS=/var/lib/trainmeet/update.json
# Mosquitto på samma Pi, för TMBoxarna (DRIFT-22).
TRAINMEET_MQTT_HOST=127.0.0.1
PYTHONUNBUFFERED=1
