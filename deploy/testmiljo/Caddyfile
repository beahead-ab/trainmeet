# Caddy framför testhubben och Catalog. Certifikaten hämtas automatiskt från Let's Encrypt
# när DNS-raderna för HUB_DOMAIN och CATALOG_DOMAIN pekar på servern. Saknas en rad väntar
# den adressen; den andra fungerar ändå.
{
	admin off
}

(skydd) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}

{$HUB_DOMAIN} {
	import skydd
	reverse_proxy hub:8080
}

# TrainMeet Catalog (C35, CAT-218). Catalog sets its own Content-Security-Policy.
{$CATALOG_DOMAIN} {
	import skydd
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy catalog:8080
}
