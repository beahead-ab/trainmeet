# Caddy framför testhubben, Catalog och TrainMeet ID. Certifikaten hämtas automatiskt från
# Let's Encrypt när DNS-raderna för HUB_DOMAIN, CATALOG_DOMAIN och ID_DOMAIN pekar på servern.
# Saknas en rad väntar den adressen; de andra fungerar ändå.
{
	admin off
}

(skydd) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}

{$HUB_DOMAIN} {
	import skydd
	reverse_proxy hub:8080
}

# TrainMeet Catalog (C35, CAT-218). Catalog sets its own Content-Security-Policy.
{$CATALOG_DOMAIN} {
	import skydd
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy catalog:8080
}

# TrainMeet ID (#66, #67). Keycloak answers /realms/ and /resources/ and sets its own headers
# for its pages; its admin pages and management are not reachable from outside. Everything else
# is ID's API and web app.
{$ID_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	respond /admin* 404
	respond /realms/master* 404
	@keycloak path /realms/* /resources/*
	handle @keycloak {
		reverse_proxy id:8080
	}
	handle {
		reverse_proxy id-api:8080
	}
}
