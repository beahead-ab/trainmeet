{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.connection.schema.json",
  "title": "trainmeet.tkl-1.connection",
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "waiting",
        "approved",
        "refused",
        "revoked"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "TklPartPlace": {
      "additionalProperties": true,
      "description": "A part's driftplats in Hubben, with the dispatcher's answer for it (TKL101,\nTRAFIK-35): found by its link, the part's id in the station's outside.",
      "properties": {
        "part": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Part",
          "type": "string"
        },
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        }
      },
      "required": [
        "part",
        "place",
        "status"
      ],
      "title": "TklPartPlace",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "How TKL stands with the hub. The key is never part of it.",
  "properties": {
    "connected": {
      "title": "Connected",
      "type": "boolean"
    },
    "address": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Address"
    },
    "hub_name": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hub Name"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "places": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
        "type": "string"
      },
      "title": "Places",
      "type": "array"
    },
    "place": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stationens egen driftplats, när den är godkänd.",
      "title": "Place"
    },
    "parts": {
      "description": "Delarnas driftplatser, var och en med trafikledningens svar.",
      "items": {
        "$ref": "#/$defs/TklPartPlace"
      },
      "title": "Parts",
      "type": "array"
    },
    "outside_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Utsidan som följde med.",
      "title": "Outside Version"
    },
    "message": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "preview": {
      "default": false,
      "description": "En provkörning i Provbanan, inte en riktig träff (STUDIO-12).",
      "title": "Preview",
      "type": "boolean"
    }
  },
  "required": [
    "connected"
  ],
  "type": "object"
}
