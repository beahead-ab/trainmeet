{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.meet-1.schema.json",
  "title": "trainmeet.meet-1",
  "$defs": {
    "About": {
      "additionalProperties": true,
      "properties": {
        "title": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "program": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Träffens program, som fasta tider.",
          "title": "Program"
        }
      },
      "title": "About",
      "type": "object"
    },
    "Attachment": {
      "additionalProperties": true,
      "description": "A file the package carries, beside the package, with its own checksum.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AttachmentKind"
        },
        "filename": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "media_type": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "filename",
        "media_type",
        "size",
        "sha256"
      ],
      "title": "Attachment",
      "type": "object"
    },
    "AttachmentKind": {
      "enum": [
        "clock_face",
        "sketch",
        "overview",
        "other"
      ],
      "title": "AttachmentKind",
      "type": "string"
    },
    "BoxSide": {
      "additionalProperties": true,
      "properties": {
        "side": {
          "$ref": "#/$defs/Side"
        },
        "label": {
          "description": "Det boxen visar för sidan, till exempel Väster.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "side",
        "label"
      ],
      "title": "BoxSide",
      "type": "object"
    },
    "Call": {
      "additionalProperties": true,
      "description": "Tågbesök: what Drift keeps track of. A train number alone is never a key (A1).",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Planens spårnamn.",
          "title": "Track"
        },
        "arrival": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "day_offset": {
          "default": 0,
          "description": "Speldygn efter tågets första.",
          "maximum": 7,
          "minimum": 0,
          "title": "Day Offset",
          "type": "integer"
        },
        "stops": {
          "default": true,
          "description": "Falskt för ej uppehåll.",
          "title": "Stops",
          "type": "boolean"
        },
        "exchange": {
          "default": true,
          "description": "Falskt för uppehåll utan utbyte: tåget står men lastar inte.",
          "title": "Exchange",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "place"
      ],
      "title": "Call",
      "type": "object"
    },
    "ClearanceMode": {
      "description": "Klareringsläge. Requested: the receiving place answers. Direct: Drift answers at once\nif the section is free. The meet has one; a section may have the other (decided 1 Nov).",
      "enum": [
        "requested",
        "direct"
      ],
      "title": "ClearanceMode",
      "type": "string"
    },
    "Clock": {
      "additionalProperties": true,
      "properties": {
        "start_time": {
          "description": "Modelltiden när klockan startar.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Start Time",
          "type": "string"
        },
        "speed": {
          "default": 1.0,
          "description": "Modellminuter per minut.",
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Speed",
          "type": "number"
        },
        "styles": {
          "description": "Klockans stilar: analog, digital eller custom:<urtavlans id>.",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Styles",
          "type": "array"
        },
        "stop_reasons": {
          "description": "Stoppskälen.",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Stop Reasons",
          "type": "array"
        },
        "faces": {
          "description": "Urtavlorna, som bilagor (F13).",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Faces",
          "type": "array"
        }
      },
      "required": [
        "start_time"
      ],
      "title": "Clock",
      "type": "object"
    },
    "CoupledStation": {
      "additionalProperties": true,
      "description": "A station coupled to the place in advance: its outside pinned to a version (H28).",
      "properties": {
        "station_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Station Id",
          "type": "string"
        },
        "version": {
          "description": "Versionen av stationspaketet som gäller.",
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "outside": {
          "$ref": "#/$defs/StationOutside"
        },
        "track_map": {
          "additionalProperties": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "description": "Planens spårnamn → stationens spår-id.",
          "propertyNames": {
            "maxLength": 500,
            "minLength": 1
          },
          "title": "Track Map",
          "type": "object"
        },
        "exit_map": {
          "description": "Sträckans id → stationens utfart (H26).",
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            }
          },
          "title": "Exit Map",
          "type": "object"
        }
      },
      "required": [
        "station_id",
        "version",
        "outside"
      ],
      "title": "CoupledStation",
      "type": "object"
    },
    "DefaultTrack": {
      "additionalProperties": true,
      "description": "Standard track per train type and direction at a place (B4).",
      "properties": {
        "track": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Track",
          "type": "string"
        },
        "train_type": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tomt betyder alla tågslag.",
          "title": "Train Type"
        },
        "towards": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tomt betyder båda riktningarna."
        }
      },
      "required": [
        "track"
      ],
      "title": "DefaultTrack",
      "type": "object"
    },
    "Display": {
      "additionalProperties": true,
      "properties": {
        "graph_order": {
          "description": "Platserna i grafen.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Graph Order",
          "type": "array"
        },
        "graph_pages": {
          "items": {
            "$ref": "#/$defs/GraphPage"
          },
          "title": "Graph Pages",
          "type": "array"
        }
      },
      "title": "Display",
      "type": "object"
    },
    "Duty": {
      "additionalProperties": true,
      "description": "Köruppdrag. Stored from the start (F23); Lokföraren uses them from step 7.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "legs": {
          "items": {
            "$ref": "#/$defs/DutyLeg"
          },
          "title": "Legs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Duty",
      "type": "object"
    },
    "DutyLeg": {
      "additionalProperties": true,
      "properties": {
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "from_call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "From Call",
          "type": "string"
        },
        "to_call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To Call",
          "type": "string"
        }
      },
      "required": [
        "train",
        "from_call",
        "to_call"
      ],
      "title": "DutyLeg",
      "type": "object"
    },
    "Exit": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "description": "Utfartens fasta id. Kopplas till en sträcka per träff (H26).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side",
          "description": "Vilken sida utfarten ligger på."
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Till exempel Mot Norrby.",
          "title": "Name"
        },
        "tracks": {
          "description": "Stationsspåren som når utfarten, vid gränsen.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Tracks",
          "type": "array"
        },
        "signals": {
          "description": "Signalerna vid gränsen, med sina namn.",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "id",
        "side"
      ],
      "title": "Exit",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": true,
      "description": "From the traffic check (Planering): shown, but does not stop publishing.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "refs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "severity",
        "code",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GraphPage": {
      "additionalProperties": true,
      "description": "Grafens linje: one sheet of the train graph, the places in order along it.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "places": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Places",
          "type": "array"
        },
        "number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linjens nummer i planen.",
          "title": "Number"
        },
        "distances": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Avståndet från första platsen, en per plats och i ordning. Tomt: grafen använder den typiska gångtiden.",
          "title": "Distances"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        }
      },
      "required": [
        "id",
        "name",
        "places"
      ],
      "title": "GraphPage",
      "type": "object"
    },
    "Language": {
      "enum": [
        "sv",
        "en",
        "da",
        "nb",
        "de"
      ],
      "title": "Language",
      "type": "string"
    },
    "Meet": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "country": {
          "default": "se",
          "enum": [
            "se",
            "dk",
            "no",
            "de"
          ],
          "title": "Country",
          "type": "string"
        },
        "timezone": {
          "default": "Europe/Stockholm",
          "maxLength": 500,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "first_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Date"
        },
        "last_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Date"
        },
        "traffic_week": {
          "$ref": "#/$defs/TrafficWeek"
        },
        "clearance_mode": {
          "$ref": "#/$defs/ClearanceMode",
          "default": "requested"
        },
        "settings": {
          "additionalProperties": true,
          "description": "Inställningarna i paketet (en av tre högar, T3). Fylls på när de byggs.",
          "title": "Settings",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Meet",
      "type": "object"
    },
    "Place": {
      "additionalProperties": true,
      "description": "Driftplats: a place from the plan. Sections, calls and protocols point here.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "code": {
          "description": "Signaturen, till exempel Nby.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PlaceKind"
        },
        "remote_from": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Driftplatsen som fjärrstyr.",
          "title": "Remote From"
        },
        "phone": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Träffens leknummer (H30).",
          "title": "Phone"
        },
        "aliases": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/PlanTrack"
          },
          "title": "Tracks",
          "type": "array"
        },
        "default_tracks": {
          "items": {
            "$ref": "#/$defs/DefaultTrack"
          },
          "title": "Default Tracks",
          "type": "array"
        },
        "station": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoupledStation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "instructions": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/Language"
          },
          "title": "Instructions",
          "type": "object"
        },
        "source_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Planens käll-id:n, till exempel för Tellurian.",
          "title": "Source Ids",
          "type": "object"
        }
      },
      "required": [
        "id",
        "code",
        "name",
        "kind"
      ],
      "title": "Place",
      "type": "object"
    },
    "PlaceKind": {
      "description": "Platstyp (F2). Set from the plan; Drift may change manned/unmanned during the meet.",
      "enum": [
        "manned",
        "remote",
        "unmanned",
        "shadow_yard",
        "halt"
      ],
      "title": "PlaceKind",
      "type": "string"
    },
    "PlanTrack": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "description": "Spårets namn i planen, som tågbesöken använder.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sort_order": {
          "default": 0,
          "title": "Sort Order",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "PlanTrack",
      "type": "object"
    },
    "Section": {
      "additionalProperties": true,
      "description": "Sträcka: the plan's clearance section between two places that clear to each other (F1).\nA train gets clearance once for the whole section, even past halts along it.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "place_a": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place A",
          "type": "string"
        },
        "place_b": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place B",
          "type": "string"
        },
        "tracks": {
          "$ref": "#/$defs/TrackKind",
          "default": "single"
        },
        "clearance_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClearanceMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bara om sträckan avviker från träffens grundläge."
        },
        "side_at_a": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
