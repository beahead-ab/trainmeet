{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.hub-1.info.schema.json",
  "title": "trainmeet.hub-1.info",
  "$defs": {
    "MeetRole": {
      "description": "The roles per meet that ID hands out until the Hub logs in with ID (ID10, KONTO-28).",
      "enum": [
        "organizer",
        "dispatcher",
        "loco_lead",
        "remote_clearer"
      ],
      "title": "MeetRole",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "name": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "set_up": {
      "description": "Har hubben fått namn och PIN vid första start?",
      "title": "Set Up",
      "type": "boolean"
    },
    "logged_in": {
      "title": "Logged In",
      "type": "boolean"
    },
    "admin": {
      "default": false,
      "description": "Inloggad med hubbens PIN (H18): får göra allt, också hubbens inställningar.",
      "title": "Admin",
      "type": "boolean"
    },
    "meet_role": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeetRole"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Insläppt med en engångskod (H56): rollen på träffen som kör, och bara där."
    }
  },
  "required": [
    "name",
    "set_up",
    "logged_in"
  ],
  "type": "object"
}
