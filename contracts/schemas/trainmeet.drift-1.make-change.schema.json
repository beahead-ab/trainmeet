{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.drift-1.make-change.schema.json",
  "title": "trainmeet.drift-1.make-change",
  "$defs": {
    "CallTime": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "arrival": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        }
      },
      "required": [
        "call"
      ],
      "title": "CallTime",
      "type": "object"
    },
    "CancelTrain": {
      "additionalProperties": true,
      "description": "Ställ in tåg: the train does not run.",
      "properties": {
        "kind": {
          "const": "cancel",
          "default": "cancel",
          "title": "Kind",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        }
      },
      "required": [
        "train"
      ],
      "title": "CancelTrain",
      "type": "object"
    },
    "ChangeDays": {
      "additionalProperties": true,
      "description": "Ändrade trafikdagar för ett tåg.",
      "properties": {
        "kind": {
          "const": "days",
          "default": "days",
          "title": "Kind",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "days": {
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "minItems": 1,
          "title": "Days",
          "type": "array"
        }
      },
      "required": [
        "train",
        "days"
      ],
      "title": "ChangeDays",
      "type": "object"
    },
    "ChangeNumber": {
      "additionalProperties": true,
      "description": "Byte av tågnummer: the same train, a new number.",
      "properties": {
        "kind": {
          "const": "number",
          "default": "number",
          "title": "Kind",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Number",
          "type": "string"
        }
      },
      "required": [
        "train",
        "number"
      ],
      "title": "ChangeNumber",
      "type": "object"
    },
    "ChangePlace": {
      "additionalProperties": true,
      "description": "Ändrade driftplatser och sträckor: a section closed or opened, or its clearance mode;\nor a place unmanned, left to the automation, or manned again.",
      "properties": {
        "kind": {
          "const": "place",
          "default": "place",
          "title": "Kind",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "closed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closed"
        },
        "clearance_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClearanceMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place"
        },
        "place_kind": {
          "anyOf": [
            {
              "enum": [
                "manned",
                "unmanned"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Kind"
        }
      },
      "title": "ChangePlace",
      "type": "object"
    },
    "ChangeSectionTracks": {
      "additionalProperties": true,
      "description": "Enkel eller dubbel sträcka.",
      "properties": {
        "kind": {
          "const": "tracks",
          "default": "tracks",
          "title": "Kind",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "tracks": {
          "$ref": "#/$defs/TrackKind"
        }
      },
      "required": [
        "section",
        "tracks"
      ],
      "title": "ChangeSectionTracks",
      "type": "object"
    },
    "ChangeTimes": {
      "additionalProperties": true,
      "description": "Ändrade tider (tåg och möten): the whole train, or from a call on, moved some minutes;\nor new times for some calls.",
      "properties": {
        "kind": {
          "const": "times",
          "default": "times",
          "title": "Kind",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "minutes": {
          "default": 0,
          "description": "Minuter senare, eller tidigare.",
          "maximum": 720,
          "minimum": -720,
          "title": "Minutes",
          "type": "integer"
        },
        "from_call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Flytta från avgången här; tomt betyder hela tåget.",
          "title": "From Call"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/CallTime"
          },
          "maxItems": 100,
          "title": "Calls",
          "type": "array"
        }
      },
      "required": [
        "train"
      ],
      "title": "ChangeTimes",
      "type": "object"
    },
    "ChangeTrack": {
      "additionalProperties": true,
      "description": "Ändrat planerat spår: another track for a call.",
      "properties": {
        "kind": {
          "const": "track",
          "default": "track",
          "title": "Kind",
          "type": "string"
        },
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "track": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "call",
        "track"
      ],
      "title": "ChangeTrack",
      "type": "object"
    },
    "ClearanceMode": {
      "description": "Klareringsläge. Requested: the receiving place answers. Direct: Drift answers at once\nif the section is free. The meet has one; a section may have the other (decided 1 Nov).",
      "enum": [
        "requested",
        "direct"
      ],
      "title": "ClearanceMode",
      "type": "string"
    },
    "ExtraCall": {
      "additionalProperties": true,
      "description": "Ett tågbesök i ett tåg efter pappret, som det står på pappret (LOK-13). En tid som inte\ngick att läsa är tom.",
      "properties": {
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "arrival": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        },
        "stops": {
          "default": true,
          "title": "Stops",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "place"
      ],
      "title": "ExtraCall",
      "type": "object"
    },
    "ExtraTrain": {
      "additionalProperties": true,
      "description": "Extratåg (H12): a copy of a train with a new number and time, or from–to with a\ndeparture time, where Drift fills in the places between. A service run after the paper\nbecomes one when Trafikledningen approves it (LOK-13): with the paper's own calls, and the\npaper it came from, which marks it Efter pappret wherever it shows.",
      "properties": {
        "kind": {
          "const": "extra",
          "default": "extra",
          "title": "Kind",
          "type": "string"
        },
        "number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "departure": {
          "description": "Avgången från första driftplatsen.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Departure",
          "type": "string"
        },
        "copy_of": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tåget som kopieras.",
          "title": "Copy Of"
        },
        "from_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Place"
        },
        "to_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Place"
        },
        "days": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Weekday"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Trafikdagarna; tomt betyder kopians dagar, eller alla.",
          "title": "Days"
        },
        "calls": {
          "description": "Tågbesöken som de står på pappret, för ett tåg efter pappret (LOK-13). Drift fyller då inte i något; departure är den första tiden.",
          "items": {
            "$ref": "#/$defs/ExtraCall"
          },
          "maxItems": 200,
          "title": "Calls",
          "type": "array"
        },
        "paper": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tjänsten efter pappret som tåget kommer från: märkt Efter pappret (LOK-13).",
          "title": "Paper"
        }
      },
      "required": [
        "number",
        "departure"
      ],
      "title": "ExtraTrain",
      "type": "object"
    },
    "NoStop": {
      "additionalProperties": true,
      "description": "Ej uppehåll: the train passes the place without stopping (genomfart), or stops again.",
      "properties": {
        "kind": {
          "const": "no_stop",
          "default": "no_stop",
          "title": "Kind",
          "type": "string"
        },
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "stops": {
          "default": false,
          "title": "Stops",
          "type": "boolean"
        }
      },
      "required": [
        "call"
      ],
      "title": "NoStop",
      "type": "object"
    },
    "TrackKind": {
      "enum": [
        "single",
        "double"
      ],
      "title": "TrackKind",
      "type": "string"
    },
    "TrainNote": {
      "additionalProperties": true,
      "description": "Anmärkning: text that follows the train, or one of its calls. Empty takes it away.",
      "properties": {
        "kind": {
          "const": "note",
          "default": "note",
          "title": "Kind",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "train"
      ],
      "title": "TrainNote",
      "type": "object"
    },
    "Weekday": {
      "description": "The timetable's weekday (trafikdag). Not the same as the game day (Dag 1…N).",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "title": "Weekday",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Ny driftändring from Nu (TRAFIK-02).",
  "properties": {
    "change": {
      "discriminator": {
        "mapping": {
          "cancel": "#/$defs/CancelTrain",
          "days": "#/$defs/ChangeDays",
          "extra": "#/$defs/ExtraTrain",
          "no_stop": "#/$defs/NoStop",
          "note": "#/$defs/TrainNote",
          "number": "#/$defs/ChangeNumber",
          "place": "#/$defs/ChangePlace",
          "times": "#/$defs/ChangeTimes",
          "track": "#/$defs/ChangeTrack",
          "tracks": "#/$defs/ChangeSectionTracks"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CancelTrain"
        },
        {
          "$ref": "#/$defs/ExtraTrain"
        },
        {
          "$ref": "#/$defs/ChangeTimes"
        },
        {
          "$ref": "#/$defs/ChangePlace"
        },
        {
          "$ref": "#/$defs/ChangeTrack"
        },
        {
          "$ref": "#/$defs/ChangeSectionTracks"
        },
        {
          "$ref": "#/$defs/ChangeDays"
        },
        {
          "$ref": "#/$defs/ChangeNumber"
        },
        {
          "$ref": "#/$defs/NoStop"
        },
        {
          "$ref": "#/$defs/TrainNote"
        }
      ],
      "title": "Change"
    },
    "force": {
      "default": false,
      "description": "Tvinga igenom mot ett tåg som är ute eller har öppen klarering (H38).",
      "title": "Force",
      "type": "boolean"
    }
  },
  "required": [
    "change"
  ],
  "type": "object"
}
