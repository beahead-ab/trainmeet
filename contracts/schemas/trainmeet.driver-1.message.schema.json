{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.driver-1.message.schema.json",
  "title": "trainmeet.driver-1.message",
  "$defs": {
    "DriverMessageKind": {
      "description": "Förarens färdiga meddelanden till trafikledningen (LOK-23, DRIFT-38).",
      "enum": [
        "delayed",
        "stopped_on_line",
        "needs_help",
        "engine_trouble"
      ],
      "title": "DriverMessageKind",
      "type": "string"
    },
    "ServiceKind": {
      "enum": [
        "duty",
        "train",
        "paper"
      ],
      "title": "ServiceKind",
      "type": "string"
    },
    "ServiceRef": {
      "additionalProperties": true,
      "description": "En tjänst: ett köruppdrag ur träffpaketet, eller ett tåg med körplan ur tidtabellen.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ServiceKind"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "ServiceRef",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Ett meddelande till trafikledningen: förare, tjänst, tåg och tid (LOK-23).",
  "properties": {
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/DriverMessageKind"
    },
    "driver": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Driver",
      "type": "string"
    },
    "driver_name": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Driver Name"
    },
    "service": {
      "anyOf": [
        {
          "$ref": "#/$defs/ServiceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "service_number": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service Number"
    },
    "train": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Train"
    },
    "train_number": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Train Number"
    },
    "model_time": {
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "title": "Model Time",
      "type": "string"
    },
    "wall_time": {
      "format": "date-time",
      "title": "Wall Time",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "kind",
    "driver",
    "model_time",
    "wall_time"
  ],
  "type": "object"
}
