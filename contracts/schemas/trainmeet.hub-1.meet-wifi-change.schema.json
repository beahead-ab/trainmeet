{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.hub-1.meet-wifi-change.schema.json",
  "title": "trainmeet.hub-1.meet-wifi-change",
  "additionalProperties": true,
  "description": "Ändra träffens Wi-Fi. Utan nytt lösenord står det som var kvar, så länge namnet finns.",
  "properties": {
    "name": {
      "default": "",
      "maxLength": 32,
      "title": "Name",
      "type": "string"
    },
    "open": {
      "default": false,
      "title": "Open",
      "type": "boolean"
    },
    "password": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "8–63 tecken. Skrivs aldrig ut i loggen och skickas aldrig tillbaka hit.",
      "title": "Password"
    }
  },
  "type": "object"
}
