{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.driver-1.overview.schema.json",
  "title": "trainmeet.driver-1.overview",
  "$defs": {
    "CheckedIn": {
      "additionalProperties": true,
      "description": "Förarens senaste incheckning, så länge den syns: 10 spelminuter och sedan 5 till medan\nden tonar ut (A8).",
      "properties": {
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "place_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Place Name",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        },
        "train": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train"
        },
        "train_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Number"
        },
        "model_time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Model Time",
          "type": "string"
        },
        "age_seconds": {
          "description": "Spelsekunder sedan incheckningen.",
          "minimum": 0,
          "title": "Age Seconds",
          "type": "number"
        },
        "fading": {
          "default": false,
          "description": "Tonar ut.",
          "title": "Fading",
          "type": "boolean"
        }
      },
      "required": [
        "place",
        "place_name",
        "model_time",
        "age_seconds"
      ],
      "title": "CheckedIn",
      "type": "object"
    },
    "Driver": {
      "additionalProperties": true,
      "description": "En förare på träffen. Namn, initialer och foto bara där reglerna tillåter (LOK-37).",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tomt över internet utan inloggning.",
          "title": "Name"
        },
        "initials": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initials"
        },
        "level": {
          "$ref": "#/$defs/DriverLevel"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/DriverState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "photo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Adressen till fotot, om det finns.",
          "title": "Photo"
        },
        "linked": {
          "default": false,
          "description": "Kopplad till en person i TrainMeet ID.",
          "title": "Linked",
          "type": "boolean"
        },
        "joined": {
          "format": "date-time",
          "title": "Joined",
          "type": "string"
        }
      },
      "required": [
        "id",
        "level",
        "joined"
      ],
      "title": "Driver",
      "type": "object"
    },
    "DriverAlarm": {
      "additionalProperties": true,
      "description": "Ett tåg står utan förare på linjen (LOK-35): tjänsten släpptes där och ingen har tagit\növer. Utan förarens namn (B13).",
      "properties": {
        "service": {
          "$ref": "#/$defs/ServiceRef"
        },
        "number": {
          "description": "Tjänstens nummer, eller tågets.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "train": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train"
        },
        "train_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Number"
        },
        "section": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "from_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Place"
        },
        "to_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Place"
        },
        "since": {
          "description": "Modelltiden när tjänsten släpptes.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Since",
          "type": "string"
        },
        "seq": {
          "description": "Drifthändelsen då tjänsten släpptes.",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "service",
        "number",
        "since",
        "seq"
      ],
      "title": "DriverAlarm",
      "type": "object"
    },
    "DriverLevel": {
      "description": "Svårigheten på köruppdragets framsida, och förarens nivå (LOK-19, LOK-32).",
      "enum": [
        "easy",
        "medium",
        "experienced"
      ],
      "title": "DriverLevel",
      "type": "string"
    },
    "DriverMessage": {
      "additionalProperties": true,
      "description": "Ett meddelande till trafikledningen: förare, tjänst, tåg och tid (LOK-23).",
      "properties": {
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/DriverMessageKind"
        },
        "driver": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Driver",
          "type": "string"
        },
        "driver_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver Name"
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "service_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Number"
        },
        "train": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train"
        },
        "train_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Number"
        },
        "model_time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Model Time",
          "type": "string"
        },
        "wall_time": {
          "format": "date-time",
          "title": "Wall Time",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "kind",
        "driver",
        "model_time",
        "wall_time"
      ],
      "title": "DriverMessage",
      "type": "object"
    },
    "DriverMessageKind": {
      "description": "Förarens färdiga meddelanden till trafikledningen (LOK-23, DRIFT-38).",
      "enum": [
        "delayed",
        "stopped_on_line",
        "needs_help",
        "engine_trouble"
      ],
      "title": "DriverMessageKind",
      "type": "string"
    },
    "DriverRow": {
      "additionalProperties": true,
      "description": "En förare i trafikledningens lista: tjänsten, incheckningen, läget och senaste\nmeddelandet.",
      "properties": {
        "driver": {
          "$ref": "#/$defs/Driver"
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkin": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckedIn"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrainPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/$defs/DriverMessage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "driver"
      ],
      "title": "DriverRow",
      "type": "object"
    },
    "DriverSettings": {
      "additionalProperties": true,
      "description": "Vad förarna får se och göra i trafikspelet (LOK-20, LOK-21, LOK-39). Allt är av som\nförval, och bara trafikledningen ändrar det.",
      "properties": {
        "reality": {
          "default": false,
          "description": "Förarna ser verkligheten: var tåget är enligt stationerna, förseningen och sena mötande tåg.",
          "title": "Reality",
          "type": "boolean"
        },
        "clearances": {
          "default": false,
          "description": "Förarna ser tågklareringens besked: sträckan klar, spåret och att stationen väntar.",
          "title": "Clearances",
          "type": "boolean"
        },
        "arrival": {
          "default": false,
          "description": "Framme räknas som ankomst, bara på obemannade driftplatser (LOK-39).",
          "title": "Arrival",
          "type": "boolean"
        }
      },
      "title": "DriverSettings",
      "type": "object"
    },
    "DriverState": {
      "description": "What the others see of a driver without a service on the line (LOK-27).",
      "enum": [
        "pause",
        "waiting_start"
      ],
      "title": "DriverState",
      "type": "string"
    },
    "PaperEnd": {
      "additionalProperties": true,
      "description": "Där tjänsten startar eller slutar, som det står på papprets framsida.",
      "properties": {
        "time": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tom när den inte gick att läsa.",
          "title": "Time"
        },
        "place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Driftplatsen i träffen; tom när namnet inte finns där.",
          "title": "Place"
        },
        "place_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platsen som den står på pappret.",
          "title": "Place Name"
        },
        "unreadable": {
          "default": false,
          "description": "Något stod där men gick inte att läsa.",
          "title": "Unreadable",
          "type": "boolean"
        }
      },
      "title": "PaperEnd",
      "type": "object"
    },
    "PaperPayer": {
      "description": "Vem som stod för AI-läsningen (LOK-33).",
      "enum": [
        "meet",
        "driver",
        "hub"
      ],
      "title": "PaperPayer",
      "type": "string"
    },
    "PaperRow": {
      "additionalProperties": true,
      "description": "En rad i papprets tidtabell, som AI:n läste den. AI föreslår bara: en tid som inte gick\natt läsa är tom och raden märkt, aldrig gissad (LOK-29).",
      "properties": {
        "place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Driftplatsen i träffen; tom när namnet inte finns där.",
          "title": "Place"
        },
        "place_name": {
          "description": "Platsen som den står på pappret.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Place Name",
          "type": "string"
        },
        "arrival": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        },
        "stops": {
          "default": true,
          "description": "Falskt när det står Ej uppehåll.",
          "title": "Stops",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "unreadable": {
          "default": false,
          "description": "En tid stod på raden men gick inte att läsa.",
          "title": "Unreadable",
          "type": "boolean"
        }
      },
      "required": [
        "place_name"
      ],
      "title": "PaperRow",
      "type": "object"
    },
    "PaperService": {
      "additionalProperties": true,
      "description": "En tjänst efter pappret, som föraren och Förare ser den: framsidan och tidtabellen som\nAI:n läste dem, var den står, och de tjänster i planen som startar närmast (LF16). Inga\nstationer ser den förrän trafikledningen har godkänt den (LOK-13).",
      "properties": {
        "paper": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Paper",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceRef"
        },
        "status": {
          "$ref": "#/$defs/PaperStatus"
        },
        "driver": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Driver",
          "type": "string"
        },
        "driver_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bara där namn får visas.",
          "title": "Driver Name"
        },
        "number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tjänstens nummer på pappret.",
          "title": "Number"
        },
        "train_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tågnumret: på pappret, eller det trafikledningen gav.",
          "title": "Train Number"
        },
        "operator": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "start": {
          "$ref": "#/$defs/PaperEnd"
        },
        "end": {
          "$ref": "#/$defs/PaperEnd"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/PaperRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "pages": {
          "maximum": 4,
          "minimum": 1,
          "title": "Pages",
          "type": "integer"
        },
        "photos": {
          "description": "Adresserna till fotona.",
          "items": {
            "type": "string"
          },
          "title": "Photos",
          "type": "array"
        },
        "paid_by": {
          "$ref": "#/$defs/PaperPayer"
        },
        "cost": {
          "description": "Tokens som drogs för läsningen.",
          "minimum": 0,
          "title": "Cost",
          "type": "integer"
        },
        "said": {
          "description": "Pappret jämfört med planen: ingen tjänst startar där och då, eller vilken som gör det.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Said",
          "type": "string"
        },
        "candidates": {
          "description": "Tjänsterna i planen som startar närmast papprets start (LF16). Föraren kan ta en av dem i stället.",
          "items": {
            "$ref": "#/$defs/ServiceOffer"
          },
          "title": "Candidates",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Avslagen: trafikledningens skäl.",
          "title": "Reason"
        },
        "train": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Godkänd: tåget i Drift.",
          "title": "Train"
        },
        "model_time": {
          "description": "När pappret lästes, på träffklockan.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Model Time",
          "type": "string"
        },
        "wall_time": {
          "format": "date-time",
          "title": "Wall Time",
          "type": "string"
        }
      },
      "required": [
        "paper",
        "service",
        "status",
        "driver",
        "start",
        "end",
        "pages",
        "paid_by",
        "cost",
        "said",
        "model_time",
        "wall_time"
      ],
      "title": "PaperService",
      "type": "object"
    },
    "PaperStatus": {
      "description": "Var en tjänst efter pappret står.",
      "enum": [
        "waiting",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "title": "PaperStatus",
      "type": "string"
    },
    "ServiceEnd": {
      "additionalProperties": true,
      "description": "Där tjänsten startar eller slutar, som på framsidan: tid och driftplats.",
      "properties": {
        "time": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "place_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Place Name",
          "type": "string"
        }
      },
      "required": [
        "place",
        "place_name"
      ],
      "title": "ServiceEnd",
      "type": "object"
    },
    "ServiceKind": {
      "enum": [
        "duty",
        "train",
        "paper"
      ],
      "title": "ServiceKind",
      "type": "string"
    },
    "ServiceList": {
      "additionalProperties": true,
      "description": "Tjänsterna att välja bland: köruppdragen när träffen har sådana, annars tågen (LOK-17,\nLOK-31). Släppta på linjen först, sedan de som passar förarens nivå, i startordning.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ServiceKind"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceOffer"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ServiceList",
      "type": "object"
    },
    "ServiceOffer": {
      "additionalProperties": true,
