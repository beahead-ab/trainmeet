{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.drift-1.service.schema.json",
  "title": "trainmeet.drift-1.service",
  "$defs": {
    "ServiceKind": {
      "enum": [
        "duty",
        "train"
      ],
      "title": "ServiceKind",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "En tjänst: ett köruppdrag ur träffpaketet, eller ett tåg med körplan ur tidtabellen.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/ServiceKind"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Id",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "type": "object"
}
