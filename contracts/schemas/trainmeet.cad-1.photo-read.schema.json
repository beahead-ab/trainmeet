{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.photo-read.schema.json",
  "title": "trainmeet.cad-1.photo-read",
  "additionalProperties": true,
  "description": "Läs av: the corners, Kant 1 and gable A as the owner confirmed them, in the preview's\npixels, with or without AI; on a sketch, the frame that is this module.",
  "properties": {
    "corners": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Corners",
      "type": "array"
    },
    "kant1": {
      "maximum": 3,
      "minimum": 0,
      "title": "Kant1",
      "type": "integer"
    },
    "gable_a": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null: before Kant 1.",
      "title": "Gable A"
    },
    "frame": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frame"
    },
    "ai": {
      "default": true,
      "title": "Ai",
      "type": "boolean"
    },
    "consent": {
      "default": false,
      "title": "Consent",
      "type": "boolean"
    }
  },
  "required": [
    "corners",
    "kant1"
  ],
  "type": "object"
}
