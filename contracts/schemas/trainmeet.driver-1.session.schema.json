{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.driver-1.session.schema.json",
  "title": "trainmeet.driver-1.session",
  "$defs": {
    "Driver": {
      "additionalProperties": true,
      "description": "En förare på träffen. Namn, initialer och foto bara där reglerna tillåter (LOK-37).",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tomt över internet utan inloggning.",
          "title": "Name"
        },
        "initials": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initials"
        },
        "level": {
          "$ref": "#/$defs/DriverLevel"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/DriverState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "photo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Adressen till fotot, om det finns.",
          "title": "Photo"
        },
        "linked": {
          "default": false,
          "description": "Kopplad till en person i TrainMeet ID.",
          "title": "Linked",
          "type": "boolean"
        },
        "joined": {
          "format": "date-time",
          "title": "Joined",
          "type": "string"
        }
      },
      "required": [
        "id",
        "level",
        "joined"
      ],
      "title": "Driver",
      "type": "object"
    },
    "DriverLevel": {
      "description": "Svårigheten på köruppdragets framsida, och förarens nivå (LOK-19, LOK-32).",
      "enum": [
        "easy",
        "medium",
        "experienced"
      ],
      "title": "DriverLevel",
      "type": "string"
    },
    "DriverState": {
      "description": "What the others see of a driver without a service on the line (LOK-27).",
      "enum": [
        "pause",
        "waiting_start"
      ],
      "title": "DriverState",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Svaret på Kom in: föraren och nyckeln, som visas en gång och sparas på telefonen.",
  "properties": {
    "driver": {
      "$ref": "#/$defs/Driver"
    },
    "key": {
      "description": "Telefonens nyckel. Hubben sparar bara ett kontrollvärde.",
      "title": "Key",
      "type": "string"
    }
  },
  "required": [
    "driver",
    "key"
  ],
  "type": "object"
}
