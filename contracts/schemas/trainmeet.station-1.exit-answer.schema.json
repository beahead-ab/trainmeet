    },
    "exit": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Exit",
      "type": "string"
    }
  },
  "required": [
    "section",
    "exit"
  ],
  "type": "object"
}
