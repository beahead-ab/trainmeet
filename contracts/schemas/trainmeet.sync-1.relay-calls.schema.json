{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.sync-1.relay-calls.schema.json",
  "title": "trainmeet.sync-1.relay-calls",
  "$defs": {
    "Action": {
      "enum": [
        "train.lookup",
        "train.track.change",
        "train.departed",
        "train.arrived",
        "train.position.set",
        "train.crew_ready.set",
        "train.set_aside",
        "clearance.request",
        "clearance.response",
        "clearance.cancel",
        "line.available.publish",
        "line.available.acknowledge",
        "section.occupancy",
        "signal.exit",
        "place.leave",
        "place.take_back",
        "place.offer",
        "place.offer.answer",
        "route.request",
        "route.cancel",
        "route.response",
        "route.state"
      ],
      "title": "Action",
      "type": "string"
    },
    "Automat": {
      "additionalProperties": true,
      "description": "A station automat in the station's own interlocking (FR24). Switched on and off by whoever\ncontrols the station: on the spot when manned, from the remote picture when remote-controlled\n(FR25).",
      "properties": {
        "code": {
          "description": "Koden vid stationsnamnet, till exempel A3, AU21 eller L01. Flera av samma slag skiljs åt med infartssignalens nummer (FR40).",
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AutomatKind"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "description": "Förvald: stationen kopplar in den själv efter 90 sekunder utan kontakt med den som fjärrstyr (FR29).",
          "title": "Default"
        }
      },
      "required": [
        "code",
        "kind"
      ],
      "title": "Automat",
      "type": "object"
    },
    "AutomatKind": {
      "description": "The station automats (FR24, FR39), as in interlockings 85 and 95.",
      "enum": [
        "a1",
        "a2",
        "a3",
        "an",
        "au",
        "local_release"
      ],
      "title": "AutomatKind",
      "type": "string"
    },
    "BoxSide": {
      "additionalProperties": true,
      "properties": {
        "side": {
          "$ref": "#/$defs/Side"
        },
        "label": {
          "description": "Det boxen visar för sidan, till exempel Väster.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "side",
        "label"
      ],
      "title": "BoxSide",
      "type": "object"
    },
    "ClientKind": {
      "enum": [
        "tkl",
        "tmbox_app",
        "dispatch",
        "remote"
      ],
      "title": "ClientKind",
      "type": "string"
    },
    "Command": {
      "additionalProperties": true,
      "properties": {
        "protocol": {
          "const": "trainmeet.station/1",
          "default": "trainmeet.station/1",
          "title": "Protocol",
          "type": "string"
        },
        "message_id": {
          "description": "Unikt per klient. Samma id ger samma svar.",
          "pattern": "^[A-Za-z0-9._:-]{8,120}$",
          "title": "Message Id",
          "type": "string"
        },
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Client Id",
          "type": "string"
        },
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/MeetContext"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "expected_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exakt en scope och nyckel; utelämnas för train.lookup."
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "message_id",
        "client_id",
        "place",
        "context",
        "action"
      ],
      "title": "Command",
      "type": "object"
    },
    "ConnectRequest": {
      "additionalProperties": true,
      "description": "The client says what it is, which station it is and which places it wants to run.\nA TKL that is not coupled in advance sends its outside along (H28).\n\nA station with parts that are their own driftplatser lists them in its outside (TKL101), and\nasks for one driftplats per part besides the station's (TRAFIK-35). Without wants Hubben\nfills them in: the station's place and each part's, coupled in advance in the version or\nfound by the part's id or name. Trafikledningen approves each on its own in Klienter.",
      "properties": {
        "protocol": {
          "const": "trainmeet.station/1",
          "default": "trainmeet.station/1",
          "title": "Protocol",
          "type": "string"
        },
        "protocols": {
          "description": "Alla versioner klienten talar.",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Protocols",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ClientKind"
        },
        "name": {
          "description": "Det trafikledningen ser i Klienter.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "software": {
          "description": "Program och version, till exempel TKL 0.1.0.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Software",
          "type": "string"
        },
        "station_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Station Id"
        },
        "outside": {
          "anyOf": [
            {
              "$ref": "#/$defs/StationOutside"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wants": {
          "description": "Driftplatserna den vill köra. Tomt: Hubben föreslår stationens driftplats och en per del i utsidan (TRAFIK-35).",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Wants",
          "type": "array"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provbanans kod, bara i en provkörning: den visar vilken körning det gäller.",
          "title": "Code"
        },
        "level": {
          "default": 0,
          "description": "Stationens nivå i TKL (0–3). Hubben tar emot section.occupancy bara från en station på nivå 3 (DRIFT-10, KLAR-16); den gäller till nästa anslutning.",
          "maximum": 3,
          "minimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "preview_only": {
          "default": false,
          "description": "Prova i TKL: bara en provkörning i Provbanan, aldrig en riktig träff. Hubben säger nej till en riktig träff (STUDIO-12).",
          "title": "Preview Only",
          "type": "boolean"
        },
        "remote_area": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bara för ett fjärrställverk: planens fjärrområde. Utan wants föreslår Hubben dess driftplatser (FR49).",
          "title": "Remote Area"
        }
      },
      "required": [
        "kind",
        "name",
        "software"
      ],
      "title": "ConnectRequest",
      "type": "object"
    },
    "Exit": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "description": "Utfartens fasta id. Kopplas till en sträcka per träff (H26).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side",
          "description": "Vilken sida utfarten ligger på."
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Till exempel Mot Norrby.",
          "title": "Name"
        },
        "tracks": {
          "description": "Stationsspåren som når utfarten, vid gränsen.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Tracks",
          "type": "array"
        },
        "signals": {
          "description": "Signalerna vid gränsen, med sina namn.",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "id",
        "side"
      ],
      "title": "Exit",
      "type": "object"
    },
    "ExitAnswer": {
      "additionalProperties": true,
      "description": "Svaret från TKL: POST /api/station/1/places/{place}/exits med nyckeln.",
      "properties": {
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "exit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Exit",
          "type": "string"
        }
      },
      "required": [
        "section",
        "exit"
      ],
      "title": "ExitAnswer",
      "type": "object"
    },
    "MeetContext": {
      "additionalProperties": true,
      "description": "Which meet, version and game day the client saw. A command for another is refused\nwith stale_meet_context, so an old choice never survives a change of meet or day.",
      "properties": {
        "meet_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Meet Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        },
        "epoch": {
          "description": "Ledarskapets epok; byts vid övertag.",
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        }
      },
      "required": [
        "meet_id",
        "version",
        "game_day",
        "epoch"
      ],
      "title": "MeetContext",
      "type": "object"
    },
    "OverviewDrawing": {
      "additionalProperties": true,
      "description": "The outside's overview (FR31, FR48, TKL88): a simple drawing, in a grid read from left to\nright, of the tracks, switches and main signals that are controlled centrally. Every signal\nand switch sits on a horizontal line, as in the remote picture. Tracks no catalogue route\nreaches are left out, and there are no switch numbers, dwarf signals or addresses. Each\ncatalogue route names the pieces and links it lays, in order, so that a locked route can be\ndrawn and the switches' lie seen. Studio makes it from the drawing.",
      "properties": {
        "columns": {
          "description": "Rutnätets bredd i kolumner.",
          "maximum": 400,
          "minimum": 1,
          "title": "Columns",
          "type": "integer"
        },
        "rows": {
          "description": "Rutnätets höjd i rader.",
          "maximum": 40,
          "minimum": 1,
          "title": "Rows",
          "type": "integer"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/OverviewTrack"
          },
          "title": "Tracks",
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/OverviewLink"
          },
          "title": "Links",
          "type": "array"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/OverviewSignal"
          },
          "title": "Signals",
          "type": "array"
        },
        "exits": {
          "items": {
            "$ref": "#/$defs/OverviewExit"
          },
          "title": "Exits",
          "type": "array"
        },
        "routes": {
          "description": "Katalogvägens id → bitarna och strecken den lägger, i ordning.",
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$": {
              "items": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Routes",
          "type": "object"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "OverviewDrawing",
      "type": "object"
    },
    "OverviewExit": {
      "additionalProperties": true,
      "description": "Where a line end leaves the drawing.",
      "properties": {
        "exit": {
          "description": "Utfartens id i utsidan.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Exit",
          "type": "string"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        }
      },
      "required": [
        "exit",
        "row",
        "column"
      ],
      "title": "OverviewExit",
      "type": "object"
    },
    "OverviewLink": {
      "additionalProperties": true,
      "description": "A switch as a line between two rows (växeln som streck, FR31, FR36): from a point on one\nrow to a point on another. No number, no address.",
      "properties": {
        "id": {
          "description": "Streckets id i översikten. Aldrig växelns nummer.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "from_row": {
          "minimum": 0,
          "title": "From Row",
          "type": "integer"
        },
        "from_column": {
          "minimum": 0,
          "title": "From Column",
          "type": "integer"
        },
        "to_row": {
          "minimum": 0,
          "title": "To Row",
          "type": "integer"
        },
        "to_column": {
          "minimum": 0,
          "title": "To Column",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "from_row",
        "from_column",
        "to_row",
        "to_column"
      ],
      "title": "OverviewLink",
      "type": "object"
    },
    "OverviewSignal": {
      "additionalProperties": true,
      "description": "A main signal with its number, where it stands and which way it faces. The catalogue's\nroutes start and end at them (FR31). Dwarf signals are never in the overview (FR36).",
      "properties": {
        "name": {
          "description": "Signalens nummer, som i tågvägarna.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "towards": {
          "$ref": "#/$defs/Side",
          "description": "Åt vilket håll signalen visar."
        }
      },
      "required": [
        "name",
        "row",
        "column",
        "towards"
      ],
      "title": "OverviewSignal",
      "type": "object"
    },
    "OverviewTrack": {
      "additionalProperties": true,
      "description": "A horizontal piece of track in the overview, on one row of the grid.",
      "properties": {
        "id": {
          "description": "Bitens id i översikten. Inte ett nummer eller en adress.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "row": {
          "description": "Raden, uppifrån och från 0.",
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "start": {
          "description": "Kolumnen där biten börjar, från vänster och från 0.",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "Kolumnen där biten slutar, till höger om start.",
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "track": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stationsspåret biten är, med spårets id i utsidan.",
          "title": "Track"
        },
        "platform": {
          "default": false,
          "description": "Biten har plattform.",
          "title": "Platform",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "row",
        "start",
        "end"
      ],
      "title": "OverviewTrack",
      "type": "object"
    },
    "PushToken": {
      "additionalProperties": true,
      "description": "Telefonens adress för push, som appen ger hubben när den är godkänd:\nPUT /api/station/1/push med nyckeln, DELETE för att sluta. Den finns bara hos hubben som\nleder och skrivs aldrig ut.",
      "properties": {
        "platform": {
          "const": "apns",
          "default": "apns",
          "title": "Platform",
          "type": "string"
        },
        "token": {
          "pattern": "^[0-9a-fA-F]{64,200}$",
          "title": "Token",
          "type": "string"
        },
        "sandbox": {
          "default": false,
          "description": "Apples utvecklingsmiljö, för en app som är byggd för prov.",
          "title": "Sandbox",
          "type": "boolean"
        }
      },
      "required": [
        "token"
      ],
      "title": "PushToken",
      "type": "object"
    },
    "ReceiverKind": {
      "description": "Who may receive the station when it is handed over (FR3, TKL46, TKL47).",
      "enum": [
        "neighbours",
        "remote"
      ],
      "title": "ReceiverKind",
      "type": "string"
    },
    "RelayCall": {
      "additionalProperties": true,
      "description": "Ett anrop i stationsprotokollet från en telefon eller molnets TKL utanför träffens nät.\nMolnet ställer det i kö till hubben som leder, och den hämtar det på sin egen förbindelse\n(SYNK-11, SYNK-13). Molnet sparar ingenting av trafiken (SYNK-22).",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RelayKind"
        },
        "key_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Klientens nyckel som SHA-256: nyckeln själv följer aldrig med (H31).",
          "title": "Key Hash"
        },
        "place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place"
        },
        "client_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "connect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/Command"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "known": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platsens revision som klienten har.",
          "title": "Known"
        },
        "wait": {
          "default": 0.0,
          "maximum": 20.0,
          "minimum": 0.0,
          "title": "Wait",
          "type": "number"
        },
        "push": {
          "anyOf": [
            {
              "$ref": "#/$defs/PushToken"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitAnswer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "track_display": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrackDisplayChange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "places": {
          "description": "Driftplatserna i översikten (#36).",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Places",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "RelayCall",
      "type": "object"
    },
    "RelayKind": {
      "enum": [
        "connect",
        "connection",
        "snapshot",
        "command",
        "revision",
        "push",
        "exit",
        "track_display",
        "overview"
      ],
      "title": "RelayKind",
      "type": "string"
    },
    "RemoteRoute": {
      "additionalProperties": true,
      "description": "A route in the remote catalogue (fjärrkatalog, TKL46, FR10): one of the station's own\ntrain routes that may be requested from afar. Shunting routes never are. The catalogue only\nsays what may be asked for; the station's interlocking tries each request as if it had been\nlaid on the spot (FR12).",
      "properties": {
        "id": {
          "description": "Tågvägens fasta id i stationen, till exempel 21-33.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "start": {
