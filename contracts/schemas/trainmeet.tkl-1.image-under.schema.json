{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.image-under.schema.json",
  "title": "trainmeet.tkl-1.image-under",
  "$defs": {
    "TklCadImage": {
      "additionalProperties": true,
      "description": "A module's measuring image from TrainMeet CAD, kept with the station so that Foto shows it\nwithout internet (#89 del d4, CAD-13, CAD-33). matrix, SVG's (a, b, c, d, e, f), takes the\nimage's pixels ((0, 0) its top left corner, y down) to the station's real geometry in mm,\nwhich is the source's in CAD (contracts.cad.StudioImage.to_source); outline is the board,\nwhich the image is clipped to.",
      "properties": {
        "module": {
          "format": "uuid",
          "title": "Module",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "job": {
          "description": "The photo it came from: a new photo is a new image.",
          "format": "uuid",
          "title": "Job",
          "type": "string"
        },
        "title": {
          "description": "\"M-002 Linje\".",
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "matrix": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Matrix",
          "type": "array"
        },
        "outline": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Outline",
          "type": "array"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TKL:s egen adress till bilden, i TklImageUnder.",
          "title": "Url"
        }
      },
      "required": [
        "module",
        "version",
        "job",
        "title",
        "width",
        "height",
        "matrix",
        "outline",
        "bytes"
      ],
      "title": "TklCadImage",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Mätbilden under i Foto (#89 del d4, CAD8, CAD-33): the modules' measuring images from\nTrainMeet CAD for a station that came from CAD, kept with the station, and the station's\nchoice to draw them under the tracks in Foto. The choice is the station's, the same on every\nscreen, off by default; it sends no order (STV-18). Grey with the reason when the station\nhas no images to show.",
  "properties": {
    "available": {
      "title": "Available",
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Varför Mätbilden under är grå.",
      "title": "Reason"
    },
    "on": {
      "description": "The station's choice; drawn only while available.",
      "title": "On",
      "type": "boolean"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/TklCadImage"
      },
      "title": "Images",
      "type": "array"
    },
    "missing": {
      "description": "Modules drawn as vectors.",
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing",
      "type": "array"
    },
    "gauge": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The gauge in mm of the source's scale: Foto draws its rails at it over the images, which show the real ones.",
      "title": "Gauge"
    },
    "bytes": {
      "description": "What the images take with the station.",
      "minimum": 0,
      "title": "Bytes",
      "type": "integer"
    },
    "limit": {
      "description": "The most a station keeps, in bytes.",
      "minimum": 0,
      "title": "Limit",
      "type": "integer"
    }
  },
  "required": [
    "available",
    "on",
    "bytes",
    "limit"
  ],
  "type": "object"
}
