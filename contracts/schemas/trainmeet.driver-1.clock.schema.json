{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.driver-1.clock.schema.json",
  "title": "trainmeet.driver-1.clock",
  "$defs": {
    "Clock": {
      "additionalProperties": true,
      "properties": {
        "time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "seconds": {
          "description": "Sekunder sedan speldygnets midnatt; kan gå över 24 h.",
          "minimum": 0,
          "title": "Seconds",
          "type": "integer"
        },
        "running": {
          "description": "Falskt betyder stoppad klocka, inte tappad kontakt.",
          "title": "Running",
          "type": "boolean"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        }
      },
      "required": [
        "time",
        "seconds",
        "running",
        "speed",
        "game_day"
      ],
      "title": "Clock",
      "type": "object"
    },
    "Weekday": {
      "description": "The timetable's weekday (trafikdag). Not the same as the game day (Dag 1…N).",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "title": "Weekday",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Träffklockan ur Drift (LOK-12). Telefonen räknar fram från seconds med speed och sin egen\ntid sedan svaret, aldrig från sitt eget klockslag.",
  "properties": {
    "clock": {
      "$ref": "#/$defs/Clock"
    },
    "traffic_day": {
      "$ref": "#/$defs/Weekday"
    },
    "read": {
      "description": "När hubben läste klockan.",
      "format": "date-time",
      "title": "Read",
      "type": "string"
    }
  },
  "required": [
    "clock",
    "traffic_day",
    "read"
  ],
  "type": "object"
}
