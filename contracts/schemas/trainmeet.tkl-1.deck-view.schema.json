{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.deck-view.schema.json",
  "title": "trainmeet.tkl-1.deck-view",
  "$defs": {
    "DeckHold": {
      "description": "How long a hold is, per deck (SD29): Kort, Normal (0.6 s) or Lång.",
      "enum": [
        "kort",
        "normal",
        "lang"
      ],
      "title": "DeckHold",
      "type": "string"
    },
    "DeckMode": {
      "description": "Lägena (SD63): a group of pages with the same way of working. Bangård comes with the\nshunter's deck (#87).",
      "enum": [
        "tagen",
        "platser",
        "sparplan"
      ],
      "title": "DeckMode",
      "type": "string"
    },
    "DeckModelId": {
      "description": "Elgato's models (SD52). Module 6, 15 and 32 and the older editions of the 15 get the\nprofile of the size they have (SD54).",
      "enum": [
        "mini",
        "neo",
        "15",
        "xl",
        "plus",
        "plus-xl",
        "pedal",
        "module-6",
        "module-15",
        "module-32",
        "studio"
      ],
      "title": "DeckModelId",
      "type": "string"
    },
    "DeckPlacesShown": {
      "description": "Platser's variants (SD68).",
      "enum": [
        "alla",
        "valbara"
      ],
      "title": "DeckPlacesShown",
      "type": "string"
    },
    "DeckPlanDrawn": {
      "description": "How Spårplan is drawn (SD72).",
      "enum": [
        "85",
        "rela"
      ],
      "title": "DeckPlanDrawn",
      "type": "string"
    },
    "DeckStyle": {
      "description": "Where Läge and the fixed keys sit (SD27, SD75, SD77, SD78).",
      "enum": [
        "none",
        "next",
        "last",
        "row",
        "column"
      ],
      "title": "DeckStyle",
      "type": "string"
    },
    "TklDeckFace": {
      "additionalProperties": true,
      "description": "What a key shows: the prototype's look, with the locked colours (SD3, SD6).",
      "properties": {
        "type": {
          "default": "empty",
          "enum": [
            "train",
            "line",
            "alarm",
            "track",
            "place",
            "part",
            "signal",
            "daily",
            "favourite",
            "tile",
            "cell",
            "pan",
            "mode",
            "next",
            "page",
            "action",
            "panel",
            "route",
            "here",
            "ask",
            "case",
            "answer",
            "variant",
            "goal",
            "contact",
            "clock",
            "empty"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 60,
          "title": "Text",
          "type": "string"
        },
        "top": {
          "default": "",
          "maxLength": 60,
          "title": "Top",
          "type": "string"
        },
        "under": {
          "default": "",
          "maxLength": 60,
          "title": "Under",
          "type": "string"
        },
        "small": {
          "default": "",
          "description": "Liten text, som signalnumren (SD69).",
          "maxLength": 60,
          "title": "Small",
          "type": "string"
        },
        "bg": {
          "default": "#0d0f11",
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Bg",
          "type": "string"
        },
        "fg": {
          "default": "#0d0f11",
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Fg",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "dashed": {
          "default": false,
          "title": "Dashed",
          "type": "boolean"
        },
        "band": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bandet överst: vägens färg.",
          "title": "Band"
        },
        "line": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Strecket nederst: vald sida.",
          "title": "Line"
        },
        "bar": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platsens stapel: fri, belagd, lagd.",
          "title": "Bar"
        },
        "bar_dashed": {
          "default": false,
          "title": "Bar Dashed",
          "type": "boolean"
        },
        "dot": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Märket för en hindrad väg (SD17).",
          "title": "Dot"
        },
        "star": {
          "default": false,
          "description": "Planerat spår bland målen (SD20).",
          "title": "Star",
          "type": "boolean"
        },
        "chip": {
          "default": "",
          "description": "Tågnumret på platsen (SD19).",
          "maxLength": 60,
          "title": "Chip",
          "type": "string"
        },
        "chip_colour": {
          "default": "",
          "enum": [
            "green",
            "red",
            ""
          ],
          "title": "Chip Colour",
          "type": "string"
        },
        "blink": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Blinkar mellan bg och den här.",
          "title": "Blink"
        },
        "ready": {
          "default": false,
          "description": "Klart att skicka (SD62): det gröna märket på tågknappen.",
          "title": "Ready",
          "type": "boolean"
        },
        "dim": {
          "default": false,
          "title": "Dim",
          "type": "boolean"
        },
        "tile": {
          "anyOf": [
            {
              "$ref": "#/$defs/TklDeckTile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "default": "",
          "description": "För skärmläsare: vad knappen är.",
          "maxLength": 60,
          "title": "Label",
          "type": "string"
        }
      },
      "title": "TklDeckFace",
      "type": "object"
    },
    "TklDeckGrid": {
      "additionalProperties": true,
      "description": "What a deck has (SD53): the keys in columns and rows, and the dials, the touch strip,\nthe info line, the touch points and the pedals. A model TKL does not know is read this\nway too, and gets the default for its grid.",
      "properties": {
        "columns": {
          "maximum": 32,
          "minimum": 0,
          "title": "Columns",
          "type": "integer"
        },
        "rows": {
          "maximum": 8,
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "dials": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Dials",
          "type": "integer"
        },
        "strip": {
          "default": false,
          "description": "Pekremsan, på + och + XL.",
          "title": "Strip",
          "type": "boolean"
        },
        "info": {
          "default": false,
          "description": "Inforaden, på Neo.",
          "title": "Info",
          "type": "boolean"
        },
        "touch": {
          "default": 0,
          "description": "Pekpunkterna, på Neo.",
          "maximum": 4,
          "minimum": 0,
          "title": "Touch",
          "type": "integer"
        },
        "pedals": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Pedals",
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "TklDeckGrid",
      "type": "object"
    },
    "TklDeckSettings": {
      "additionalProperties": true,
      "description": "One deck, known by its serial number (SD35), as this computer keeps it (SD49).",
      "properties": {
        "serial": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Serial",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckModelId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grid": {
          "$ref": "#/$defs/TklDeckGrid"
        },
        "workplace": {
          "default": "1",
          "description": "Deck på samma arbetsplats delar vald start (SD36).",
          "maxLength": 80,
          "minLength": 1,
          "title": "Workplace",
          "type": "string"
        },
        "opens_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Läget decket öppnar i (SD65)."
        },
        "may_change_mode": {
          "default": true,
          "title": "May Change Mode",
          "type": "boolean"
        },
        "hold": {
          "$ref": "#/$defs/DeckHold",
          "default": "normal"
        },
        "places_shown": {
          "$ref": "#/$defs/DeckPlacesShown",
          "default": "alla"
        },
        "plan_drawn": {
          "$ref": "#/$defs/DeckPlanDrawn",
          "default": "85"
        },
        "signal_numbers": {
          "default": false,
          "description": "Signalnumren i Platser (SD69).",
          "title": "Signal Numbers",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ägarens namn på decket.",
          "title": "Name"
        },
        "brightness": {
          "default": 70,
          "description": "Ljusstyrkan, i procent (SD46).",
          "maximum": 100,
          "minimum": 0,
          "title": "Brightness",
          "type": "integer"
        },
        "sleep": {
          "default": 0,
          "description": "Släcks efter så många minuter utan tryck; 0 aldrig.",
          "maximum": 240,
          "minimum": 0,
          "title": "Sleep",
          "type": "integer"
        },
        "lock_key": {
          "default": true,
          "description": "Lås (Fika) på sidan Läge (SD30). Låst TKL visar ändå bara klockan.",
          "title": "Lock Key",
          "type": "boolean"
        },
        "opens_on": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sidan decket öppnar på (SD35); annars lägets första.",
          "title": "Opens On"
        }
      },
      "required": [
        "serial",
        "grid"
      ],
      "title": "TklDeckSettings",
      "type": "object"
    },
    "TklDeckStrip": {
      "additionalProperties": true,
      "description": "What a dial stands on, in the touch strip (SD83).",
      "properties": {
        "label": {
          "maxLength": 60,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "default": "",
          "maxLength": 60,
          "title": "Value",
          "type": "string"
        },
        "under": {
          "default": "",
          "maxLength": 60,
          "title": "Under",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "TklDeckStrip",
      "type": "object"
    },
    "TklDeckTile": {
      "additionalProperties": true,
      "description": "A key that draws a piece of the track plan (SD70, SD71): the rectangle in the panel's\ncells, how it is drawn, and what is lit in it.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        },
        "h": {
          "title": "H",
          "type": "number"
        },
        "drawn": {
          "$ref": "#/$defs/DeckPlanDrawn",
          "default": "85"
        },
        "start": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "goals": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "names": {
          "description": "Spåren i biten (SD70).",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Names",
          "type": "array"
        },
        "chosen": {
          "default": false,
          "title": "Chosen",
          "type": "boolean"
        },
        "state": {
          "default": "",
          "description": "Spårplanens läge i biten, i korthet: ändras när ett spår, en signal eller ett tågnummer i den ändras, så att bilden ritas om (#86 del b).",
          "maxLength": 40,
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "TklDeckTile",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The deck as it is now: every key's face, and the info line and the strip.",
  "properties": {
    "settings": {
      "$ref": "#/$defs/TklDeckSettings"
    },
    "revision": {
      "description": "Räknar upp när något på decket ändras.",
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "style": {
      "$ref": "#/$defs/DeckStyle"
    },
    "modes": {
      "items": {
        "$ref": "#/$defs/DeckMode"
      },
      "title": "Modes",
      "type": "array"
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeckMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "page": {
      "default": "",
      "maxLength": 60,
      "title": "Page",
      "type": "string"
    },
    "keys": {
      "items": {
        "$ref": "#/$defs/TklDeckFace"
      },
      "title": "Keys",
      "type": "array"
    },
    "fixed": {
      "items": {
        "type": "integer"
      },
      "title": "Fixed",
      "type": "array"
    },
    "info": {
      "default": "",
      "description": "Inforaden (SD82): klockan och sidan, eller valet.",
      "maxLength": 60,
      "title": "Info",
      "type": "string"
    },
    "strip": {
      "items": {
        "$ref": "#/$defs/TklDeckStrip"
      },
      "title": "Strip",
      "type": "array"
    },
    "hold_ms": {
      "default": 600,
      "description": "Ett håll (SD29).",
      "maximum": 3000,
      "minimum": 100,
      "title": "Hold Ms",
      "type": "integer"
    },
    "refresh_ms": {
      "default": 15000,
      "description": "Läs om senast efter så här länge.",
      "minimum": 200,
      "title": "Refresh Ms",
      "type": "integer"
    },
    "locked": {
      "default": false,
      "description": "TKL är låst: bara klockan (SD30).",
      "title": "Locked",
      "type": "boolean"
    },
    "contact": {
      "default": true,
      "description": "Ställverket svarar; annars Ingen kontakt.",
      "title": "Contact",
      "type": "boolean"
    },
    "message": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Ställverkets senaste svar.",
      "title": "Message"
    },
    "accepted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted"
    },
    "said": {
      "default": "",
      "description": "Ställverkets nej i tre sekunder, för pekremsan på + och + XL (SD18).",
      "maxLength": 60,
      "title": "Said",
      "type": "string"
    }
  },
  "required": [
    "settings",
    "revision",
    "style"
  ],
  "type": "object"
}
