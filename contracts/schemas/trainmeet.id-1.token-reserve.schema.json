{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.token-reserve.schema.json",
  "title": "trainmeet.id-1.token-reserve",
  "$defs": {
    "TokenOwner": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "$ref": "#/$defs/TokenOwnerKind"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "TokenOwner",
      "type": "object"
    },
    "TokenOwnerKind": {
      "description": "Vems saldo (TK1): personens, för egna fordon och moduler, eller klubbens, för\nträffarnas import (TK16).",
      "enum": [
        "person",
        "club"
      ],
      "title": "TokenOwnerKind",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "En app reserverar före ett arbete som kostar (TOKEN-24). Personen som arbetar ska få\nanvända saldot: sitt eget, eller klubbens som medlem i klubben.",
  "properties": {
    "person": {
      "format": "uuid",
      "title": "Person",
      "type": "string"
    },
    "owner": {
      "$ref": "#/$defs/TokenOwner"
    },
    "amount": {
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "title": "Amount",
      "type": "integer"
    },
    "key": {
      "description": "Appens egen nyckel för arbetet. Samma nyckel igen ger samma reservation.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Key",
      "type": "string"
    },
    "what": {
      "description": "Vad det gäller, som det visas: t.ex. 12 sidor i importen.",
      "maxLength": 500,
      "minLength": 1,
      "title": "What",
      "type": "string"
    }
  },
  "required": [
    "person",
    "owner",
    "amount",
    "key",
    "what"
  ],
  "type": "object"
}
