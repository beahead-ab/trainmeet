{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.sync-1.relay-answer.schema.json",
  "title": "trainmeet.sync-1.relay-answer",
  "$defs": {
    "Action": {
      "enum": [
        "train.lookup",
        "train.track.change",
        "train.departed",
        "train.arrived",
        "train.position.set",
        "train.crew_ready.set",
        "train.set_aside",
        "clearance.request",
        "clearance.response",
        "clearance.cancel",
        "line.available.publish",
        "line.available.acknowledge",
        "section.occupancy",
        "signal.exit",
        "place.leave",
        "place.take_back"
      ],
      "title": "Action",
      "type": "string"
    },
    "ApprovalStatus": {
      "enum": [
        "waiting",
        "approved",
        "refused",
        "revoked"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "ArrivalState": {
      "enum": [
        "none",
        "on_the_way",
        "arrived"
      ],
      "title": "ArrivalState",
      "type": "string"
    },
    "CallHere": {
      "additionalProperties": true,
      "description": "A call at this place, with what the client may do with it right now.",
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "train_label": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Till exempel IC 116 (F9).",
          "title": "Train Label"
        },
        "train_type": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Type"
        },
        "manual": {
          "default": false,
          "title": "Manual",
          "type": "boolean"
        },
        "arrival": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "day_offset": {
          "default": 0,
          "title": "Day Offset",
          "type": "integer"
        },
        "planned_track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Track"
        },
        "track": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Var tåget står eller ska stå nu.",
          "title": "Track"
        },
        "from_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Place"
        },
        "to_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Place"
        },
        "arrival_state": {
          "$ref": "#/$defs/ArrivalState",
          "default": "none"
        },
        "departure_state": {
          "$ref": "#/$defs/DepartureState",
          "default": "planned"
        },
        "positioned": {
          "default": false,
          "title": "Positioned",
          "type": "boolean"
        },
        "crew_ready": {
          "default": false,
          "title": "Crew Ready",
          "type": "boolean"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "allowed_actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "paper": {
          "default": false,
          "description": "Efter pappret: tåget finns inte i planen, och trafikledningen har godkänt det (LOK-13).",
          "title": "Paper",
          "type": "boolean"
        }
      },
      "required": [
        "call",
        "train",
        "train_number",
        "revision"
      ],
      "title": "CallHere",
      "type": "object"
    },
    "Clearance": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        },
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "from_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "From Place",
          "type": "string"
        },
        "to_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To Place",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClearanceStatus"
        },
        "departed": {
          "default": false,
          "title": "Departed",
          "type": "boolean"
        },
        "requested_at": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Requested At",
          "type": "string"
        },
        "reminders": {
          "default": 0,
          "description": "Påminnelser hittills (H39).",
          "minimum": 0,
          "title": "Reminders",
          "type": "integer"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "paper": {
          "default": false,
          "description": "Efter pappret: tåget finns inte i planen, och trafikledningen har godkänt det (LOK-13).",
          "title": "Paper",
          "type": "boolean"
        }
      },
      "required": [
        "clearance_id",
        "call",
        "train_number",
        "section",
        "from_place",
        "to_place",
        "status",
        "requested_at",
        "revision"
      ],
      "title": "Clearance",
      "type": "object"
    },
    "ClearanceMode": {
      "description": "Klareringsläge. Requested: the receiving place answers. Direct: Drift answers at once\nif the section is free. The meet has one; a section may have the other (decided 1 Nov).",
      "enum": [
        "requested",
        "direct"
      ],
      "title": "ClearanceMode",
      "type": "string"
    },
    "ClearanceStatus": {
      "enum": [
        "waiting",
        "approved",
        "rejected",
        "cancelled",
        "invalidated"
      ],
      "title": "ClearanceStatus",
      "type": "string"
    },
    "Clock": {
      "additionalProperties": true,
      "properties": {
        "time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "seconds": {
          "description": "Sekunder sedan speldygnets midnatt; kan gå över 24 h.",
          "minimum": 0,
          "title": "Seconds",
          "type": "integer"
        },
        "running": {
          "description": "Falskt betyder stoppad klocka, inte tappad kontakt.",
          "title": "Running",
          "type": "boolean"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        }
      },
      "required": [
        "time",
        "seconds",
        "running",
        "speed",
        "game_day"
      ],
      "title": "Clock",
      "type": "object"
    },
    "ConnectReply": {
      "additionalProperties": true,
      "properties": {
        "protocol": {
          "const": "trainmeet.station/1",
          "default": "trainmeet.station/1",
          "title": "Protocol",
          "type": "string"
        },
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Client Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "places": {
          "description": "Godkända driftplatser.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Places",
          "type": "array"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nyckeln, bara en gång: i första svaret efter godkännandet. Skrivs aldrig ut.",
          "title": "Key"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "relay": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Adressen utanför träffens nät: molnhubbens relä till den här hubben, där samma anrop görs med samma nyckel (SYNK-11). Tomt när hubben inte är kopplad till molnet.",
          "title": "Relay"
        }
      },
      "required": [
        "client_id",
        "status"
      ],
      "title": "ConnectReply",
      "type": "object"
    },
    "DepartureState": {
      "enum": [
        "planned",
        "requested",
        "cleared",
        "departed"
      ],
      "title": "DepartureState",
      "type": "string"
    },
    "DriverMessageHere": {
      "additionalProperties": true,
      "description": "Ett meddelande från föraren på ett tåg som är här, på väg hit eller har lämnat (KLAR-27,\nDRIFT-38). Bara till TKL, inte till TMBox. Utan förarens namn.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/DriverMessageKind"
        },
        "train": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train"
        },
        "train_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Number"
        },
        "model_time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Model Time",
          "type": "string"
        },
        "seq": {
          "description": "Drifthändelsen meddelandet är.",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "model_time",
        "seq"
      ],
      "title": "DriverMessageHere",
      "type": "object"
    },
    "DriverMessageKind": {
      "description": "Förarens färdiga meddelanden till trafikledningen (LOK-23, DRIFT-38).",
      "enum": [
        "delayed",
        "stopped_on_line",
        "needs_help",
        "engine_trouble"
      ],
      "title": "DriverMessageKind",
      "type": "string"
    },
    "ExitChoice": {
      "additionalProperties": true,
      "properties": {
        "exit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Exit",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "exit",
        "side"
      ],
      "title": "ExitChoice",
      "type": "object"
    },
    "ExitQuestion": {
      "additionalProperties": true,
      "description": "Hubben är osäker på vilken av stationens utfarter en sträcka har (H26, PLAN-31). Den\ngissar på grannens namn, sidan och förra träffens svar, och frågar annars. Stationen i TKL\neller trafikledningen i Klienter svarar, och det första svaret gäller (TRAFIK-05).",
      "properties": {
        "station_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Station Id",
          "type": "string"
        },
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "other_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Other Place",
          "type": "string"
        },
        "other_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Other Name",
          "type": "string"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sträckans sida vid driftplatsen."
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/ExitChoice"
          },
          "minItems": 1,
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "station_id",
        "place",
        "section",
        "other_place",
        "other_name",
        "alternatives"
      ],
      "title": "ExitQuestion",
      "type": "object"
    },
    "LineMessage": {
      "additionalProperties": true,
      "properties": {
        "message_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Message Id",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "from_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "From Place",
          "type": "string"
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        },
        "acknowledged": {
          "default": false,
          "title": "Acknowledged",
          "type": "boolean"
        }
      },
      "required": [
        "message_id",
        "section",
        "from_place"
      ],
      "title": "LineMessage",
      "type": "object"
    },
    "LookupMatch": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "train_label": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Label"
        },
        "from_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Place"
        },
        "to_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Place"
        },
        "time": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        }
      },
      "required": [
        "call",
        "train_number"
      ],
      "title": "LookupMatch",
      "type": "object"
    },
    "MeetContext": {
      "additionalProperties": true,
      "description": "Which meet, version and game day the client saw. A command for another is refused\nwith stale_meet_context, so an old choice never survives a change of meet or day.",
      "properties": {
        "meet_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Meet Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        },
        "epoch": {
          "description": "Ledarskapets epok; byts vid övertag.",
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        }
      },
      "required": [
        "meet_id",
        "version",
        "game_day",
        "epoch"
      ],
      "title": "MeetContext",
      "type": "object"
    },
    "Neighbour": {
      "additionalProperties": true,
      "description": "A place and its game number, for the telephone list in TKL and the app (H24).",
      "properties": {
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        }
      },
      "required": [
        "place",
        "code",
        "name"
      ],
      "title": "Neighbour",
      "type": "object"
    },
    "Reason": {
      "enum": [
        "unsupported_protocol",
        "unknown_action",
        "not_approved",
        "wrong_place",
        "stale_meet_context",
        "stale_revision",
        "no_active_meet",
        "train_number_required",
        "unknown_train_number",
        "ambiguous_train_number",
        "unknown_call",
        "unknown_track",
        "track_occupied",
        "unknown_section",
        "channel_occupied",
        "call_already_requested",
        "clearance_not_pending",
        "unknown_clearance",
        "not_sender",
        "not_receiver",
        "train_already_departed",
        "departure_not_reserved",
        "invalid_departure",
        "invalid_arrival",
        "train_not_departed",
        "unknown_line_message",
        "already_acknowledged",
        "not_level_3",
        "station_automatic",
        "automatic_station_manned",
        "automation_off",
        "client_not_present",
        "no_jump_to_undo",
        "other_game_day",
        "day_still_running",
        "unknown_place",
        "unknown_train",
        "no_route",
        "invalid_time",
        "train_number_taken",
        "unknown_change",
        "section_closed",
        "unknown_version",
        "same_version",
        "no_switch_waiting",
        "drift_locked",
        "not_locked",
        "not_leader",
        "already_leader",
        "unknown_service",
        "service_taken",
        "one_service",
        "no_service",
        "unknown_driver",
        "not_in_service",
        "unknown_paper",
        "paper_decided",
        "paper_no_places",
        "paper_few_places",
        "paper_no_times",
        "paper_no_number"
      ],
      "title": "Reason",
      "type": "string"
    },
    "Reply": {
      "additionalProperties": true,
      "properties": {
        "protocol": {
          "const": "trainmeet.station/1",
          "default": "trainmeet.station/1",
          "title": "Protocol",
          "type": "string"
        },
        "message_id": {
          "pattern": "^[A-Za-z0-9._:-]{8,120}$",
          "title": "Message Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReplyStatus"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
