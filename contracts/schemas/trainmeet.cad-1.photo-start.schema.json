{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.photo-start.schema.json",
  "title": "trainmeet.cad-1.photo-start",
  "$defs": {
    "EdgeSide": {
      "description": "Which edge of a curve module is Kant 1.",
      "enum": [
        "outer",
        "inner"
      ],
      "title": "EdgeSide",
      "type": "string"
    },
    "Scale": {
      "description": "The module's scale (CAD10, CAD12).",
      "enum": [
        "H0",
        "N",
        "0"
      ],
      "title": "Scale",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "The form's data part: a new module from the photo, or a photo for a module. A curve\nmodule comes with the chord and sagitta measured on track 1, and track 1's distance from\nKant 1 at gable A (part c2, bildkedjan step 6). A sketch (profile skiss) needs the module's\nlength: its frame gives the sketch its scale.",
  "properties": {
    "module": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Module"
    },
    "profile": {
      "default": "modulfoto",
      "enum": [
        "modulfoto",
        "skiss"
      ],
      "title": "Profile",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "scale": {
      "$ref": "#/$defs/Scale",
      "default": "H0"
    },
    "kind": {
      "default": "straight",
      "enum": [
        "straight",
        "trapezoid",
        "curve"
      ],
      "title": "Kind",
      "type": "string"
    },
    "width": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Gable A's width; null: the module's.",
      "title": "Width"
    },
    "width_b": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Width B"
    },
    "length": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null: the photo gives it.",
      "title": "Length"
    },
    "offset": {
      "anyOf": [
        {
          "maximum": 20000,
          "minimum": -20000,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Offset"
    },
    "chord": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A curve's chord on track 1.",
      "title": "Chord"
    },
    "sagitta": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A curve's sagitta on track 1.",
      "title": "Sagitta"
    },
    "track1": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Track 1 from Kant 1 at gable A.",
      "title": "Track1"
    },
    "edge": {
      "$ref": "#/$defs/EdgeSide",
      "default": "outer"
    },
    "keep_original": {
      "default": false,
      "title": "Keep Original",
      "type": "boolean"
    },
    "owner": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    }
  },
  "type": "object"
}
