{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.drawing-job.schema.json",
  "title": "trainmeet.cad-1.drawing-job",
  "$defs": {
    "ArcSegment": {
      "additionalProperties": true,
      "description": "ARC: a circular piece of track centre, in mm, as DXF's ARC. clockwise is as the drawing\nshows it, with y down.",
      "properties": {
        "kind": {
          "const": "arc",
          "default": "arc",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "center": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Radius",
          "type": "number"
        },
        "clockwise": {
          "title": "Clockwise",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "center",
        "radius",
        "clockwise"
      ],
      "title": "ArcSegment",
      "type": "object"
    },
    "Certainty": {
      "description": "How sure a fact is, as in the import and the photo chain (bildkedjan, principle 4).",
      "enum": [
        "certain",
        "probable",
        "uncertain",
        "confirmed"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "DrawingAi": {
      "additionalProperties": true,
      "description": "Whether AI can transcribe a raster page here, what is sent and to whom, and the yes\n(as the photo's, CAT-142).",
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "given": {
          "title": "Given",
          "type": "boolean"
        },
        "version": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "sent_to": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Sent To",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "balance": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balance"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why AI cannot be used now.",
          "title": "Message"
        }
      },
      "required": [
        "available",
        "given",
        "version",
        "sent_to",
        "text"
      ],
      "title": "DrawingAi",
      "type": "object"
    },
    "DrawingBoundary": {
      "additionalProperties": true,
      "description": "Spårledningsgräns where the drawing shows one: a stroke across a track.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "at": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "piece": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The track it crosses.",
          "title": "Piece"
        },
        "origin": {
          "$ref": "#/$defs/GraphOrigin"
        }
      },
      "required": [
        "id",
        "at",
        "origin"
      ],
      "title": "DrawingBoundary",
      "type": "object"
    },
    "DrawingChoice": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "DrawingChoice",
      "type": "object"
    },
    "DrawingJobState": {
      "enum": [
        "waiting",
        "queued",
        "running",
        "done",
        "failed"
      ],
      "title": "DrawingJobState",
      "type": "string"
    },
    "DrawingPage": {
      "additionalProperties": true,
      "properties": {
        "number": {
          "maximum": 20,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/DrawingPageKind"
        },
        "width": {
          "description": "In the page's own units: pt, or px for pixels.",
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "text": {
          "description": "The page has a text layer that code reads.",
          "title": "Text",
          "type": "boolean"
        },
        "tokens": {
          "description": "What reading it with TrainMeets AI costs.",
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "kind",
        "width",
        "height",
        "text",
        "tokens"
      ],
      "title": "DrawingPage",
      "type": "object"
    },
    "DrawingPageKind": {
      "enum": [
        "vector",
        "raster"
      ],
      "title": "DrawingPageKind",
      "type": "string"
    },
    "DrawingPrice": {
      "additionalProperties": true,
      "description": "The price before start (CAD-29, bildkedjan Pris): a vector page is free, a raster page\n12 tokens when TrainMeets AI transcribes its text.",
      "properties": {
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "why": {
          "enum": [
            "vector",
            "first",
            "same",
            "own_ai",
            "no_ai"
          ],
          "title": "Why",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "tokens",
        "why",
        "text"
      ],
      "title": "DrawingPrice",
      "type": "object"
    },
    "DrawingQuestion": {
      "additionalProperties": true,
      "description": "A question from the drawing's read: one per colour of line or symbol type that code\ncannot place (R3: \"Vad betyder ▲ i den här ritningen?\"), the legend's first. The code's\nchoice stands until the owner answers; the answer changes the read without reading again,\nat no cost.",
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DrawingQuestionKind"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/DrawingChoice"
          },
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The choice the code makes.",
          "title": "Code"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The owner's.",
          "title": "Answer"
        },
        "sample": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "▲, ●, a colour …",
          "title": "Sample"
        },
        "count": {
          "description": "How many there are in the drawing.",
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "at": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One of them, in the drawing.",
          "title": "At"
        }
      },
      "required": [
        "key",
        "kind",
        "title",
        "text",
        "choices",
        "count"
      ],
      "title": "DrawingQuestion",
      "type": "object"
    },
    "DrawingQuestionKind": {
      "enum": [
        "legend",
        "end"
      ],
      "title": "DrawingQuestionKind",
      "type": "string"
    },
    "DrawingRead": {
      "additionalProperties": true,
      "description": "Ritningsavläsning (bildkedjan R4): what the chain read from one page, for Studio. The\ntrack graph is \"schema\": pieces, nodes and switches in the drawing's coordinates, the labels\nwith the object each names and how it was read, and the symbols with their class. Then the\ntrack-circuit boundaries, the questions with the legend's first, the straightened drawing,\nand the job and its price. Everything is a proposal until the owner confirms it in Studio.",
      "properties": {
        "job": {
          "format": "uuid",
          "title": "Job",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/DrawingPageKind"
        },
        "graph": {
          "$ref": "#/$defs/TrackGraph"
        },
        "boundaries": {
          "items": {
            "$ref": "#/$defs/DrawingBoundary"
          },
          "title": "Boundaries",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/DrawingQuestion"
          },
          "title": "Questions",
          "type": "array"
        },
        "underlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/DrawingUnderlay"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "$ref": "#/$defs/DrawingSummary"
        },
        "price": {
          "$ref": "#/$defs/DrawingPrice"
        },
        "cost": {
          "description": "Tokens drawn for this read.",
          "minimum": 0,
          "title": "Cost",
          "type": "integer"
        },
        "notes": {
          "description": "What else to know, in Swedish.",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "job",
        "page",
        "kind",
        "graph",
        "summary",
        "price",
        "cost"
      ],
      "title": "DrawingRead",
      "type": "object"
    },
    "DrawingSummary": {
      "additionalProperties": true,
      "properties": {
        "pieces": {
          "minimum": 0,
          "title": "Pieces",
          "type": "integer"
        },
        "switches": {
          "minimum": 0,
          "title": "Switches",
          "type": "integer"
        },
        "crossings": {
          "minimum": 0,
          "title": "Crossings",
          "type": "integer"
        },
        "line_exits": {
          "minimum": 0,
          "title": "Line Exits",
          "type": "integer"
        },
        "buffer_stops": {
          "minimum": 0,
          "title": "Buffer Stops",
          "type": "integer"
        },
        "signals": {
          "minimum": 0,
          "title": "Signals",
          "type": "integer"
        },
        "boundaries": {
          "minimum": 0,
          "title": "Boundaries",
          "type": "integer"
        },
        "labels": {
          "minimum": 0,
          "title": "Labels",
          "type": "integer"
        },
        "unknown_symbols": {
          "minimum": 0,
          "title": "Unknown Symbols",
          "type": "integer"
        }
      },
      "required": [
        "pieces",
        "switches",
        "crossings",
        "line_exits",
        "buffer_stops",
        "signals",
        "boundaries",
        "labels",
        "unknown_symbols"
      ],
      "title": "DrawingSummary",
      "type": "object"
    },
    "DrawingUnderlay": {
      "additionalProperties": true,
      "description": "The straightened drawing, for Studio to show under Rita: the image, its size, and the\naffine transform from the drawing's coordinates to the image's pixels (a, b, c, d, e, f as\nSVG's matrix).",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "transform": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Transform",
          "type": "array"
        }
      },
      "required": [
        "url",
        "width",
        "height",
        "transform"
      ],
      "title": "DrawingUnderlay",
      "type": "object"
    },
    "GableEnd": {
      "enum": [
        "A",
        "B"
      ],
      "title": "GableEnd",
      "type": "string"
    },
    "GraphLabel": {
      "additionalProperties": true,
      "description": "Etikett: a text in the drawing at a point in mm, on a piece or a switch or free\n(bildkedjan, R4 and point 21). The Text tool writes them. In a drawing read for Studio the\npoint is in the drawing's own coordinates, ref is the object code tied it to (the nearest\none), and read_by says how the text was read.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "at": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The piece, switch, node or symbol it names.",
          "title": "Ref"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "read_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadBy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Textlager, OCR eller AI; null: written in CAD."
        }
      },
      "required": [
        "id",
        "text",
        "at"
      ],
      "title": "GraphLabel",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": true,
      "description": "Nod: where pieces meet or end. A track at a gable is a module joint with its gable and\nits track number there.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        },
        "at": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "gable": {
          "anyOf": [
            {
              "$ref": "#/$defs/GableEnd"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "track": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spår n i gaveln.",
          "title": "Track"
        }
      },
      "required": [
        "id",
        "type",
        "at"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphOrigin": {
      "additionalProperties": true,
      "properties": {
        "source": {
          "$ref": "#/$defs/GraphSource"
        },
        "certainty": {
          "$ref": "#/$defs/Certainty"
        },
        "ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The part's own id in the source, kept as its origin: AnyRail's part ids (ANYRAIL-07), joined by + when one piece holds several.",
          "title": "Ref"
        }
      },
      "required": [
        "source",
        "certainty"
      ],
      "title": "GraphOrigin",
      "type": "object"
    },
    "GraphPiece": {
      "additionalProperties": true,
      "description": "Spårbit: track centre from one node to another, as LINE and ARC segments in order.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "start": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "End",
          "type": "string"
        },
        "segments": {
          "items": {
            "discriminator": {
              "mapping": {
                "arc": "#/$defs/ArcSegment",
                "line": "#/$defs/LineSegment"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LineSegment"
              },
              {
                "$ref": "#/$defs/ArcSegment"
              }
            ]
          },
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spårnummer, när ägaren har gett det.",
          "title": "Track"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "segments"
      ],
      "title": "GraphPiece",
      "type": "object"
    },
    "GraphSource": {
      "description": "Where a piece of the graph comes from.",
      "enum": [
        "measures",
        "photo",
        "sketch",
        "anyrail",
        "drawn",
        "drawing"
      ],
      "title": "GraphSource",
      "type": "string"
    },
    "GraphSwitch": {
      "additionalProperties": true,
      "description": "Växel, korsningsväxel eller korsning, at a node: the station model's Switch with CAD's\nids. The diverging leg's radius and angle, when known. The node is the points (tungspetsen);\nthe diverging leg leaves the through track tangentially toward gable A or B (lärdomarna,\nVäxlar). design is the switch type from the switch library (Växeltyp), null while Okänd.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "node": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Node",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SwitchType"
        },
        "trunk": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trunk"
        },
        "straight": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Straight"
        },
        "diverging": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diverging"
        },
        "radius": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 20000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius"
        },
        "angle": {
          "anyOf": [
            {
              "exclusiveMaximum": 90,
