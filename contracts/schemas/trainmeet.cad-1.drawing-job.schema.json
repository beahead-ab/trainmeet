        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "issued": {
          "default": 0,
          "description": "Ids issued so far; the next is one more.",
          "minimum": 0,
          "title": "Issued",
          "type": "integer"
        }
      },
      "title": "TrackGraph",
      "type": "object"
    }
