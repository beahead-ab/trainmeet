{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.club.schema.json",
  "title": "trainmeet.id-1.club",
  "$defs": {
    "ClubRole": {
      "description": "A person's role in a club (KONTO-35).",
      "enum": [
        "admin",
        "member"
      ],
      "title": "ClubRole",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/ClubRole",
      "description": "The person's role in the club."
    }
  },
  "required": [
    "id",
    "name",
    "role"
  ],
  "type": "object"
}
