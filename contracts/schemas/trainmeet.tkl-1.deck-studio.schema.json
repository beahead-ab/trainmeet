{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.deck-studio.schema.json",
  "title": "trainmeet.tkl-1.deck-studio",
  "$defs": {
    "DeckAction": {
      "enum": [
        "los",
        "ankommit",
        "kor",
        "avbryt",
        "tillbaka",
        "las",
        "lagg",
        "los-vagen",
        "los-alla",
        "noll",
        "nodutlosning",
        "ingenting",
        "lamna",
        "klart",
        "ring",
        "grindar",
        "tuta",
        "fika",
        "klocka",
        "begaran"
      ],
      "title": "DeckAction",
      "type": "string"
    },
    "DeckButtonGroup": {
      "description": "Knappar in Studio (SD41): the station's keys by group.",
      "enum": [
        "trafiken",
        "tagvagar",
        "vaxlingsvagar",
        "platser",
        "signaler",
        "funktioner",
        "bangard-spar",
        "bangard-vagar-ut"
      ],
      "title": "DeckButtonGroup",
      "type": "string"
    },
    "DeckChange": {
      "description": "What a deviation from the default does (SD40, SD43).",
      "enum": [
        "flytta",
        "lagg-till",
        "ta-bort",
        "andra",
        "ny-sida",
        "ta-bort-sida",
        "ordning",
        "pedal"
      ],
      "title": "DeckChange",
      "type": "string"
    },
    "DeckDial": {
      "description": "What a dial does in a mode (SD83): turn chooses, press does it.",
      "enum": [
        "tag",
        "spar",
        "sida",
        "lagd-vag",
        "start",
        "mal",
        "del",
        "sidled",
        "hojdled",
        "signal",
        "begar",
        "gata",
        "klart-tag"
      ],
      "title": "DeckDial",
      "type": "string"
    },
    "DeckKeyType": {
      "description": "The fixed catalogue of keys (SD4): a new type is added for all, never for a station.",
      "enum": [
        "train",
        "line",
        "alarm",
        "track",
        "place",
        "part",
        "signal",
        "daily",
        "favourite",
        "tile",
        "cell",
        "pan",
        "mode",
        "next",
        "page",
        "action",
        "panel",
        "route",
        "ande",
        "gata",
        "begar",
        "klart-tag",
        "fjarrvag",
        "erbjudande"
      ],
      "title": "DeckKeyType",
      "type": "string"
    },
    "DeckMode": {
      "description": "Lägena (SD63): a group of pages with the same way of working. Bangård is the shunter's\ndeck, for a deck with a part's role (#87 del d, SD74). Fjärr is the fjärrtågklarerare's,\na page per station it controls (#36 del d, SD37).",
      "enum": [
        "tagen",
        "platser",
        "sparplan",
        "bangard",
        "fjarr"
      ],
      "title": "DeckMode",
      "type": "string"
    },
    "DeckModelId": {
      "description": "Elgato's models (SD52). Module 6, 15 and 32 and the older editions of the 15 get the\nprofile of the size they have (SD54).",
      "enum": [
        "mini",
        "neo",
        "15",
        "xl",
        "plus",
        "plus-xl",
        "pedal",
        "module-6",
        "module-15",
        "module-32",
        "studio"
      ],
      "title": "DeckModelId",
      "type": "string"
    },
    "DeckPageKind": {
      "enum": [
        "nu",
        "dagens",
        "favoriter",
        "platser",
        "delar",
        "del",
        "signaler",
        "alla",
        "hela",
        "utsnitt",
        "egen",
        "bangard",
        "fjarr"
      ],
      "title": "DeckPageKind",
      "type": "string"
    },
    "DeckPageRef": {
      "additionalProperties": true,
      "description": "A page by its kind and its name, never by its place among the pages (SD40): a page the\ndefault makes again after the drawing changed is found by the same kind and name.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/DeckPageKind"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "DeckPageRef",
      "type": "object"
    },
    "DeckPan": {
      "enum": [
        "hela",
        "vaster",
        "oster",
        "upp",
        "ner"
      ],
      "title": "DeckPan",
      "type": "string"
    },
    "DeckPlanDrawn": {
      "description": "How Spårplan is drawn (SD72).",
      "enum": [
        "85",
        "rela"
      ],
      "title": "DeckPlanDrawn",
      "type": "string"
    },
    "DeckProblemKind": {
      "enum": [
        "nas-inte",
        "finns-inte"
      ],
      "title": "DeckProblemKind",
      "type": "string"
    },
    "DeckStyle": {
      "description": "Where Läge and the fixed keys sit (SD27, SD75, SD77, SD78).",
      "enum": [
        "none",
        "next",
        "last",
        "row",
        "column"
      ],
      "title": "DeckStyle",
      "type": "string"
    },
    "PartSide": {
      "description": "Ände: the end of the part a switch street or a route out belongs to (TKL109, TKL122).",
      "enum": [
        "left",
        "right"
      ],
      "title": "PartSide",
      "type": "string"
    },
    "RouteKind": {
      "enum": [
        "train",
        "shunting"
      ],
      "title": "RouteKind",
      "type": "string"
    },
    "TklDeckButton": {
      "additionalProperties": true,
      "description": "A row in Knappar: a key the owner can drag onto the deck, and where it is now.",
      "properties": {
        "group": {
          "$ref": "#/$defs/DeckButtonGroup"
        },
        "key": {
          "$ref": "#/$defs/TklDeckKey"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "where": {
          "default": "",
          "description": "Var den ligger på decket, eller hur den nås.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Where",
          "type": "string"
        },
        "missing": {
          "default": false,
          "description": "Vägen nås inte från decket (SD44).",
          "title": "Missing",
          "type": "boolean"
        },
        "pieces": {
          "description": "Vägens spårbitar, för bilden.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        }
      },
      "required": [
        "group",
        "key",
        "text"
      ],
      "title": "TklDeckButton",
      "type": "object"
    },
    "TklDeckChecks": {
      "additionalProperties": true,
      "description": "Studio's checks of a profile (SD44): every train route and shunting route is reached\nfrom some page, and no key points at something that does not exist.",
      "properties": {
        "routes": {
          "description": "Stationens vägar.",
          "minimum": 0,
          "title": "Routes",
          "type": "integer"
        },
        "reached": {
          "description": "Vägarna som nås från decket.",
          "minimum": 0,
          "title": "Reached",
          "type": "integer"
        },
        "quick": {
          "default": 0,
          "description": "Vägarna som har en snabbväg.",
          "minimum": 0,
          "title": "Quick",
          "type": "integer"
        },
        "problems": {
          "items": {
            "$ref": "#/$defs/TklDeckProblem"
          },
          "title": "Problems",
          "type": "array"
        }
      },
      "required": [
        "routes",
        "reached"
      ],
      "title": "TklDeckChecks",
      "type": "object"
    },
    "TklDeckDeviation": {
      "additionalProperties": true,
      "description": "One of the owner's changes from the default, in stable ids (SD40): a key by what it is\n(its type and what it points at: a route start → goal, a place, a signal, a slot, an\naction), a page by its kind and name. The cell is only where the key goes. Never a colour,\na symbol or a gesture's meaning (SD3, SD43): a deviation that tries is refused.",
      "properties": {
        "change": {
          "$ref": "#/$defs/DeckChange"
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckPageRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sidan ändringen gäller."
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/TklDeckKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Knappen, igenkänd på vad den är; hela knappen för Lägg till."
        },
        "cell": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dit knappen flyttas.",
          "title": "Cell"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "under": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Under"
        },
        "press": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hold": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "number": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "dim": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dim"
        },
        "confirm": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirm"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Läget för en ny sida."
        },
        "order": {
          "description": "Lägets sidor i ägarens ordning.",
          "items": {
            "$ref": "#/$defs/DeckPageRef"
          },
          "maxItems": 200,
          "title": "Order",
          "type": "array"
        },
        "pedal": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pedalen, från vänster.",
          "title": "Pedal"
        }
      },
      "required": [
        "change"
      ],
      "title": "TklDeckDeviation",
      "type": "object"
    },
    "TklDeckFace": {
      "additionalProperties": true,
      "description": "What a key shows: the prototype's look, with the locked colours (SD3, SD6).",
      "properties": {
        "type": {
          "default": "empty",
          "enum": [
            "train",
            "line",
            "alarm",
            "track",
            "place",
            "part",
            "signal",
            "daily",
            "favourite",
            "tile",
            "cell",
            "pan",
            "mode",
            "next",
            "page",
            "action",
            "panel",
            "route",
            "here",
            "ask",
            "case",
            "answer",
            "variant",
            "goal",
            "contact",
            "clock",
            "end",
            "street",
            "request",
            "fika",
            "remote",
            "offer",
            "empty"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 60,
          "title": "Text",
          "type": "string"
        },
        "top": {
          "default": "",
          "maxLength": 60,
          "title": "Top",
          "type": "string"
        },
        "under": {
          "default": "",
          "maxLength": 60,
          "title": "Under",
          "type": "string"
        },
        "small": {
          "default": "",
          "description": "Liten text, som signalnumren (SD69).",
          "maxLength": 60,
          "title": "Small",
          "type": "string"
        },
        "bg": {
          "default": "#0d0f11",
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Bg",
          "type": "string"
        },
        "fg": {
          "default": "#0d0f11",
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Fg",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "dashed": {
          "default": false,
          "title": "Dashed",
          "type": "boolean"
        },
        "band": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bandet överst: vägens färg.",
          "title": "Band"
        },
        "line": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Strecket nederst: vald sida.",
          "title": "Line"
        },
        "bar": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platsens stapel: fri, belagd, lagd.",
          "title": "Bar"
        },
        "bar_dashed": {
          "default": false,
          "title": "Bar Dashed",
          "type": "boolean"
        },
        "dot": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Märket för en hindrad väg (SD17).",
          "title": "Dot"
        },
        "star": {
          "default": false,
          "description": "Planerat spår bland målen (SD20).",
          "title": "Star",
          "type": "boolean"
        },
        "chip": {
          "default": "",
          "description": "Tågnumret på platsen (SD19).",
          "maxLength": 60,
          "title": "Chip",
          "type": "string"
        },
        "chip_colour": {
          "default": "",
          "enum": [
            "green",
            "red",
            ""
          ],
          "title": "Chip Colour",
          "type": "string"
        },
        "blink": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Blinkar mellan bg och den här.",
          "title": "Blink"
        },
        "ready": {
          "default": false,
          "description": "Klart att skicka (SD62): det gröna märket på tågknappen.",
          "title": "Ready",
          "type": "boolean"
        },
        "dim": {
          "default": false,
          "title": "Dim",
          "type": "boolean"
        },
        "tile": {
          "anyOf": [
            {
              "$ref": "#/$defs/TklDeckTile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "default": "",
          "description": "För skärmläsare: vad knappen är.",
          "maxLength": 60,
          "title": "Label",
          "type": "string"
        }
      },
      "title": "TklDeckFace",
      "type": "object"
    },
    "TklDeckGrid": {
      "additionalProperties": true,
      "description": "What a deck has (SD53): the keys in columns and rows, and the dials, the touch strip,\nthe info line, the touch points and the pedals. A model TKL does not know is read this\nway too, and gets the default for its grid.",
      "properties": {
        "columns": {
          "maximum": 32,
          "minimum": 0,
          "title": "Columns",
          "type": "integer"
        },
        "rows": {
          "maximum": 8,
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "dials": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Dials",
          "type": "integer"
        },
        "strip": {
          "default": false,
          "description": "Pekremsan, på + och + XL.",
          "title": "Strip",
          "type": "boolean"
        },
        "info": {
          "default": false,
          "description": "Inforaden, på Neo.",
          "title": "Info",
          "type": "boolean"
        },
        "touch": {
          "default": 0,
          "description": "Pekpunkterna, på Neo.",
          "maximum": 4,
          "minimum": 0,
          "title": "Touch",
          "type": "integer"
        },
        "pedals": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Pedals",
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "TklDeckGrid",
      "type": "object"
    },
    "TklDeckKey": {
      "additionalProperties": true,
      "description": "A key in a profile: its type from the catalogue and what it points at, as data (SD5).\n\nWhat the owner may change in Studio (SD43) is here too: the text and the line under, what a\npress and a hold do from the fixed list `DeckAction`, and what the key shows. Never the\ncolours, the symbols or what a gesture means (SD3): those follow the catalogue.",
      "properties": {
        "type": {
          "$ref": "#/$defs/DeckKeyType"
        },
        "slot": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tåget, linjen eller vägen i tur.",
          "title": "Slot"
        },
        "point": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Signalen eller punkten (SIGNAL).",
          "title": "Point"
        },
        "place": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platsen (PLACE, TRACK).",
          "title": "Place"
        },
        "part": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Delen (PART).",
          "title": "Part"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sidan knappen öppnar.",
          "title": "Page"
        },
        "dx": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Utsnittets kolumn (CELL).",
          "title": "Dx"
        },
        "dy": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Utsnittets rad (CELL).",
          "title": "Dy"
        },
        "rect": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Biten av spårplanen i rutor: x, y, bredd, höjd (TILE).",
          "title": "Rect"
        },
        "pan": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckPan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "function": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Panelfunktionens namn (PANEL).",
          "title": "Function"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/TklDeckRoute"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Snabbvägens väg (ROUTE)."
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spåret: växelgatans eller vägen ut:s spår i delen (STREET, REQUEST, #87).",
          "title": "Track"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartSide"
            },
            {
