{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.deck-open.schema.json",
  "title": "trainmeet.tkl-1.deck-open",
  "$defs": {
    "DeckConnection": {
      "description": "How a deck is connected (SD50): a local TKL owns it over USB; in the cloud the browser\ndrives it with WebHID; or it is the deck on the screen (SD59).",
      "enum": [
        "usb",
        "webhid",
        "skarm"
      ],
      "title": "DeckConnection",
      "type": "string"
    },
    "DeckModelId": {
      "description": "Elgato's models (SD52). Module 6, 15 and 32 and the older editions of the 15 get the\nprofile of the size they have (SD54).",
      "enum": [
        "mini",
        "neo",
        "15",
        "xl",
        "plus",
        "plus-xl",
        "pedal",
        "module-6",
        "module-15",
        "module-32",
        "studio"
      ],
      "title": "DeckModelId",
      "type": "string"
    },
    "TklDeckGrid": {
      "additionalProperties": true,
      "description": "What a deck has (SD53): the keys in columns and rows, and the dials, the touch strip,\nthe info line, the touch points and the pedals. A model TKL does not know is read this\nway too, and gets the default for its grid.",
      "properties": {
        "columns": {
          "maximum": 32,
          "minimum": 0,
          "title": "Columns",
          "type": "integer"
        },
        "rows": {
          "maximum": 8,
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "dials": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Dials",
          "type": "integer"
        },
        "strip": {
          "default": false,
          "description": "Pekremsan, på + och + XL.",
          "title": "Strip",
          "type": "boolean"
        },
        "info": {
          "default": false,
          "description": "Inforaden, på Neo.",
          "title": "Info",
          "type": "boolean"
        },
        "touch": {
          "default": 0,
          "description": "Pekpunkterna, på Neo.",
          "maximum": 4,
          "minimum": 0,
          "title": "Touch",
          "type": "integer"
        },
        "pedals": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Pedals",
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "TklDeckGrid",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "A deck on this computer, by its serial number: its model, or its grid for a model TKL\ndoes not know (SD53), and how it is connected.",
  "properties": {
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeckModelId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "grid": {
      "anyOf": [
        {
          "$ref": "#/$defs/TklDeckGrid"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workplace": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workplace"
    },
    "connection": {
      "$ref": "#/$defs/DeckConnection",
      "default": "skarm"
    },
    "role": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Öppna decket i en dels roll, som decket på delens skärm (#87 del d). Inget: rollen decket har.",
      "title": "Role"
    }
  },
  "type": "object"
}
