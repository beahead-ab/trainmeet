{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.catalog-1.problem.schema.json",
  "title": "trainmeet.catalog-1.problem",
  "$defs": {
    "ProblemCode": {
      "description": "Why Catalog said no. The web app has the text for each in Swedish and English.",
      "enum": [
        "not_found",
        "changed",
        "not_ready",
        "dcc_only_engines",
        "place_exists",
        "not_home",
        "not_lent",
        "login",
        "tag_taken",
        "tag_on_other_vehicle",
        "tag_changed",
        "bad_tag",
        "too_many",
        "not_here",
        "forbidden",
        "unavailable",
        "bad_picture",
        "picture_too_large",
        "too_many_pictures",
        "storage_full",
        "no_tokens",
        "backgrounds_off",
        "no_vehicle",
        "lent",
        "on_another_trip",
        "archived",
        "not_back",
        "consent_required",
        "reading_busy",
        "reading_failed"
      ],
      "title": "ProblemCode",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "The answer when Catalog says no: 401, 402, 403, 404, 409, 413, 415, 422, 429, 502 or\n503.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ProblemCode"
    },
    "message": {
      "description": "The same in Swedish, for logs and other readers.",
      "title": "Message",
      "type": "string"
    },
    "cards": {
      "anyOf": [
        {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Only for Godkänn alla: the cards whose values do not make a vehicle, so that nothing was approved (CAT-150). Left out otherwise.",
      "title": "Cards"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "type": "object"
}
