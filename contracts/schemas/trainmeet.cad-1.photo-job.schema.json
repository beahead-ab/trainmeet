{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.photo-job.schema.json",
  "title": "trainmeet.cad-1.photo-job",
  "$defs": {
    "Certainty": {
      "description": "How sure a fact is, as in the import and the photo chain (bildkedjan, principle 4).",
      "enum": [
        "certain",
        "probable",
        "uncertain",
        "confirmed"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "CheckSource": {
      "enum": [
        "code",
        "ai"
      ],
      "title": "CheckSource",
      "type": "string"
    },
    "Deviation": {
      "additionalProperties": true,
      "description": "How far one line lies from another: the median and the largest distance, in mm, over\ncount points.",
      "properties": {
        "median": {
          "minimum": 0,
          "title": "Median",
          "type": "number"
        },
        "max": {
          "minimum": 0,
          "title": "Max",
          "type": "number"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "median",
        "max",
        "count"
      ],
      "title": "Deviation",
      "type": "object"
    },
    "FactSource": {
      "description": "Where a fact comes from (bildkedjan, principle 4).",
      "enum": [
        "photo",
        "owner",
        "norm",
        "ai",
        "code",
        "sketch"
      ],
      "title": "FactSource",
      "type": "string"
    },
    "GableEnd": {
      "enum": [
        "A",
        "B"
      ],
      "title": "GableEnd",
      "type": "string"
    },
    "GaugeCheck": {
      "additionalProperties": true,
      "description": "The gauge averaged over the straight stretches, against the scale's (step 9).",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "nominal": {
          "title": "Nominal",
          "type": "number"
        },
        "places": {
          "minimum": 0,
          "title": "Places",
          "type": "integer"
        },
        "agrees": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agrees"
        }
      },
      "required": [
        "nominal",
        "places"
      ],
      "title": "GaugeCheck",
      "type": "object"
    },
    "PhotoChoice": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it means, under the choice.",
          "title": "Hint"
        },
        "sketch": {
          "anyOf": [
            {
              "enum": [
                "two_switches",
                "crossing",
                "single_slip",
                "double_slip",
                "joined",
                "apart"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sketch"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "PhotoChoice",
      "type": "object"
    },
    "PhotoCorners": {
      "additionalProperties": true,
      "description": "The module's corners in the preview's pixels (the photo, or the photos stitched, made\nsmaller), clockwise as seen, the side that is Kant 1 and the side that is gable A: side i\nruns from corner i to corner i + 1. Gable A is one of the two sides beside Kant 1: the one\nbefore it is the module as CAD draws it seen from above (from gable A along Kant 1 the\nmodule lies to the right); the one after it is the module mirrored (part c2).",
      "properties": {
        "corners": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Corners",
          "type": "array"
        },
        "kant1": {
          "maximum": 3,
          "minimum": 0,
          "title": "Kant1",
          "type": "integer"
        },
        "gable_a": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null: the side before Kant 1 (part c1).",
          "title": "Gable A"
        },
        "found": {
          "description": "Code found them; false: a guess to drag into place.",
          "title": "Found",
          "type": "boolean"
        },
        "certain": {
          "description": "Every side's edge fits its line within 2 px.",
          "title": "Certain",
          "type": "boolean"
        },
        "derived": {
          "default": false,
          "description": "Kant 1 and gable A derived from the gables' tracks and the module's known gables (an asymmetric profile), shown for the owner to confirm.",
          "title": "Derived",
          "type": "boolean"
        },
        "why": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why they were derived, or why the owner must tap them.",
          "title": "Why"
        },
        "outlines": {
          "description": "Code is not sure (part c5): Vilken kontur följer modulens kant? Its own first. Read with AI, the AI answers when the corners are left as code put them; without, the owner picks one, or drags the corners.",
          "items": {
            "$ref": "#/$defs/PhotoOutline"
          },
          "title": "Outlines",
          "type": "array"
        },
        "chosen": {
          "anyOf": [
            {
              "enum": [
                "rod",
                "bla",
                "gul",
                "ingen"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The outline the AI chose, when it was asked.",
          "title": "Chosen"
        }
      },
      "required": [
        "corners",
        "kant1",
        "found",
        "certain"
      ],
      "title": "PhotoCorners",
      "type": "object"
    },
    "PhotoFact": {
      "additionalProperties": true,
      "description": "A fact with its origin and certainty: säker, trolig, osäker or bekräftad, and its ±.",
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,59}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "plus_minus": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plus Minus"
        },
        "source": {
          "$ref": "#/$defs/FactSource"
        },
        "certainty": {
          "$ref": "#/$defs/Certainty"
        }
      },
      "required": [
        "key",
        "label",
        "source",
        "certainty"
      ],
      "title": "PhotoFact",
      "type": "object"
    },
    "PhotoFrame": {
      "additionalProperties": true,
      "description": "A module's frame on a sketch (profile Skiss): its four corners in the preview's pixels,\nclockwise, and the long side the chain takes as Kant 1.",
      "properties": {
        "corners": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Corners",
          "type": "array"
        },
        "kant1": {
          "maximum": 3,
          "minimum": 0,
          "title": "Kant1",
          "type": "integer"
        }
      },
      "required": [
        "corners",
        "kant1"
      ],
      "title": "PhotoFrame",
      "type": "object"
    },
    "PhotoGate": {
      "additionalProperties": true,
      "description": "One row of the quality gate (bildkedjan step 3).",
      "properties": {
        "key": {
          "enum": [
            "resolution",
            "tilt",
            "sharpness",
            "clipped",
            "corners",
            "stitch",
            "curve"
          ],
          "title": "Key",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/PhotoLevel"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "level",
        "value",
        "text"
      ],
      "title": "PhotoGate",
      "type": "object"
    },
    "PhotoGrid": {
      "additionalProperties": true,
      "description": "Where a measuring image lies in the module's millimetres: pixel (0, 0)'s centre at\n(x0, y0) mm, ppm px per mm. A photo read with another Kant 1 or gable A than the owner\nchose afterwards keeps its image (part c2): matrix, SVG's (a, b, c, d, e, f), takes the mm\nit was measured in to the module's.",
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "ppm": {
          "exclusiveMinimum": 0,
          "title": "Ppm",
          "type": "number"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "matrix": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 6,
              "minItems": 6,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matrix"
        }
      },
      "required": [
        "x0",
        "y0",
        "ppm",
        "width",
        "height"
      ],
      "title": "PhotoGrid",
      "type": "object"
    },
    "PhotoImage": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "url",
        "width",
        "height"
      ],
      "title": "PhotoImage",
      "type": "object"
    },
    "PhotoJobState": {
      "enum": [
        "corners",
        "queued",
        "running",
        "done",
        "failed"
      ],
      "title": "PhotoJobState",
      "type": "string"
    },
    "PhotoLayer": {
      "additionalProperties": true,
      "description": "Fotot under: the measuring image under the drawing, in the module's millimetres.",
      "properties": {
        "job": {
          "format": "uuid",
          "title": "Job",
          "type": "string"
        },
        "url": {
          "description": "The measuring image at 1 px per mm, a signed address.",
          "title": "Url",
          "type": "string"
        },
        "grid": {
          "$ref": "#/$defs/PhotoGrid"
        }
      },
      "required": [
        "job",
        "url",
        "grid"
      ],
      "title": "PhotoLayer",
      "type": "object"
    },
    "PhotoLevel": {
      "enum": [
        "ok",
        "low",
        "warn",
        "refuse"
      ],
      "title": "PhotoLevel",
      "type": "string"
    },
    "PhotoMark": {
      "additionalProperties": true,
      "description": "A place marked in a question's picture: a track's end at a bridge, A, B, C …",
      "properties": {
        "label": {
          "pattern": "^[A-Z]{1,2}$",
          "title": "Label",
          "type": "string"
        },
        "at": {
          "description": "mm, in the module's coordinates.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        }
      },
      "required": [
        "label",
        "at"
      ],
      "title": "PhotoMark",
      "type": "object"
    },
    "PhotoMeasure": {
      "additionalProperties": true,
      "description": "Dina mått mot fotot: the owner's measure, or the norm's, against the photo's.",
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,59}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The owner's or the norm's; null: none.",
          "title": "Owner"
        },
        "owner_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "photo": {
          "title": "Photo",
          "type": "number"
        },
        "plus_minus": {
          "minimum": 0,
          "title": "Plus Minus",
          "type": "number"
        },
        "agrees": {
          "title": "Agrees",
          "type": "boolean"
        },
        "gable": {
          "anyOf": [
            {
              "$ref": "#/$defs/GableEnd"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "track": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        }
      },
      "required": [
        "key",
        "label",
        "photo",
        "plus_minus",
        "agrees"
      ],
      "title": "PhotoMeasure",
      "type": "object"
    },
    "PhotoOutline": {
      "additionalProperties": true,
      "description": "One of the outlines code found when it is not sure which follows the module's edge\n(part c5): drawn in its colour over the photo, its corners in the preview's pixels.",
      "properties": {
        "id": {
          "enum": [
            "rod",
            "bla",
            "gul"
          ],
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The colour's name, as the owner sees it.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "corners": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Corners",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "corners"
      ],
      "title": "PhotoOutline",
      "type": "object"
    },
    "PhotoPrice": {
      "additionalProperties": true,
      "description": "The price before start (CAD-18, CAD-29): 12 tokens per measuring image read by AI.",
      "properties": {
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "why": {
          "enum": [
            "first",
            "included",
            "same",
            "own_ai",
            "no_ai"
          ],
          "title": "Why",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "tokens",
        "why",
        "text"
      ],
      "title": "PhotoPrice",
      "type": "object"
    },
    "PhotoQuality": {
      "additionalProperties": true,
      "properties": {
        "px_per_mm": {
          "minimum": 0,
          "title": "Px Per Mm",
          "type": "number"
        },
        "tilt": {
          "description": "Degrees from straight down.",
          "minimum": 0,
          "title": "Tilt",
          "type": "number"
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/PhotoGate"
          },
          "title": "Gates",
          "type": "array"
        },
        "length_from_photo": {
          "description": "False under 1 px per mm: no length from it.",
          "title": "Length From Photo",
          "type": "boolean"
        }
      },
      "required": [
        "px_per_mm",
        "tilt",
        "gates",
        "length_from_photo"
      ],
      "title": "PhotoQuality",
      "type": "object"
    },
    "PhotoQuestion": {
      "additionalProperties": true,
      "description": "A question from the chain (bildkedjan step 15, När AI ska fråga): a fixed set of answers,\nwhat code and AI each say, and the owner's answer. A topology question changes the track\nplan; it stops Godkänn spårplanen until it is answered.",
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PhotoQuestionKind"
        },
        "source": {
          "$ref": "#/$defs/CheckSource"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "description": "What the AI or the code sees.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/PhotoChoice"
          },
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The choice the code makes.",
          "title": "Code"
        },
        "ai": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The choice the AI makes.",
          "title": "Ai"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The owner's.",
          "title": "Answer"
        },
        "at": {
          "description": "The place in mm, in the module's coordinates.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "topology": {
          "description": "The answer changes the track plan.",
          "title": "Topology",
          "type": "boolean"
        },
        "closeup": {
          "default": false,
          "description": "Ta en närbild helps here.",
          "title": "Closeup",
          "type": "boolean"
        },
        "closeup_ai": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the AI says from the close-up.",
          "title": "Closeup Ai"
        },
        "marks": {
          "description": "The places the choices name, marked in the picture.",
          "items": {
            "$ref": "#/$defs/PhotoMark"
          },
          "title": "Marks",
          "type": "array"
        },
        "span": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 20000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How much of the module around it to show, mm across.",
          "title": "Span"
        }
      },
      "required": [
        "key",
        "kind",
        "source",
        "title",
        "text",
        "choices",
        "at",
        "topology"
      ],
      "title": "PhotoQuestion",
      "type": "object"
    },
    "PhotoQuestionKind": {
      "enum": [
        "connection",
        "node",
        "hidden",
        "scale",
        "gauge",
        "switch_fit",
        "sleepers",
        "curve",
        "orientation",
        "bridge",
        "wedge"
      ],
      "title": "PhotoQuestionKind",
      "type": "string"
    },
    "PhotoSummary": {
      "additionalProperties": true,
      "description": "Spårplanen: what the chain read.",
      "properties": {
        "tracks_a": {
          "minimum": 0,
          "title": "Tracks A",
          "type": "integer"
        },
        "tracks_b": {
          "minimum": 0,
          "title": "Tracks B",
          "type": "integer"
        },
        "switches": {
          "minimum": 0,
          "title": "Switches",
          "type": "integer"
        },
        "crossings": {
          "minimum": 0,
          "title": "Crossings",
          "type": "integer"
        },
        "ends": {
          "minimum": 0,
          "title": "Ends",
          "type": "integer"
        },
        "track_length": {
          "minimum": 0,
          "title": "Track Length",
          "type": "number"
        },
        "deviation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Deviation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
