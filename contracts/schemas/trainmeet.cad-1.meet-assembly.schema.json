{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.meet-assembly.schema.json",
  "title": "trainmeet.cad-1.meet-assembly",
  "$defs": {
    "ArcSegment": {
      "additionalProperties": true,
      "description": "ARC: a circular piece of track centre, in mm, as DXF's ARC. clockwise is as the drawing\nshows it, with y down.",
      "properties": {
        "kind": {
          "const": "arc",
          "default": "arc",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "center": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Radius",
          "type": "number"
        },
        "clockwise": {
          "title": "Clockwise",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "center",
        "radius",
        "clockwise"
      ],
      "title": "ArcSegment",
      "type": "object"
    },
    "Certainty": {
      "description": "How sure a fact is, as in the import and the photo chain (bildkedjan, principle 4).",
      "enum": [
        "certain",
        "probable",
        "uncertain",
        "confirmed"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "Curve": {
      "additionalProperties": true,
      "description": "Kurvmodul: track 1's radius and the angle, from the string and sagitta or given directly.\nWith Kant 1 as the outer edge the curve turns right seen from gable A, as in the drawing.",
      "properties": {
        "kind": {
          "const": "curve",
          "default": "curve",
          "title": "Kind",
          "type": "string"
        },
        "radius": {
          "description": "Track 1's centre line, in mm.",
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Radius",
          "type": "number"
        },
        "angle": {
          "description": "The angle, in degrees.",
          "exclusiveMaximum": 180,
          "exclusiveMinimum": 0,
          "title": "Angle",
          "type": "number"
        },
        "width": {
          "description": "The module body's width, Kant 1 to the other edge.",
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Width",
          "type": "number"
        },
        "edge": {
          "$ref": "#/$defs/EdgeSide",
          "default": "outer"
        },
        "sides": {
          "$ref": "#/$defs/CurveSides",
          "default": "bent"
        },
        "measured": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurveMeasure"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The string and sagitta the radius and angle came from."
        }
      },
      "required": [
        "radius",
        "angle",
        "width"
      ],
      "title": "Curve",
      "type": "object"
    },
    "CurveMeasure": {
      "additionalProperties": true,
      "description": "The owner's measurement of a curve: a string between track 1's centre at A and B, and the\nsagitta (pilhöjd) from the string's middle to the track (CADMOB-03).",
      "properties": {
        "chord": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Chord",
          "type": "number"
        },
        "sagitta": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Sagitta",
          "type": "number"
        }
      },
      "required": [
        "chord",
        "sagitta"
      ],
      "title": "CurveMeasure",
      "type": "object"
    },
    "CurveSides": {
      "description": "The box's long sides.",
      "enum": [
        "bent",
        "straight"
      ],
      "title": "CurveSides",
      "type": "string"
    },
    "EdgeSide": {
      "description": "Which edge of a curve module is Kant 1.",
      "enum": [
        "outer",
        "inner"
      ],
      "title": "EdgeSide",
      "type": "string"
    },
    "GableEnd": {
      "enum": [
        "A",
        "B"
      ],
      "title": "GableEnd",
      "type": "string"
    },
    "GableLabel": {
      "additionalProperties": true,
      "description": "A gable as the library shows it: \"FREMO dubbelspår\", \"Egen gavel · 3 spår\".",
      "properties": {
        "end": {
          "$ref": "#/$defs/GableEnd"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "norm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Norm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "tracks": {
          "items": {
            "type": "number"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "end",
        "label",
        "tracks"
      ],
      "title": "GableLabel",
      "type": "object"
    },
    "GraphLabel": {
      "additionalProperties": true,
      "description": "Etikett: a text in the drawing at a point in mm, on a piece or a switch or free\n(bildkedjan, R4 and point 21). The Text tool writes them. In a drawing read for Studio the\npoint is in the drawing's own coordinates, ref is the object code tied it to (the nearest\none), and read_by says how the text was read.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "at": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The piece, switch, node or symbol it names.",
          "title": "Ref"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "read_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadBy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Textlager, OCR eller AI; null: written in CAD."
        }
      },
      "required": [
        "id",
        "text",
        "at"
      ],
      "title": "GraphLabel",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": true,
      "description": "Nod: where pieces meet or end. A track at a gable is a module joint with its gable and\nits track number there.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        },
        "at": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "gable": {
          "anyOf": [
            {
              "$ref": "#/$defs/GableEnd"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "track": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spår n i gaveln.",
          "title": "Track"
        }
      },
      "required": [
        "id",
        "type",
        "at"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphOrigin": {
      "additionalProperties": true,
      "properties": {
        "source": {
          "$ref": "#/$defs/GraphSource"
        },
        "certainty": {
          "$ref": "#/$defs/Certainty"
        }
      },
      "required": [
        "source",
        "certainty"
      ],
      "title": "GraphOrigin",
      "type": "object"
    },
    "GraphPiece": {
      "additionalProperties": true,
      "description": "Spårbit: track centre from one node to another, as LINE and ARC segments in order.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "start": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "End",
          "type": "string"
        },
        "segments": {
          "items": {
            "discriminator": {
              "mapping": {
                "arc": "#/$defs/ArcSegment",
                "line": "#/$defs/LineSegment"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LineSegment"
              },
              {
                "$ref": "#/$defs/ArcSegment"
              }
            ]
          },
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spårnummer, när ägaren har gett det.",
          "title": "Track"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "segments"
      ],
      "title": "GraphPiece",
      "type": "object"
    },
    "GraphSource": {
      "description": "Where a piece of the graph comes from.",
      "enum": [
        "measures",
        "photo",
        "sketch",
        "anyrail",
        "drawn",
        "drawing"
      ],
      "title": "GraphSource",
      "type": "string"
    },
    "GraphSwitch": {
      "additionalProperties": true,
      "description": "Växel, korsningsväxel eller korsning, at a node: the station model's Switch with CAD's\nids. The diverging leg's radius and angle, when known. The node is the points (tungspetsen);\nthe diverging leg leaves the through track tangentially toward gable A or B (lärdomarna,\nVäxlar). design is the switch type from the switch library (Växeltyp), null while Okänd.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "node": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Node",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SwitchType"
        },
        "trunk": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trunk"
        },
        "straight": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Straight"
        },
        "diverging": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diverging"
        },
        "radius": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 20000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius"
        },
        "angle": {
          "anyOf": [
            {
              "exclusiveMaximum": 90,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "number": {
          "anyOf": [
            {
              "maxLength": 20,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Växelnummer.",
          "title": "Number"
        },
        "design": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Växeltyp; null: Okänd.",
          "title": "Design"
        },
        "toward": {
          "anyOf": [
            {
              "$ref": "#/$defs/GableEnd"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The gable the diverging leg heads for."
        },
        "locked": {
          "default": false,
          "description": "Lås växelns läge när kurvorna räknas om: Lås mått keeps the points where they are.",
          "title": "Locked",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "node",
        "type"
      ],
      "title": "GraphSwitch",
      "type": "object"
    },
    "GraphSymbol": {
      "additionalProperties": true,
      "description": "Symbol: a figure in a drawing (a signal figure, a triangle, a circle), with its class from\nthe catalogue, the way it faces, the track it stands by and how sure the class is (R3, R4).\nA signal's name and address are those read from its label, when there is one.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SymbolKind"
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignalType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The catalogue's class."
        },
        "lamps": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hsi 2, Hsi 4 …",
          "title": "Lamps"
        },
        "facing": {
          "anyOf": [
            {
              "enum": [
                "east",
                "west"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The way it applies: trains going east or west.",
          "title": "Facing"
        },
        "at": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "piece": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The track it stands by.",
          "title": "Piece"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 20,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "address": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "label": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The label it was named by.",
          "title": "Label"
        },
        "shape": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it looks like: signalfigur, ▲, ● …",
          "title": "Shape"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "at"
      ],
      "title": "GraphSymbol",
      "type": "object"
    },
    "Joint": {
      "additionalProperties": true,
      "description": "Skarv: two modules' gables together, at an angle (CAD-06). The angle turns b's module\ncounterclockwise about the middle of the tracks in the joint; 0 is flush.",
      "properties": {
        "a": {
          "$ref": "#/$defs/JointEnd"
        },
        "b": {
          "$ref": "#/$defs/JointEnd"
        },
        "angle": {
          "default": 0,
          "description": "What the joint adds, in degrees counterclockwise.",
          "maximum": 15.0,
          "minimum": -15.0,
          "title": "Angle",
          "type": "number"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "title": "Joint",
      "type": "object"
    },
    "JointEnd": {
      "additionalProperties": true,
      "description": "One side of a joint: a module in the assembly, and its gable.",
      "properties": {
        "module": {
          "format": "uuid",
          "title": "Module",
          "type": "string"
        },
        "gable": {
          "$ref": "#/$defs/GableEnd"
        }
      },
      "required": [
        "module",
        "gable"
      ],
      "title": "JointEnd",
      "type": "object"
    },
    "LineSegment": {
      "additionalProperties": true,
      "description": "LINE: a straight piece of track centre, in mm.",
      "properties": {
        "kind": {
          "const": "line",
          "default": "line",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "LineSegment",
      "type": "object"
    },
    "MeetModule": {
      "additionalProperties": true,
      "description": "A module of the assembly at the version it pins (CAD-21): its own geometry in its own mm,\nwithout its owner, photos or history.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "number": {
          "pattern": "^M-\\d{3,}$",
          "title": "Number",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "scale": {
          "$ref": "#/$defs/Scale"
        },
        "shape": {
          "discriminator": {
            "mapping": {
              "curve": "#/$defs/Curve",
              "straight": "#/$defs/Straight",
              "trapezoid": "#/$defs/Trapezoid"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Straight"
            },
            {
              "$ref": "#/$defs/Curve"
            },
            {
              "$ref": "#/$defs/Trapezoid"
            }
          ],
          "title": "Shape"
        },
        "gables": {
          "items": {
            "$ref": "#/$defs/GableLabel"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Gables",
          "type": "array"
        },
        "graph": {
          "$ref": "#/$defs/TrackGraph"
        },
        "track_length": {
          "description": "The track pieces' length, in mm.",
          "minimum": 0,
          "title": "Track Length",
          "type": "number"
        },
        "stations": {
          "description": "Används i: the stations in TKL that use the module, by themselves or in another assembly; not through this one.",
          "items": {
            "$ref": "#/$defs/MeetStation"
          },
          "title": "Stations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "number",
