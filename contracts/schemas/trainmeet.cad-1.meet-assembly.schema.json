    "TrackGraph": {
      "additionalProperties": true,
      "description": "Spårgraf: what CAD sends to Studio (CAD-10). Ids are never changed when the module is\nredrawn, and never used again for something else (CAD-20). geometry is \"mm\" for a module's\nreal geometry; a drawing read by the photo chain for Studio gives \"schema\" (bildkedjan, 21),\nin the drawing's own coordinates with y down, with its labels and its symbols, and line exits\nand buffer stops at the tracks' ends. The same format goes both ways to Studio.\ncomplete is false while the tracks between the gables are unknown: a module from measures\nwhose gables differ waits for its photo or its drawing.",
      "properties": {
        "geometry": {
          "default": "mm",
          "enum": [
            "mm",
            "schema"
          ],
          "title": "Geometry",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "pieces": {
          "items": {
            "$ref": "#/$defs/GraphPiece"
          },
          "title": "Pieces",
          "type": "array"
        },
        "switches": {
          "items": {
            "$ref": "#/$defs/GraphSwitch"
          },
          "title": "Switches",
          "type": "array"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/GraphLabel"
          },
          "title": "Labels",
          "type": "array"
        },
        "symbols": {
          "description": "Symbols read from a drawing (bildkedjan R3, 21).",
          "items": {
            "$ref": "#/$defs/GraphSymbol"
          },
          "title": "Symbols",
          "type": "array"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "issued": {
          "default": 0,
          "description": "Ids issued so far; the next is one more.",
          "minimum": 0,
          "title": "Issued",
          "type": "integer"
        }
      },
      "title": "TrackGraph",
      "type": "object"
    },
    "Trapezoid": {
      "additionalProperties": true,
      "description": "A trapezoid, as MMM's (685 × 480/280): the gables parallel, length apart, width_a and\nwidth_b wide. Gable B's corner at Kant 1 lies offset mm from gable A's across the module (y\ndown), the förskjutning the photo test solved for (lärdomarna, Trapets). With offset 0 Kant 1\nis straight and at right angles to the gables, and only the far side slants. A track at the\nsame distance from Kant 1 in both gables of a slanting Kant 1 has to bend: Lås mått makes it\nstraight, arc, straight, arc, straight (CAD-24).",
      "properties": {
        "kind": {
          "const": "trapezoid",
          "default": "trapezoid",
          "title": "Kind",
          "type": "string"
        },
        "length": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Length",
          "type": "number"
        },
        "width_a": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Width A",
          "type": "number"
        },
        "width_b": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Width B",
          "type": "number"
        },
        "offset": {
          "default": 0,
          "description": "Förskjutning: gable B's Kant 1 corner across the module from gable A's, mm.",
          "maximum": 20000,
          "minimum": -20000,
          "title": "Offset",
          "type": "number"
        }
      },
      "required": [
        "length",
        "width_a",
        "width_b"
      ],
      "title": "Trapezoid",
      "type": "object"
    }
