{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.planning-1.id-meet-choice.schema.json",
  "title": "trainmeet.planning-1.id-meet-choice",
  "additionalProperties": true,
  "description": "A meet in TrainMeet ID that the one logged in with ID may plan (ID10, PLAN-19): the\nclub's admin or the organizer. hub_meet is the hub's meet already made from it, if any.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "club_name": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Club Name",
      "type": "string"
    },
    "starts_on": {
      "format": "date",
      "title": "Starts On",
      "type": "string"
    },
    "ends_on": {
      "format": "date",
      "title": "Ends On",
      "type": "string"
    },
    "hub_meet": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hub Meet"
    }
  },
  "required": [
    "id",
    "name",
    "club_name",
    "starts_on",
    "ends_on"
  ],
  "type": "object"
}
