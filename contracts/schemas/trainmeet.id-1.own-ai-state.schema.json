{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.own-ai-state.schema.json",
  "title": "trainmeet.id-1.own-ai-state",
  "$defs": {
    "TokenOwner": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "$ref": "#/$defs/TokenOwnerKind"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "TokenOwner",
      "type": "object"
    },
    "TokenOwnerKind": {
      "description": "Vems saldo (TK1): personens, för egna fordon och moduler, eller klubbens, för\nträffarnas import (TK16).",
      "enum": [
        "person",
        "club"
      ],
      "title": "TokenOwnerKind",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "owner": {
      "$ref": "#/$defs/TokenOwner"
    },
    "format": {
      "description": "chat: det vanliga chatt-API:t. claude: Claudes eget API (H59).",
      "enum": [
        "chat",
        "claude"
      ],
      "title": "Format",
      "type": "string"
    },
    "address": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Address",
      "type": "string"
    },
    "model": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "key_set": {
      "description": "False om nyckeln behöver läggas in igen.",
      "title": "Key Set",
      "type": "boolean"
    },
    "checked": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "När ID senast provade att modellen läser bilder (H70).",
      "title": "Checked"
    }
  },
  "required": [
    "owner",
    "format",
    "address",
    "model",
    "key_set"
  ],
  "type": "object"
}
