{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.track-graph.schema.json",
  "title": "trainmeet.cad-1.track-graph",
  "$defs": {
    "ArcSegment": {
      "additionalProperties": true,
      "description": "ARC: a circular piece of track centre, in mm, as DXF's ARC. clockwise is as the drawing\nshows it, with y down.",
      "properties": {
        "kind": {
          "const": "arc",
          "default": "arc",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "center": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Radius",
          "type": "number"
        },
        "clockwise": {
          "title": "Clockwise",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "center",
        "radius",
        "clockwise"
      ],
      "title": "ArcSegment",
      "type": "object"
    },
    "Certainty": {
      "description": "How sure a fact is, as in the import and the photo chain (bildkedjan, principle 4).",
      "enum": [
        "certain",
        "probable",
        "uncertain",
        "confirmed"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "GableEnd": {
      "enum": [
        "A",
        "B"
      ],
      "title": "GableEnd",
      "type": "string"
    },
    "GraphNode": {
      "additionalProperties": true,
      "description": "Nod: where pieces meet or end. A track at a gable is a module joint with its gable and\nits track number there.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        },
        "at": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "gable": {
          "anyOf": [
            {
              "$ref": "#/$defs/GableEnd"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "track": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spår n i gaveln.",
          "title": "Track"
        }
      },
      "required": [
        "id",
        "type",
        "at"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphOrigin": {
      "additionalProperties": true,
      "properties": {
        "source": {
          "$ref": "#/$defs/GraphSource"
        },
        "certainty": {
          "$ref": "#/$defs/Certainty"
        }
      },
      "required": [
        "source",
        "certainty"
      ],
      "title": "GraphOrigin",
      "type": "object"
    },
    "GraphPiece": {
      "additionalProperties": true,
      "description": "Spårbit: track centre from one node to another, as LINE and ARC segments in order.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "start": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "End",
          "type": "string"
        },
        "segments": {
          "items": {
            "discriminator": {
              "mapping": {
                "arc": "#/$defs/ArcSegment",
                "line": "#/$defs/LineSegment"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LineSegment"
              },
              {
                "$ref": "#/$defs/ArcSegment"
              }
            ]
          },
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spårnummer, när ägaren har gett det.",
          "title": "Track"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "segments"
      ],
      "title": "GraphPiece",
      "type": "object"
    },
    "GraphSource": {
      "description": "Where a piece of the graph comes from.",
      "enum": [
        "measures",
        "photo",
        "sketch",
        "anyrail",
        "drawn"
      ],
      "title": "GraphSource",
      "type": "string"
    },
    "GraphSwitch": {
      "additionalProperties": true,
      "description": "Växel, korsningsväxel eller korsning, at a node: the station model's Switch with CAD's\nids. The diverging leg's radius and angle, when known.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "node": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Node",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SwitchType"
        },
        "trunk": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trunk"
        },
        "straight": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Straight"
        },
        "diverging": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diverging"
        },
        "radius": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 20000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius"
        },
        "angle": {
          "anyOf": [
            {
              "exclusiveMaximum": 90,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "node",
        "type"
      ],
      "title": "GraphSwitch",
      "type": "object"
    },
    "LineSegment": {
      "additionalProperties": true,
      "description": "LINE: a straight piece of track centre, in mm.",
      "properties": {
        "kind": {
          "const": "line",
          "default": "line",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "LineSegment",
      "type": "object"
    },
    "NodeType": {
      "description": "What is at a node. A node joins track pieces; how many depends on the type.",
      "enum": [
        "switch",
        "crossing",
        "signal_point",
        "block_boundary",
        "module_joint",
        "joint",
        "stop_point",
        "buffer_stop",
        "line_exit",
        "turntable"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "SwitchType": {
      "description": "Växeltyp (RS1).",
      "enum": [
        "ordinary",
        "y",
        "single_slip",
        "double_slip",
        "crossing"
      ],
      "title": "SwitchType",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Spårgraf: what CAD sends to Studio (CAD-10). Ids are never changed when the module is\nredrawn, and never used again for something else (CAD-20). geometry is \"mm\" for a module's\nreal geometry; a drawing read by the photo chain for Studio gives \"schema\" (bildkedjan, 21).\ncomplete is false while the tracks between the gables are unknown: a module from measures\nwhose gables differ waits for its photo or its drawing.",
  "properties": {
    "geometry": {
      "default": "mm",
      "enum": [
        "mm",
        "schema"
      ],
      "title": "Geometry",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "pieces": {
      "items": {
        "$ref": "#/$defs/GraphPiece"
      },
      "title": "Pieces",
      "type": "array"
    },
    "switches": {
      "items": {
        "$ref": "#/$defs/GraphSwitch"
      },
      "title": "Switches",
      "type": "array"
    },
    "complete": {
      "default": true,
      "title": "Complete",
      "type": "boolean"
    },
    "issued": {
      "default": 0,
      "description": "Ids issued so far; the next is one more.",
      "minimum": 0,
      "title": "Issued",
      "type": "integer"
    }
  },
  "type": "object"
}
