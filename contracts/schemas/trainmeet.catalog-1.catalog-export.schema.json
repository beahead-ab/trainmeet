{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.catalog-1.catalog-export.schema.json",
  "title": "trainmeet.catalog-1.catalog-export",
  "$defs": {
    "DccFunction": {
      "additionalProperties": true,
      "description": "A locomotive's function: F0 light, F2 horn ... (CAT-66).",
      "properties": {
        "number": {
          "maximum": 68,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "name": {
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "number",
        "name"
      ],
      "title": "DccFunction",
      "type": "object"
    },
    "EvnParts": {
      "additionalProperties": true,
      "description": "The EVN read from the number (CAT-57). Derived every time, never stored.",
      "properties": {
        "text": {
          "description": "For example 21 74 245 2 253-0, with the computed check digit.",
          "title": "Text",
          "type": "string"
        },
        "interop": {
          "title": "Interop",
          "type": "string"
        },
        "country": {
          "title": "Country",
          "type": "string"
        },
        "country_letters": {
          "description": "For example S for 74. Empty when unknown.",
          "title": "Country Letters",
          "type": "string"
        },
        "serial": {
          "title": "Serial",
          "type": "string"
        },
        "check": {
          "title": "Check",
          "type": "integer"
        },
        "given": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The painted check digit, or null when not painted.",
          "title": "Given"
        },
        "valid": {
          "description": "False only when the painted check digit is wrong (CAT-59).",
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "interop",
        "country",
        "country_letters",
        "serial",
        "check",
        "given",
        "valid"
      ],
      "title": "EvnParts",
      "type": "object"
    },
    "FieldProfile": {
      "description": "The field profiles from the start (CAT-158, C31).",
      "enum": [
        "SE",
        "EU",
        "US"
      ],
      "title": "FieldProfile",
      "type": "string"
    },
    "FieldSource": {
      "description": "Where a core field's value came from (CAT-64).",
      "enum": [
        "owner",
        "ai",
        "prototype",
        "import"
      ],
      "title": "FieldSource",
      "type": "string"
    },
    "Lending": {
      "additionalProperties": true,
      "description": "Who has the vehicle: the owner's own note (CAT-74, CAT-75).",
      "properties": {
        "to": {
          "maxLength": 500,
          "minLength": 1,
          "title": "To",
          "type": "string"
        },
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        }
      },
      "required": [
        "to",
        "since"
      ],
      "title": "Lending",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": true,
      "description": "Någon sa till: where someone saw the vehicle, without who said it (CAT-113).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "at"
      ],
      "title": "Notice",
      "type": "object"
    },
    "OwnerSettings": {
      "additionalProperties": true,
      "description": "Visa mitt namn när någon blippar mina fordon: off from the start (CAT-101).",
      "properties": {
        "show_name": {
          "default": false,
          "title": "Show Name",
          "type": "boolean"
        }
      },
      "title": "OwnerSettings",
      "type": "object"
    },
    "PictureLinks": {
      "additionalProperties": true,
      "description": "The vehicle's main picture, for the lists and the card (CAT-125). Signed addresses that\nexpire (CAT-130): read the vehicle again for new ones.",
      "properties": {
        "thumb_url": {
          "description": "The thumbnail, at most 360×240 pixels (CAT-126).",
          "title": "Thumb Url",
          "type": "string"
        },
        "display_url": {
          "description": "The display picture, at most 1800 pixels (CAT-126).",
          "title": "Display Url",
          "type": "string"
        }
      },
      "required": [
        "thumb_url",
        "display_url"
      ],
      "title": "PictureLinks",
      "type": "object"
    },
    "Place": {
      "additionalProperties": true,
      "description": "A named place at home: a box or a shelf (CAT-71).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "vehicles_home": {
          "description": "How many vehicles are at home here now.",
          "title": "Vehicles Home",
          "type": "integer"
        },
        "vehicles": {
          "description": "How many vehicles live here, wherever they are now.",
          "title": "Vehicles",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "vehicles_home",
        "vehicles"
      ],
      "title": "Place",
      "type": "object"
    },
    "TagKind": {
      "description": "An NFC tag, a QR label or a simulated tag (CAT-78, CAT-96, CAT-121).",
      "enum": [
        "nfc",
        "qr",
        "sim"
      ],
      "title": "TagKind",
      "type": "string"
    },
    "Tick": {
      "additionalProperties": true,
      "description": "A bock: one per vehicle and step, with its time (CAT-176).",
      "properties": {
        "step": {
          "$ref": "#/$defs/TripStep"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/TickBy"
        }
      },
      "required": [
        "step",
        "at",
        "by"
      ],
      "title": "Tick",
      "type": "object"
    },
    "TickBy": {
      "description": "How a tick was set (CAT-176).",
      "enum": [
        "tap",
        "press"
      ],
      "title": "TickBy",
      "type": "string"
    },
    "Trip": {
      "additionalProperties": true,
      "description": "A meet with its pack list and its three steps (CAT-174–CAT-180).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "archived_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the pack list was archived (CAT-183). An archived meet does not change.",
          "title": "Archived At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "template_of": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The meet whose pack list this one started from (CAT-183).",
          "title": "Template Of"
        },
        "vehicles": {
          "description": "How many vehicles are on the pack list.",
          "title": "Vehicles",
          "type": "integer"
        },
        "done": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "How many are ticked in each step, for 3 av 4 (CAT-178).",
          "propertyNames": {
            "$ref": "#/$defs/TripStep"
          },
          "title": "Done",
          "type": "object"
        },
        "step": {
          "$ref": "#/$defs/TripStep",
          "description": "The step the trip is at: the latest one ticked in, or the next when that one is done. The web app opens it, and a tap without a step ticks in it."
        },
        "rows": {
          "description": "In the pack list's order; when the trip is at Hem, Saknas first (CAT-179).",
          "items": {
            "$ref": "#/$defs/TripRow"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "date",
        "created_at",
        "vehicles",
        "done",
        "step",
        "rows"
      ],
      "title": "Trip",
      "type": "object"
    },
    "TripRow": {
      "additionalProperties": true,
      "description": "A vehicle on the pack list, with its ticks.",
      "properties": {
        "vehicle": {
          "$ref": "#/$defs/Vehicle",
          "description": "The vehicle as its owner sees it: its place, state and picture, and what someone who found it said (CAT-180)."
        },
        "added_at": {
          "format": "date-time",
          "title": "Added At",
          "type": "string"
        },
        "ticks": {
          "description": "At most one per step, in the steps' order.",
          "items": {
            "$ref": "#/$defs/Tick"
          },
          "title": "Ticks",
          "type": "array"
        },
        "last": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tick"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The latest tick: when, and in which step, the vehicle was last ticked. Saknas at Hem shows it (CAT-179)."
        },
        "missing": {
          "description": "Saknas: not ticked in Hem. When the trip is at Hem these come first (CAT-179).",
          "title": "Missing",
          "type": "boolean"
        }
      },
      "required": [
        "vehicle",
        "added_at",
        "ticks",
        "missing"
      ],
      "title": "TripRow",
      "type": "object"
    },
    "TripStep": {
      "description": "The trip's three steps (CAT-176).",
      "enum": [
        "pack",
        "arrive",
        "home"
      ],
      "title": "TripStep",
      "type": "string"
    },
    "Vehicle": {
      "additionalProperties": true,
      "description": "A vehicle as its owner sees it.",
      "properties": {
        "status": {
          "$ref": "#/$defs/VehicleStatus",
          "default": "draft"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/VehicleKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "litt": {
          "default": "",
          "maxLength": 80,
          "title": "Litt",
          "type": "string"
        },
        "number": {
          "default": "",
          "description": "As painted: leading zeros, spaces, dashes kept.",
          "maxLength": 80,
          "title": "Number",
          "type": "string"
        },
        "operator": {
          "default": "",
          "description": "The operator as text. No logos (CAT-61).",
          "maxLength": 80,
          "title": "Operator",
          "type": "string"
        },
        "epoch": {
          "default": "",
          "maxLength": 12,
          "title": "Epoch",
          "type": "string"
        },
        "scale": {
          "default": "",
          "maxLength": 12,
          "title": "Scale",
          "type": "string"
        },
        "maker": {
          "default": "",
          "description": "The model's maker.",
          "maxLength": 80,
          "title": "Maker",
          "type": "string"
        },
        "article_number": {
          "default": "",
          "maxLength": 80,
          "title": "Article Number",
          "type": "string"
        },
        "note": {
          "default": "",
          "description": "Private. Never in a mini card or an export to others (CAT-191).",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        },
        "dcc_address": {
          "default": "",
          "description": "Locomotives and multiple units: the DCC address as text.",
          "maxLength": 8,
          "title": "Dcc Address",
          "type": "string"
        },
        "functions": {
          "items": {
            "$ref": "#/$defs/DccFunction"
          },
          "maxItems": 69,
          "title": "Functions",
          "type": "array"
        },
        "place": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The place at home.",
          "title": "Place"
        },
        "id": {
          "description": "Permanent, never reused, kept when the tag changes (CAT-52).",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/VehicleState"
        },
        "place_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Name"
        },
        "lending": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lending"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evn": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvnParts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field_sources": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldSource"
          },
          "title": "Field Sources",
          "type": "object"
        },
        "tags": {
          "description": "At most one NFC, one QR. Only the owner sees them.",
          "items": {
            "$ref": "#/$defs/VehicleTag"
          },
          "title": "Tags",
          "type": "array"
        },
        "tagged": {
          "default": false,
          "description": "The vehicle has a tag: what someone it is shared with sees (CAT-47).",
          "title": "Tagged",
          "type": "boolean"
        },
        "notices": {
          "description": "Newest first.",
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Notices",
          "type": "array"
        },
        "picture": {
          "anyOf": [
            {
              "$ref": "#/$defs/PictureLinks"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The main picture, or null without pictures. Seen with every right."
        },
        "prototype": {
          "anyOf": [
            {
              "$ref": "#/$defs/VehiclePrototype"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The prototype the vehicle is linked to, with its type data: a block of its own, apart from the core fields (CAT-160–CAT-162). Null when not linked."
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "state",
        "created_at",
        "updated_at"
      ],
      "title": "Vehicle",
      "type": "object"
    },
    "VehicleEvent": {
      "additionalProperties": true,
      "description": "A change of state or place, with its time. Only the owner sees them (CAT-77).",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/VehicleState"
        },
        "place_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Name"
        },
        "lent_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lent To"
        },
        "meet_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The meet whose trip moved the vehicle, as it was named then (CAT-182).",
          "title": "Meet Name"
        }
      },
      "required": [
        "at",
        "state"
      ],
      "title": "VehicleEvent",
      "type": "object"
    },
    "VehicleHistory": {
      "additionalProperties": true,
      "description": "One vehicle's events, in the file with the person's data.",
      "properties": {
        "vehicle": {
          "format": "uuid",
          "title": "Vehicle",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/VehicleEvent"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "vehicle",
        "events"
      ],
      "title": "VehicleHistory",
      "type": "object"
    },
    "VehicleKind": {
      "description": "The kinds of vehicle (CAT-54).",
      "enum": [
        "locomotive",
        "freight_wagon",
        "passenger_coach",
        "multiple_unit",
        "other"
      ],
      "title": "VehicleKind",
      "type": "string"
    },
    "VehiclePrototype": {
      "additionalProperties": true,
      "description": "The vehicle's link to a prototype, with the type data the card shows (CAT-160–CAT-162).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/VehicleKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile": {
          "$ref": "#/$defs/FieldProfile"
        },
        "revision": {
          "description": "The revision of the snapshot.",
          "title": "Revision",
          "type": "integer"
        },
        "snapshot": {
          "description": "The prototype's type data at that revision.",
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "maxLength": 1000,
              "type": "string"
            }
          },
          "title": "Snapshot",
          "type": "object"
        },
        "overrides": {
          "description": "The owner's own values, which the prototype never overwrites (CAT-162).",
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "maxLength": 1000,
              "type": "string"
            }
          },
          "title": "Overrides",
          "type": "object"
        },
        "fields": {
          "description": "What the card shows: the snapshot with the owner's own values over it.",
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "maxLength": 1000,
              "type": "string"
            }
          },
          "title": "Fields",
          "type": "object"
        },
        "latest": {
          "description": "The prototype's newest reviewed revision.",
          "title": "Latest",
          "type": "integer"
        },
        "newer": {
          "description": "Ny version finns: latest is newer than the snapshot.",
          "title": "Newer",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "profile",
        "revision",
        "snapshot",
        "overrides",
        "fields",
        "latest",
        "newer"
      ],
      "title": "VehiclePrototype",
      "type": "object"
    },
    "VehicleState": {
      "description": "Where the vehicle is (CAT-70). Packed and at the meet are set by the trip (#55).",
      "enum": [
        "home",
        "packed",
        "at_meet",
        "lent"
      ],
      "title": "VehicleState",
      "type": "string"
    },
    "VehicleStatus": {
      "description": "A draft, or ready: ready needs a kind and a litt or number (CAT-62).",
      "enum": [
        "draft",
        "ready"
      ],
      "title": "VehicleStatus",
      "type": "string"
    },
    "VehicleTag": {
      "additionalProperties": true,
      "description": "A tag on the vehicle, as the card shows it (CAT-97).",
      "properties": {
        "assignment": {
          "description": "The link. A change carries it (CAT-89).",
          "format": "uuid",
          "title": "Assignment",
          "type": "string"
        },
        "tag": {
          "format": "uuid",
          "title": "Tag",
          "type": "string"
        },
        "uid": {
          "description": "What stands after /t/ in the address.",
          "title": "Uid",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TagKind"
        },
        "address": {
          "description": "For example https://trainmeet.app/t/04a1b2c3d4e5f6.",
          "title": "Address",
          "type": "string"
        },
        "linked_at": {
          "format": "date-time",
          "title": "Linked At",
          "type": "string"
        }
      },
      "required": [
        "assignment",
        "tag",
        "uid",
        "name",
        "kind",
        "address",
        "linked_at"
      ],
      "title": "VehicleTag",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Everything Catalog holds for one owner, for the file the person fetches before removing the\naccount (KONTO-31, ID7). Only TrainMeet ID asks, with a token of its own.",
  "properties": {
    "owner": {
      "format": "uuid",
      "title": "Owner",
      "type": "string"
    },
    "vehicles": {
      "items": {
        "$ref": "#/$defs/Vehicle"
      },
      "title": "Vehicles",
      "type": "array"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/VehicleHistory"
      },
      "title": "History",
      "type": "array"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/Place"
      },
      "title": "Places",
      "type": "array"
    },
    "settings": {
      "$ref": "#/$defs/OwnerSettings"
    },
    "trips": {
      "description": "The meets with their pack lists and ticks (#55).",
      "items": {
        "$ref": "#/$defs/Trip"
      },
      "title": "Trips",
      "type": "array"
    }
  },
  "required": [
    "owner",
