{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.new-meet.schema.json",
  "title": "trainmeet.id-1.new-meet",
  "additionalProperties": true,
  "description": "A meet as ID holds it: a reference with name, dates and club (ID10). The meet itself, its\nplan and its traffic, belongs to the Hub (KONTO-09).",
  "properties": {
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "starts_on": {
      "format": "date",
      "title": "Starts On",
      "type": "string"
    },
    "ends_on": {
      "format": "date",
      "title": "Ends On",
      "type": "string"
    }
  },
  "required": [
    "name",
    "starts_on",
    "ends_on"
  ],
  "type": "object"
}
