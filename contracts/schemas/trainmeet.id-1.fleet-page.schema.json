{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.fleet-page.schema.json",
  "title": "trainmeet.id-1.fleet-page",
  "$defs": {
    "Grant": {
      "additionalProperties": true,
      "description": "A role someone has for a resource.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "person": {
          "$ref": "#/$defs/Person"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "person",
        "role",
        "resource",
        "at"
      ],
      "title": "Grant",
      "type": "object"
    },
    "Invitation": {
      "additionalProperties": true,
      "description": "An invitation to a club (KONTO-35) or to a shared fleet (KONTO-29). Gives nothing\nuntil the person it was sent to has said yes.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "title": {
          "description": "What it is about: the club's name, or whose fleet.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "sent_to": {
          "description": "The address, partly hidden to anyone but its owner.",
          "title": "Sent To",
          "type": "string"
        },
        "sent_by": {
          "$ref": "#/$defs/Person"
        },
        "state": {
          "$ref": "#/$defs/InvitationState"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "resource",
        "role",
        "title",
        "sent_to",
        "sent_by",
        "state",
        "at"
      ],
      "title": "Invitation",
      "type": "object"
    },
    "InvitationState": {
      "enum": [
        "waiting",
        "accepted",
        "declined"
      ],
      "title": "InvitationState",
      "type": "string"
    },
    "Person": {
      "additionalProperties": true,
      "description": "Someone else, as a member or someone with a role: never their address.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "initials": {
          "maxLength": 3,
          "minLength": 1,
          "title": "Initials",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "initials"
      ],
      "title": "Person",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": true,
      "description": "One thing a role applies to: its kind and its id in the app that owns it.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Resource",
      "type": "object"
    },
    "ResourceKind": {
      "description": "What a role applies to (KONTO-03). ID only holds the reference, never the thing.",
      "enum": [
        "club",
        "fleet",
        "meet",
        "station",
        "module",
        "hub",
        "catalog"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "Role": {
      "description": "The roles ID holds on one place (KONTO-28, KONTO-30, CAT-44, KONTO-35).",
      "enum": [
        "admin",
        "member",
        "organizer",
        "reader",
        "dispatcher",
        "loco_lead",
        "remote_clearer",
        "reviewer",
        "viewer",
        "editor"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Who the fleet is shared with, and who is invited (CAT-44, CAT-45).",
  "properties": {
    "owner": {
      "$ref": "#/$defs/Resource"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "grants": {
      "items": {
        "$ref": "#/$defs/Grant"
      },
      "title": "Grants",
      "type": "array"
    },
    "invitations": {
      "items": {
        "$ref": "#/$defs/Invitation"
      },
      "title": "Invitations",
      "type": "array"
    }
  },
  "required": [
    "owner",
    "title",
    "grants",
    "invitations"
  ],
  "type": "object"
}
