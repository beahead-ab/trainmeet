{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.station-model-1.schema.json",
  "title": "trainmeet.station-model-1",
  "$defs": {
    "Address": {
      "additionalProperties": true,
      "description": "A decoder or detector address on a bus (level 3).",
      "properties": {
        "bus": {
          "default": "LocoNet",
          "description": "Bussen adressen gäller på.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Bus",
          "type": "string"
        },
        "number": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        }
      },
      "required": [
        "number"
      ],
      "title": "Address",
      "type": "object"
    },
    "Lever": {
      "additionalProperties": true,
      "description": "Spak: for + and -, the position each switch gets.\n\nThe lever's own switches are in both positions. A switch that only one position names is\ndragged along by the lever in that position (drar med, TKL104) and has a lever of its own.\nAn own switch that gets - in the lever's + lies reversed (omvänd).",
      "properties": {
        "id": {
          "description": "Till exempel \"101/102\" eller \"22\".",
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "plus": {
          "additionalProperties": {
            "$ref": "#/$defs/Position"
          },
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Plus",
          "type": "object"
        },
        "minus": {
          "additionalProperties": {
            "$ref": "#/$defs/Position"
          },
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Minus",
          "type": "object"
        }
      },
      "required": [
        "id",
        "plus",
        "minus"
      ],
      "title": "Lever",
      "type": "object"
    },
    "LineExit": {
      "additionalProperties": true,
      "description": "Linjeutfart: where a track leaves the station for the line.",
      "properties": {
        "id": {
          "description": "Bokstav eller id, till exempel A1.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "node": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Node",
          "type": "string"
        },
        "neighbour": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grannstationen.",
          "title": "Neighbour"
        },
        "tracks": {
          "description": "Stationsspåren som når hit.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Tracks",
          "type": "array"
        },
        "signals": {
          "description": "Signalerna vid gränsen.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "node"
      ],
      "title": "LineExit",
      "type": "object"
    },
    "Node": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeType": {
      "description": "What is at a node. A node joins track pieces; how many depends on the type.",
      "enum": [
        "switch",
        "crossing",
        "signal_point",
        "block_boundary",
        "module_joint",
        "joint",
        "stop_point",
        "buffer_stop",
        "line_exit",
        "turntable"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "Origin": {
      "additionalProperties": true,
      "description": "The source of one item, and whether the owner has confirmed it (RS5, RS7).",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "confirmed": {
          "default": false,
          "description": "Ägaren har bekräftat uppgiften. Antaget syns gult i Studio.",
          "title": "Confirmed",
          "type": "boolean"
        },
        "ref": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Uppgiftens namn i källan, till exempel AnyRail-id 1680 eller Vx162.",
          "title": "Ref"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "source"
      ],
      "title": "Origin",
      "type": "object"
    },
    "PanelBuilding": {
      "additionalProperties": true,
      "properties": {
        "cells": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Cells",
          "type": "array"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "cells",
        "name"
      ],
      "title": "PanelBuilding",
      "type": "object"
    },
    "PanelDeviation": {
      "additionalProperties": true,
      "description": "Where the plan departs from the drawing, said out loud (TKL82, STD-28).\n\nThe names here are the drawing's, so a piece that is not shown need not be in the model.",
      "properties": {
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "not_shown": {
          "$ref": "#/$defs/PanelHidden"
        },
        "rewired": {
          "description": "Omkopplade spårbitar.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rewired",
          "type": "array"
        },
        "new_pieces": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "New Pieces",
          "type": "array"
        },
        "switches": {
          "additionalProperties": {
            "$ref": "#/$defs/PanelDeviationSwitch"
          },
          "description": "Nya växlar och växlar med ett annat nummer.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Switches",
          "type": "object"
        },
        "knots": {
          "description": "Noder mitt på ett annat spår.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Knots",
          "type": "array"
        }
      },
      "required": [
        "reason"
      ],
      "title": "PanelDeviation",
      "type": "object"
    },
    "PanelDeviationSwitch": {
      "additionalProperties": true,
      "properties": {
        "drawing_number": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Växelns nummer i ritningen. Saknas: växeln är ny.",
          "title": "Drawing Number"
        }
      },
      "title": "PanelDeviationSwitch",
      "type": "object"
    },
    "PanelFunction": {
      "additionalProperties": true,
      "description": "A button on the panel, from the catalogue, with its parameters.",
      "properties": {
        "type": {
          "$ref": "#/$defs/PanelFunctionType"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "track_circuits": {
          "description": "Området.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Track Circuits",
          "type": "array"
        },
        "switches": {
          "description": "Lokala växlar, som läggs med knappar på modulerna.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Switches",
          "type": "array"
        },
        "locked": {
          "additionalProperties": {
            "$ref": "#/$defs/Position"
          },
          "description": "Skyddsväxlarnas spakar och läget de låses i.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Locked",
          "type": "object"
        },
        "signals": {
          "description": "Signaler som visar växling.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "pieces": {
          "description": "Spåret funktionen gäller.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        },
        "at": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platsen för knappen, till exempel en nod.",
          "title": "At"
        },
        "modes": {
          "description": "Körströmmens lägen, 2R och 3R.",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Modes",
          "type": "array"
        },
        "codes": {
          "additionalProperties": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "description": "Knappens kod per skal, till exempel L01 i 95.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Codes",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "PanelFunction",
      "type": "object"
    },
    "PanelFunctionType": {
      "description": "The panel functions' catalogue. New functions are added here for all (STD-19).",
      "enum": [
        "signal_stop",
        "local_release",
        "traction_current",
        "out_of_service",
        "emergency_release",
        "turntable",
        "programming_track"
      ],
      "title": "PanelFunctionType",
      "type": "string"
    },
    "PanelGrid": {
      "additionalProperties": true,
      "properties": {
        "dx": {
          "description": "Rutans bredd.",
          "exclusiveMinimum": 0,
          "title": "Dx",
          "type": "number"
        },
        "dy": {
          "description": "Rutans höjd.",
          "exclusiveMinimum": 0,
          "title": "Dy",
          "type": "number"
        }
      },
      "required": [
        "dx",
        "dy"
      ],
      "title": "PanelGrid",
      "type": "object"
    },
    "PanelHidden": {
      "additionalProperties": true,
      "properties": {
        "pieces": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        },
        "switches": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Switches",
          "type": "array"
        },
        "crossings": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Crossings",
          "type": "array"
        }
      },
      "title": "PanelHidden",
      "type": "object"
    },
    "PanelPiece": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "reversed": {
          "default": false,
          "description": "Spårbiten går åt andra hållet längs vägen.",
          "title": "Reversed",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "PanelPiece",
      "type": "object"
    },
    "PanelPlacement": {
      "additionalProperties": true,
      "properties": {
        "piece": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Piece",
          "type": "string"
        },
        "at": {
          "description": "Läget längs spårbiten, 0 i början och 1 i slutet.",
          "maximum": 1,
          "minimum": 0,
          "title": "At",
          "type": "number"
        },
        "reversed": {
          "default": false,
          "description": "Mot spårbitens riktning.",
          "title": "Reversed",
          "type": "boolean"
        }
      },
      "required": [
        "piece",
        "at"
      ],
      "title": "PanelPlacement",
      "type": "object"
    },
    "PanelPlan": {
      "additionalProperties": true,
      "description": "Spårplan: the schematic panel, as the owner has redrawn it on the grid.\n\nDel b builds and checks the panel from it; the model only holds it.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vad planen är ritad efter.",
          "title": "Basis"
        },
        "grid": {
          "$ref": "#/$defs/PanelGrid"
        },
        "turntable": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelTurntable"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nodes": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Nodes",
          "type": "object"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/PanelTrack"
          },
          "title": "Tracks",
          "type": "array"
        },
        "signals": {
          "additionalProperties": {
            "$ref": "#/$defs/PanelPlacement"
          },
          "description": "Var signalerna och de andra namngivna punkterna står: stoppunkter, utfarter och stoppbockar.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Signals",
          "type": "object"
        },
        "track_names": {
          "items": {
            "$ref": "#/$defs/PanelTrackName"
          },
          "title": "Track Names",
          "type": "array"
        },
        "name_offset": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spårnamnet över spåret.",
          "title": "Name Offset"
        },
        "platforms": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Platforms",
          "type": "array"
        },
        "building": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelBuilding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "function_sides": {
          "additionalProperties": {
            "enum": [
              "over",
              "under"
            ],
            "type": "string"
          },
          "description": "Panelfunktionens knapp över eller under spåret.",
          "propertyNames": {
            "maxLength": 500,
            "minLength": 1
          },
          "title": "Function Sides",
          "type": "object"
        },
        "deviation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanelDeviation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "grid",
        "nodes",
        "tracks"
      ],
      "title": "PanelPlan",
      "type": "object"
    },
    "PanelTrack": {
      "additionalProperties": true,
      "description": "A track on the grid: from a node to another, over the cells where it turns.",
      "properties": {
        "start": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Start",
          "type": "string"
        },
        "end": {
          "maxLength": 80,
          "minLength": 1,
          "title": "End",
          "type": "string"
        },
        "pieces": {
          "items": {
            "$ref": "#/$defs/PanelPiece"
          },
          "title": "Pieces",
          "type": "array"
        },
        "via": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Via",
          "type": "array"
        },
        "joints": {
          "description": "Skarvarna mellan spårbitarna, i rutor längs vägen.",
          "items": {
            "type": "number"
          },
          "title": "Joints",
          "type": "array"
        },
        "link": {
          "default": false,
          "description": "Länken mellan två växlar i en korsväxel.",
          "title": "Link",
          "type": "boolean"
        },
        "free": {
          "default": false,
          "description": "Får gå i vilken vinkel som helst.",
          "title": "Free",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "pieces"
      ],
      "title": "PanelTrack",
      "type": "object"
    },
    "PanelTrackName": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "piece": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Piece",
          "type": "string"
        },
        "at": {
          "maximum": 1,
          "minimum": 0,
          "title": "At",
          "type": "number"
        }
      },
      "required": [
        "name",
        "piece",
        "at"
      ],
      "title": "PanelTrackName",
      "type": "object"
    },
    "PanelTurntable": {
      "additionalProperties": true,
      "properties": {
        "node": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Node",
          "type": "string"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "title": "Radius",
          "type": "number"
        }
      },
      "required": [
        "node",
        "radius"
      ],
      "title": "PanelTurntable",
      "type": "object"
    },
    "Position": {
      "description": "A switch's two positions. + is straight (rakt), - is diverging (avvikande).",
      "enum": [
        "+",
        "-"
      ],
      "title": "Position",
      "type": "string"
    },
    "Signal": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SignalType"
        },
        "lamps": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hsi 2, Hsi 3 …",
          "title": "Lamps"
        },
        "node": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Node",
          "type": "string"
        },
        "approach": {
          "description": "Spårbiten tåget kommer på mot signalen. Signalen gäller i den riktningen.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Approach",
          "type": "string"
        },
        "planned": {
          "default": false,
          "description": "Planerad, finns inte än.",
          "title": "Planned",
          "type": "boolean"
        },
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nivå 3."
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "type",
        "node",
        "approach"
      ],
      "title": "Signal",
      "type": "object"
    },
    "SignalType": {
      "description": "The signal catalogue (§2). New types are added here for all stations (STD-19).",
      "enum": [
        "hsi",
        "hdvsi",
        "dvsi",
        "fsi",
        "stop_lamp"
      ],
      "title": "SignalType",
      "type": "string"
    },
    "SlipPart": {
      "additionalProperties": true,
      "description": "One switch number in a slip, with its own position and lever, such as 22a in 22a/23.",
      "properties": {
        "number": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
