{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.resource.schema.json",
  "title": "trainmeet.id-1.resource",
  "$defs": {
    "ResourceKind": {
      "description": "What a role applies to (KONTO-03). ID only holds the reference, never the thing.",
      "enum": [
        "club",
        "fleet",
        "meet",
        "station",
        "module",
        "hub",
        "catalog"
      ],
      "title": "ResourceKind",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "One thing a role applies to: its kind and its id in the app that owns it.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/ResourceKind"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Id",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "type": "object"
}
