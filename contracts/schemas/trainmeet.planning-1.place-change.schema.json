{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.planning-1.place-change.schema.json",
  "title": "trainmeet.planning-1.place-change",
  "additionalProperties": true,
  "description": "A change to one place in the draft. Only the fields sent are changed.",
  "properties": {
    "place": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Place",
      "type": "string"
    },
    "phone": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phone"
    }
  },
  "required": [
    "place"
  ],
  "type": "object"
}
