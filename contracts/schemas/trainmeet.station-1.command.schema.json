{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.station-1.command.schema.json",
  "title": "trainmeet.station-1.command",
  "$defs": {
    "Action": {
      "enum": [
        "train.lookup",
        "train.track.change",
        "train.departed",
        "train.arrived",
        "train.position.set",
        "train.crew_ready.set",
        "train.set_aside",
        "clearance.request",
        "clearance.response",
        "clearance.cancel",
        "line.available.publish",
        "line.available.acknowledge",
        "section.occupancy",
        "signal.exit"
      ],
      "title": "Action",
      "type": "string"
    },
    "MeetContext": {
      "additionalProperties": true,
      "description": "Which meet, version and game day the client saw. A command for another is refused\nwith stale_meet_context, so an old choice never survives a change of meet or day.",
      "properties": {
        "meet_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Meet Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        },
        "epoch": {
          "description": "Ledarskapets epok; byts vid övertag.",
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        }
      },
      "required": [
        "meet_id",
        "version",
        "game_day",
        "epoch"
      ],
      "title": "MeetContext",
      "type": "object"
    },
    "Revision": {
      "additionalProperties": true,
      "properties": {
        "scope": {
          "$ref": "#/$defs/RevisionScope"
        },
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "key",
        "value"
      ],
      "title": "Revision",
      "type": "object"
    },
    "RevisionScope": {
      "description": "Three separate revision spaces, as in v2 §5: never one global counter.",
      "enum": [
        "call",
        "case",
        "place"
      ],
      "title": "RevisionScope",
      "type": "string"
    },
    "TrainLookup": {
      "additionalProperties": true,
      "properties": {
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "^[0-9]{1,5}$",
          "title": "Train Number",
          "type": "string"
        }
      },
      "required": [
        "train_number"
      ],
      "title": "TrainLookup",
      "type": "object"
    },
    "TrackChange": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "track": {
          "description": "Stationens spår-id, eller planens spårnamn utan station.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "call",
        "track"
      ],
      "title": "TrackChange",
      "type": "object"
    },
    "CallOnly": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        }
      },
      "required": [
        "call"
      ],
      "title": "CallOnly",
      "type": "object"
    },
    "Arrival": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Utan spår: första lediga standardspår.",
          "title": "Track"
        }
      },
      "required": [
        "call"
      ],
      "title": "Arrival",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "call",
        "value"
      ],
      "title": "Flag",
      "type": "object"
    },
    "ClearanceRequest": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "clearance_id": {
          "description": "Klienten väljer id, så att omsändning blir dubblett.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        }
      },
      "required": [
        "call",
        "section",
        "clearance_id"
      ],
      "title": "ClearanceRequest",
      "type": "object"
    },
    "ClearanceResponse": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        }
      },
      "required": [
        "clearance_id",
        "approved"
      ],
      "title": "ClearanceResponse",
      "type": "object"
    },
    "ClearanceCancel": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        }
      },
      "required": [
        "clearance_id"
      ],
      "title": "ClearanceCancel",
      "type": "object"
    },
    "LineAvailable": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "call",
        "section"
      ],
      "title": "LineAvailable",
      "type": "object"
    },
    "LineAcknowledge": {
      "additionalProperties": true,
      "properties": {
        "message_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id"
      ],
      "title": "LineAcknowledge",
      "type": "object"
    },
    "SectionOccupancy": {
      "additionalProperties": true,
      "description": "Level 3 only: a section's detection. The section is free when every part is empty.",
      "properties": {
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "occupied": {
          "title": "Occupied",
          "type": "boolean"
        },
        "parts": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$": {
              "type": "boolean"
            }
          },
          "title": "Parts",
          "type": "object"
        }
      },
      "required": [
        "section",
        "occupied"
      ],
      "title": "SectionOccupancy",
      "type": "object"
    },
    "ExitSignalAspect": {
      "enum": [
        "stop",
        "proceed",
        "unknown"
      ],
      "title": "ExitSignalAspect",
      "type": "string"
    },
    "ExitSignal": {
      "additionalProperties": true,
      "description": "What the exit signal shows, for Lokföraren and the neighbour.",
      "properties": {
        "exit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Exit",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "aspect": {
          "$ref": "#/$defs/ExitSignalAspect"
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        }
      },
      "required": [
        "exit",
        "section",
        "aspect"
      ],
      "title": "ExitSignal",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "protocol": {
      "const": "trainmeet.station/1",
      "default": "trainmeet.station/1",
      "title": "Protocol",
      "type": "string"
    },
    "message_id": {
      "description": "Unikt per klient. Samma id ger samma svar.",
      "pattern": "^[A-Za-z0-9._:-]{8,120}$",
      "title": "Message Id",
      "type": "string"
    },
    "client_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Client Id",
      "type": "string"
    },
    "place": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Place",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/MeetContext"
    },
    "action": {
      "$ref": "#/$defs/Action"
    },
    "expected_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Revision"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exakt en scope och nyckel; utelämnas för train.lookup."
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "message_id",
    "client_id",
    "place",
    "context",
    "action"
  ],
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "action": {
          "const": "train.lookup",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/TrainLookup"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "train.track.change",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/TrackChange"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "train.departed",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CallOnly"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "train.arrived",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/Arrival"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "train.position.set",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/Flag"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "train.crew_ready.set",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/Flag"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "train.set_aside",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CallOnly"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "clearance.request",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ClearanceRequest"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "clearance.response",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ClearanceResponse"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "clearance.cancel",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ClearanceCancel"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "line.available.publish",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/LineAvailable"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "line.available.acknowledge",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/LineAcknowledge"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "section.occupancy",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SectionOccupancy"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "signal.exit",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ExitSignal"
        }
      },
      "required": [
        "action",
        "payload"
      ]
    }
  ]
}
