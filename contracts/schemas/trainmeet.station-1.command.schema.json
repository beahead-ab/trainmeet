{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.station-1.command.schema.json",
  "title": "trainmeet.station-1.command",
  "$defs": {
    "Action": {
      "enum": [
        "train.lookup",
        "train.track.change",
        "train.departed",
        "train.arrived",
        "train.position.set",
        "train.crew_ready.set",
        "train.set_aside",
        "clearance.request",
        "clearance.response",
        "clearance.cancel",
        "line.available.publish",
        "line.available.acknowledge",
        "section.occupancy",
        "signal.exit",
        "place.leave",
        "place.take_back",
        "place.offer",
        "place.offer.answer",
        "route.request",
        "route.cancel",
        "route.response",
        "route.state",
        "automat.set",
        "local_release.request",
        "local_release.response",
        "local_release.end",
        "part.answer",
        "ready.move",
        "ready.sent"
      ],
      "title": "Action",
      "type": "string"
    },
    "MeetContext": {
      "additionalProperties": true,
      "description": "Which meet, version and game day the client saw. A command for another is refused\nwith stale_meet_context, so an old choice never survives a change of meet or day.",
      "properties": {
        "meet_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Meet Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        },
        "epoch": {
          "description": "Ledarskapets epok; byts vid övertag.",
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        }
      },
      "required": [
        "meet_id",
        "version",
        "game_day",
        "epoch"
      ],
      "title": "MeetContext",
      "type": "object"
    },
    "Revision": {
      "additionalProperties": true,
      "properties": {
        "scope": {
          "$ref": "#/$defs/RevisionScope"
        },
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "key",
        "value"
      ],
      "title": "Revision",
      "type": "object"
    },
    "RevisionScope": {
      "description": "Three separate revision spaces, as in v2 §5: never one global counter.",
      "enum": [
        "call",
        "case",
        "place"
      ],
      "title": "RevisionScope",
      "type": "string"
    },
    "TrainLookup": {
      "additionalProperties": true,
      "properties": {
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "^[0-9]{1,5}$",
          "title": "Train Number",
          "type": "string"
        }
      },
      "required": [
        "train_number"
      ],
      "title": "TrainLookup",
      "type": "object"
    },
    "TrackChange": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "track": {
          "description": "Stationens spår-id, eller planens spårnamn utan station.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "call",
        "track"
      ],
      "title": "TrackChange",
      "type": "object"
    },
    "CallOnly": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        }
      },
      "required": [
        "call"
      ],
      "title": "CallOnly",
      "type": "object"
    },
    "Arrival": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Utan spår: första lediga standardspår.",
          "title": "Track"
        }
      },
      "required": [
        "call"
      ],
      "title": "Arrival",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "call",
        "value"
      ],
      "title": "Flag",
      "type": "object"
    },
    "ClearanceRequest": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "clearance_id": {
          "description": "Klienten väljer id, så att omsändning blir dubblett.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        }
      },
      "required": [
        "call",
        "section",
        "clearance_id"
      ],
      "title": "ClearanceRequest",
      "type": "object"
    },
    "ClearanceResponse": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        }
      },
      "required": [
        "clearance_id",
        "approved"
      ],
      "title": "ClearanceResponse",
      "type": "object"
    },
    "ClearanceCancel": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        }
      },
      "required": [
        "clearance_id"
      ],
      "title": "ClearanceCancel",
      "type": "object"
    },
    "LineAvailable": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "call",
        "section"
      ],
      "title": "LineAvailable",
      "type": "object"
    },
    "LineAcknowledge": {
      "additionalProperties": true,
      "properties": {
        "message_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id"
      ],
      "title": "LineAcknowledge",
      "type": "object"
    },
    "SectionOccupancy": {
      "additionalProperties": true,
      "description": "Level 3 only: a section's detection. The section is free when every part is empty.\nAccepted from a client that connected at level 3, for a section from its place (DRIFT-10).\nIt stops direct clearance and the automation on the section, and never frees anything by\nitself (DRIFT-16).",
      "properties": {
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "occupied": {
          "title": "Occupied",
          "type": "boolean"
        },
        "parts": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$": {
              "type": "boolean"
            }
          },
          "title": "Parts",
          "type": "object"
        }
      },
      "required": [
        "section",
        "occupied"
      ],
      "title": "SectionOccupancy",
      "type": "object"
    },
    "ExitSignalAspect": {
      "enum": [
        "stop",
        "proceed",
        "unknown"
      ],
      "title": "ExitSignalAspect",
      "type": "string"
    },
    "ExitSignal": {
      "additionalProperties": true,
      "description": "What the exit signal shows, for Lokföraren and the neighbour.",
      "properties": {
        "exit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Exit",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "aspect": {
          "$ref": "#/$defs/ExitSignalAspect"
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        }
      },
      "required": [
        "exit",
        "section",
        "aspect"
      ],
      "title": "ExitSignal",
      "type": "object"
    },
    "PlaceOnly": {
      "additionalProperties": true,
      "description": "Lämna or ta tillbaka: the command's own place, nothing more.",
      "properties": {},
      "title": "PlaceOnly",
      "type": "object"
    },
    "PlaceOffer": {
      "additionalProperties": true,
      "description": "place.offer: the station's own TKL hands the station to someone in Snapshot.remote's\nreceivers (FR8). The offer stands for a minute (TKL125).",
      "properties": {
        "to": {
          "description": "Den som erbjuds: klientens id ur receivers.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "to"
      ],
      "title": "PlaceOffer",
      "type": "object"
    },
    "OfferAnswer": {
      "additionalProperties": true,
      "description": "place.offer.answer: the one offered takes the station, which becomes Fjärrstyrd, or\ndeclines it. With the station's place as the command's place.",
      "properties": {
        "accept": {
          "title": "Accept",
          "type": "boolean"
        }
      },
      "required": [
        "accept"
      ],
      "title": "OfferAnswer",
      "type": "object"
    },
    "RouteRequest": {
      "additionalProperties": true,
      "description": "route.request: whoever controls the station asks for a route from its catalogue (FR11).\nThe id is the client's, so that a resend is a duplicate, as for clearance.",
      "properties": {
        "request_id": {
          "description": "Klienten väljer id.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Request Id",
          "type": "string"
        },
        "route": {
          "description": "Tågvägens id i fjärrkatalogen (remote_routes).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Route",
          "type": "string"
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tåget, när det finns ett.",
          "title": "Call"
        }
      },
      "required": [
        "request_id",
        "route"
      ],
      "title": "RouteRequest",
      "type": "object"
    },
    "RouteCancel": {
      "additionalProperties": true,
      "description": "route.cancel: a route asked for or locked is taken away. The station's interlocking\ndecides when it is released, as on the spot.",
      "properties": {
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "RouteCancel",
      "type": "object"
    },
    "Reason": {
      "enum": [
        "unsupported_protocol",
        "unknown_action",
        "not_approved",
        "wrong_place",
        "stale_meet_context",
        "stale_revision",
        "no_active_meet",
        "train_number_required",
        "unknown_train_number",
        "ambiguous_train_number",
        "unknown_call",
        "unknown_track",
        "track_occupied",
        "unknown_section",
        "channel_occupied",
        "call_already_requested",
        "clearance_not_pending",
        "unknown_clearance",
        "not_sender",
        "not_receiver",
        "train_already_departed",
        "departure_not_reserved",
        "invalid_departure",
        "invalid_arrival",
        "train_not_departed",
        "unknown_line_message",
        "already_acknowledged",
        "not_level_3",
        "station_automatic",
        "automatic_station_manned",
        "automation_off",
        "client_not_present",
        "no_jump_to_undo",
        "other_game_day",
        "day_still_running",
        "unknown_place",
        "unknown_train",
        "no_route",
        "invalid_time",
        "train_number_taken",
        "unknown_change",
        "section_closed",
        "unknown_version",
        "same_version",
        "no_switch_waiting",
        "drift_locked",
        "not_locked",
        "not_leader",
        "already_leader",
        "unknown_service",
        "service_taken",
        "one_service",
        "no_service",
        "unknown_driver",
        "not_in_service",
        "unknown_paper",
        "paper_decided",
        "paper_no_places",
        "paper_few_places",
        "paper_no_times",
        "paper_no_number",
        "not_controller",
        "not_in_catalog",
        "route_already_requested",
        "route_not_pending",
        "offer_not_pending",
        "offer_pending",
        "station_not_answering",
        "place_remote",
        "no_catalog",
        "not_station",
        "unknown_receiver",
        "no_contact",
        "conflicting_route",
        "switch_not_in_control",
        "area_released",
        "route_refused",
        "unknown_automat",
        "local_area_not_given",
        "part_request_not_pending",
        "not_ready_to_send"
      ],
      "title": "Reason",
      "type": "string"
    },
    "RouteResponse": {
      "additionalProperties": true,
      "description": "route.response: the station's interlocking has locked the route, or says no with a reason\nof its own: conflicting_route, switch_not_in_control, area_released or track_occupied, else\nroute_refused with its own words (#36 del b).",
      "properties": {
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Request Id",
          "type": "string"
        },
        "locked": {
          "title": "Locked",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ställverkets egna ord om nejet, som stationen säger det.",
          "title": "Message"
        }
      },
      "required": [
        "request_id",
        "locked"
      ],
      "title": "RouteResponse",
      "type": "object"
    },
    "AutomatOn": {
      "additionalProperties": true,
      "description": "A station automat that is switched on, and who switched it on (FR25, FR29).",
      "properties": {
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/RouteBy"
        }
      },
      "required": [
        "code",
        "by"
      ],
      "title": "AutomatOn",
      "type": "object"
    },
    "LocalArea": {
      "additionalProperties": true,
      "description": "A local area given to people on the spot (lokal frigivning, TKL44, TKL48, FR39).",
      "properties": {
        "code": {
          "description": "Lokalfrigivningens kod, till exempel L01.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "tracks": {
          "description": "Stationsspåren i området, för fjärrbilden.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "code"
      ],
      "title": "LocalArea",
      "type": "object"
    },
    "LockedRoute": {
      "additionalProperties": true,
      "description": "A catalogue route the station's interlocking holds locked. It stays until the train has\ngone, also when the station is taken back (FR15).",
      "properties": {
        "route": {
          "description": "Tågvägens id i fjärrkatalogen.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Route",
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/RouteBy"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Begäran den svarade på.",
          "title": "Request Id"
        },
        "automat": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Automaten som lade den.",
          "title": "Automat"
        }
      },
      "required": [
        "route",
        "by"
      ],
      "title": "LockedRoute",
      "type": "object"
    },
    "PartRequest": {
      "additionalProperties": true,
      "description": "DRIFT-40, FR50: a part's request (begär väg) that the controller answers instead of the\nclearer, when a station with parts is remote-controlled. The station forwards it, waiting,\nuntil it is answered with part.answer (#36 del d).",
      "properties": {
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Request Id",
          "type": "string"
        },
        "part": {
          "description": "Delens id i stationen, som i utsidan när delen är en egen plats.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Part",
          "type": "string"
        },
        "text": {
          "description": "Vad delen begär, som stationen skriver det.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "part_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Delens namn, som rutan säger det.",
          "title": "Part Name"
        },
        "said": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vägen som rutan säger den, till exempel 52 → 3.",
          "title": "Said"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Varför ett godkännande inte gick att göra än, i ställverkets egna ord: begäran väntar, och den som fjärrstyr kan neka den eller godkänna den igen.",
          "title": "Note"
        }
      },
      "required": [
        "request_id",
        "part",
        "text"
      ],
      "title": "PartRequest",
      "type": "object"
    },
    "ReadyToSend": {
      "additionalProperties": true,
      "description": "FR51: a train ready to send, as the clearer's list shows it, in the plan's order: before\nthe first with a later planned departure, and where the controller or the clearer moved it.",
      "properties": {
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        },
        "part": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "part_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Delen som anmälde tåget.",
          "title": "Part Name"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spåret tåget står på.",
          "title": "Track"
        },
        "moved": {
          "default": false,
          "description": "Flyttat i listan, inte i planens ordning.",
          "title": "Moved",
          "type": "boolean"
        }
      },
      "required": [
        "train_number"
      ],
      "title": "ReadyToSend",
      "type": "object"
    },
    "RouteBy": {
      "description": "Who laid a route, or switched an automat (FR33, FR37).",
      "enum": [
        "remote",
        "station",
        "automat"
      ],
      "title": "RouteBy",
      "type": "string"
    },
    "RouteState": {
      "additionalProperties": true,
      "description": "route.state: the station at the overview level, whole each time it changes (FR13). The\ncatalogue routes it holds locked and who locked them, those the station or an automat laid\ntoo; the automats that are on; the local areas; and at level 3 the occupied tracks. The parts'\nrequests and the ready list travel here when a station with parts is remote-controlled\n(DRIFT-40).",
      "properties": {
        "locked": {
          "items": {
            "$ref": "#/$defs/LockedRoute"
          },
          "title": "Locked",
          "type": "array"
        },
        "automats": {
          "items": {
            "$ref": "#/$defs/AutomatOn"
          },
          "title": "Automats",
          "type": "array"
        },
        "local_areas": {
          "items": {
            "$ref": "#/$defs/LocalArea"
          },
          "title": "Local Areas",
          "type": "array"
        },
        "occupied": {
          "description": "Belagda stationsspår enligt detekteringen, bara från en station på nivå 3.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Occupied",
          "type": "array"
        },
        "part_requests": {
          "description": "Delarnas begäran, när stationen fjärrstyrs (FR50).",
          "items": {
            "$ref": "#/$defs/PartRequest"
          },
          "title": "Part Requests",
          "type": "array"
        },
        "ready_to_send": {
          "description": "Tåg som är klara att skicka, i avgångstidens ordning (FR51).",
          "items": {
            "$ref": "#/$defs/ReadyToSend"
          },
          "title": "Ready To Send",
          "type": "array"
        },
        "answered": {
          "description": "Svaren från den som fjärrstyr som stationen har gjort, med Hubbens nummer ur RemoteHere, så länge Hubben har dem kvar (#36 del d).",
          "items": {
            "type": "integer"
          },
          "title": "Answered",
          "type": "array"
        }
      },
      "title": "RouteState",
      "type": "object"
    },
    "AutomatSetAsk": {
      "additionalProperties": true,
      "description": "automat.set: whoever remote-controls the station switches one of its automats on or off,\nfrom the remote picture (FR25). It goes to the station's TKL, which switches it in its own\ninterlocking and says so in route.state. A local release automat's code gives or takes back\nthe local area, as local_release.response and .end do. On the spot, when the station is\nmanned, the station's own panel switches them; nothing goes through Hubben then.",
      "properties": {
        "code": {
          "description": "Automatens kod i utsidan, till exempel A3.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "on": {
          "title": "On",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "on"
      ],
      "title": "AutomatSetAsk",
      "type": "object"
    },
    "LocalReleaseRequest": {
      "additionalProperties": true,
      "description": "local_release.request: the people on a remote-controlled station ask whoever controls it\nfor a local area, with the local release's code, a while or all day (FR20, FR39).",
      "properties": {
        "code": {
          "description": "Lokalfrigivningens kod, till exempel L01.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "all_day": {
          "default": false,
          "description": "Hela dagen; annars en stund.",
          "title": "All Day",
          "type": "boolean"
        }
      },
      "required": [
        "code"
      ],
      "title": "LocalReleaseRequest",
      "type": "object"
    },
    "LocalReleaseResponse": {
      "additionalProperties": true,
      "description": "local_release.response: whoever controls the station gives the local area, or refuses\nit. Given, the station switches it in when no route goes to, from or through it (FR42).",
      "properties": {
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "give": {
          "title": "Give",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "give"
      ],
      "title": "LocalReleaseResponse",
      "type": "object"
    },
    "LocalReleaseEnd": {
      "additionalProperties": true,
      "description": "local_release.end: the station gives the area back, or whoever controls it takes it back\nafter a question; the station switches it out when the area is empty (FR23, FR44).",
      "properties": {
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "LocalReleaseEnd",
      "type": "object"
    },
    "PartAnswer": {
      "additionalProperties": true,
      "description": "part.answer (FR50, TKL100): whoever controls the station approves or refuses a part's\nrequest from route.state's part_requests, as the clearer's Godkänn or Neka in the box. Hubben\nchecks who answers and that the request is waiting, and keeps the answer in RemoteHere; the\nstation's own interlocking does it, as for the clearer, and says so in route.state.",
      "properties": {
        "part": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Part",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Request Id",
          "type": "string"
        },
        "approve": {
          "title": "Approve",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Varför, vid ett nej; delen läser det.",
          "title": "Reason"
        }
      },
      "required": [
        "part",
        "request_id",
        "approve"
      ],
      "title": "PartAnswer",
      "type": "object"
    },
    "ReadyMove": {
      "additionalProperties": true,
      "description": "ready.move (FR51): whoever controls the station moves a train in the list Klara att\nskicka, to its new place counted from 0, as the clearer does.",
      "properties": {
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "to": {
          "minimum": 0,
          "title": "To",
          "type": "integer"
        }
      },
      "required": [
        "train_number",
        "to"
      ],
      "title": "ReadyMove",
      "type": "object"
    },
    "ReadySent": {
      "additionalProperties": true,
      "description": "ready.sent (FR51): Skickat, and the train leaves the list Klara att skicka.",
      "properties": {
        "train_number": {
          "maxLength": 500,
