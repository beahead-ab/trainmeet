{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.station-1.snapshot.schema.json",
  "title": "trainmeet.station-1.snapshot",
  "$defs": {
    "Action": {
      "enum": [
        "train.lookup",
        "train.track.change",
        "train.departed",
        "train.arrived",
        "train.position.set",
        "train.crew_ready.set",
        "train.set_aside",
        "clearance.request",
        "clearance.response",
        "clearance.cancel",
        "line.available.publish",
        "line.available.acknowledge",
        "section.occupancy",
        "signal.exit",
        "place.leave",
        "place.take_back",
        "place.offer",
        "place.offer.answer",
        "route.request",
        "route.cancel",
        "route.response",
        "route.state",
        "automat.set",
        "local_release.request",
        "local_release.response",
        "local_release.end"
      ],
      "title": "Action",
      "type": "string"
    },
    "ArrivalState": {
      "enum": [
        "none",
        "on_the_way",
        "arrived"
      ],
      "title": "ArrivalState",
      "type": "string"
    },
    "AutomatAsked": {
      "additionalProperties": true,
      "description": "What whoever controls the station has decided for one of its automats or local areas,\nwith automat.set or local_release.response and .end, until the station's route.state shows\nit (#36 del b). The station's TKL switches it when its interlocking allows (FR23, FR42).",
      "properties": {
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "on": {
          "title": "On",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "on"
      ],
      "title": "AutomatAsked",
      "type": "object"
    },
    "AutomatOn": {
      "additionalProperties": true,
      "description": "A station automat that is switched on, and who switched it on (FR25, FR29).",
      "properties": {
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/RouteBy"
        }
      },
      "required": [
        "code",
        "by"
      ],
      "title": "AutomatOn",
      "type": "object"
    },
    "CallHere": {
      "additionalProperties": true,
      "description": "A call at this place, with what the client may do with it right now.",
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "train_label": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Till exempel IC 116 (F9).",
          "title": "Train Label"
        },
        "train_type": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Type"
        },
        "manual": {
          "default": false,
          "title": "Manual",
          "type": "boolean"
        },
        "arrival": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "day_offset": {
          "default": 0,
          "title": "Day Offset",
          "type": "integer"
        },
        "planned_track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Track"
        },
        "track": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Var tåget står eller ska stå nu.",
          "title": "Track"
        },
        "from_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Place"
        },
        "to_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Place"
        },
        "arrival_state": {
          "$ref": "#/$defs/ArrivalState",
          "default": "none"
        },
        "departure_state": {
          "$ref": "#/$defs/DepartureState",
          "default": "planned"
        },
        "positioned": {
          "default": false,
          "title": "Positioned",
          "type": "boolean"
        },
        "crew_ready": {
          "default": false,
          "title": "Crew Ready",
          "type": "boolean"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "allowed_actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "paper": {
          "default": false,
          "description": "Efter pappret: tåget finns inte i planen, och trafikledningen har godkänt det (LOK-13).",
          "title": "Paper",
          "type": "boolean"
        }
      },
      "required": [
        "call",
        "train",
        "train_number",
        "revision"
      ],
      "title": "CallHere",
      "type": "object"
    },
    "Clearance": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        },
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "from_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "From Place",
          "type": "string"
        },
        "to_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To Place",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClearanceStatus"
        },
        "departed": {
          "default": false,
          "title": "Departed",
          "type": "boolean"
        },
        "requested_at": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Requested At",
          "type": "string"
        },
        "reminders": {
          "default": 0,
          "description": "Påminnelser hittills (H39).",
          "minimum": 0,
          "title": "Reminders",
          "type": "integer"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "paper": {
          "default": false,
          "description": "Efter pappret: tåget finns inte i planen, och trafikledningen har godkänt det (LOK-13).",
          "title": "Paper",
          "type": "boolean"
        }
      },
      "required": [
        "clearance_id",
        "call",
        "train_number",
        "section",
        "from_place",
        "to_place",
        "status",
        "requested_at",
        "revision"
      ],
      "title": "Clearance",
      "type": "object"
    },
    "ClearanceMode": {
      "description": "Klareringsläge. Requested: the receiving place answers. Direct: Drift answers at once\nif the section is free. The meet has one; a section may have the other (decided 1 Nov).",
      "enum": [
        "requested",
        "direct"
      ],
      "title": "ClearanceMode",
      "type": "string"
    },
    "ClearanceStatus": {
      "enum": [
        "waiting",
        "approved",
        "rejected",
        "cancelled",
        "invalidated"
      ],
      "title": "ClearanceStatus",
      "type": "string"
    },
    "ClientKind": {
      "enum": [
        "tkl",
        "tmbox_app",
        "dispatch",
        "remote"
      ],
      "title": "ClientKind",
      "type": "string"
    },
    "Clock": {
      "additionalProperties": true,
      "properties": {
        "time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "seconds": {
          "description": "Sekunder sedan speldygnets midnatt; kan gå över 24 h.",
          "minimum": 0,
          "title": "Seconds",
          "type": "integer"
        },
        "running": {
          "description": "Falskt betyder stoppad klocka, inte tappad kontakt.",
          "title": "Running",
          "type": "boolean"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        }
      },
      "required": [
        "time",
        "seconds",
        "running",
        "speed",
        "game_day"
      ],
      "title": "Clock",
      "type": "object"
    },
    "DepartureState": {
      "enum": [
        "planned",
        "requested",
        "cleared",
        "departed"
      ],
      "title": "DepartureState",
      "type": "string"
    },
    "DriverMessageHere": {
      "additionalProperties": true,
      "description": "Ett meddelande från föraren på ett tåg som är här, på väg hit eller har lämnat (KLAR-27,\nDRIFT-38). Bara till TKL, inte till TMBox. Utan förarens namn.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/DriverMessageKind"
        },
        "train": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train"
        },
        "train_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Number"
        },
        "model_time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Model Time",
          "type": "string"
        },
        "seq": {
          "description": "Drifthändelsen meddelandet är.",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "model_time",
        "seq"
      ],
      "title": "DriverMessageHere",
      "type": "object"
    },
    "DriverMessageKind": {
      "description": "Förarens färdiga meddelanden till trafikledningen (LOK-23, DRIFT-38).",
      "enum": [
        "delayed",
        "stopped_on_line",
        "needs_help",
        "engine_trouble"
      ],
      "title": "DriverMessageKind",
      "type": "string"
    },
    "ExitChoice": {
      "additionalProperties": true,
      "properties": {
        "exit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Exit",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "exit",
        "side"
      ],
      "title": "ExitChoice",
      "type": "object"
    },
    "ExitQuestion": {
      "additionalProperties": true,
      "description": "Hubben är osäker på vilken av stationens utfarter en sträcka har (H26, PLAN-31). Den\ngissar på grannens namn, sidan och förra träffens svar, och frågar annars. Stationen i TKL\neller trafikledningen i Klienter svarar, och det första svaret gäller (TRAFIK-05).",
      "properties": {
        "station_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Station Id",
          "type": "string"
        },
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "other_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Other Place",
          "type": "string"
        },
        "other_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Other Name",
          "type": "string"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sträckans sida vid driftplatsen."
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/ExitChoice"
          },
          "minItems": 1,
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "station_id",
        "place",
        "section",
        "other_place",
        "other_name",
        "alternatives"
      ],
      "title": "ExitQuestion",
      "type": "object"
    },
    "LineMessage": {
      "additionalProperties": true,
      "properties": {
        "message_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Message Id",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "from_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "From Place",
          "type": "string"
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        },
        "acknowledged": {
          "default": false,
          "title": "Acknowledged",
          "type": "boolean"
        }
      },
      "required": [
        "message_id",
        "section",
        "from_place"
      ],
      "title": "LineMessage",
      "type": "object"
    },
    "LocalArea": {
      "additionalProperties": true,
      "description": "A local area given to people on the spot (lokal frigivning, TKL44, TKL48, FR39).",
      "properties": {
        "code": {
          "description": "Lokalfrigivningens kod, till exempel L01.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "tracks": {
          "description": "Stationsspåren i området, för fjärrbilden.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "code"
      ],
      "title": "LocalArea",
      "type": "object"
    },
    "LocalRequestHere": {
      "additionalProperties": true,
      "description": "A local area the people on the station have asked for and not yet been answered (FR20).",
      "properties": {
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "all_day": {
          "default": false,
          "title": "All Day",
          "type": "boolean"
        },
        "asked_at": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Asked At",
          "type": "string"
        }
      },
      "required": [
        "code",
        "asked_at"
      ],
      "title": "LocalRequestHere",
      "type": "object"
    },
    "LockedRoute": {
      "additionalProperties": true,
      "description": "A catalogue route the station's interlocking holds locked. It stays until the train has\ngone, also when the station is taken back (FR15).",
      "properties": {
        "route": {
          "description": "Tågvägens id i fjärrkatalogen.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Route",
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/RouteBy"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Begäran den svarade på.",
          "title": "Request Id"
        },
        "automat": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Automaten som lade den.",
          "title": "Automat"
        }
      },
      "required": [
        "route",
        "by"
      ],
      "title": "LockedRoute",
      "type": "object"
    },
    "MeetContext": {
      "additionalProperties": true,
      "description": "Which meet, version and game day the client saw. A command for another is refused\nwith stale_meet_context, so an old choice never survives a change of meet or day.",
      "properties": {
        "meet_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Meet Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        },
        "epoch": {
          "description": "Ledarskapets epok; byts vid övertag.",
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        }
      },
      "required": [
        "meet_id",
        "version",
        "game_day",
        "epoch"
      ],
      "title": "MeetContext",
      "type": "object"
    },
    "Neighbour": {
      "additionalProperties": true,
      "description": "A place and its game number, for the telephone list in TKL and the app (H24).",
      "properties": {
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        }
      },
      "required": [
        "place",
        "code",
        "name"
      ],
      "title": "Neighbour",
      "type": "object"
    },
    "OfferHere": {
      "additionalProperties": true,
      "description": "An offer that stands: the station, who it is offered to, and how long it stands.",
      "properties": {
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "to": {
          "$ref": "#/$defs/Receiver"
        },
        "expires_in": {
          "description": "Sekunder kvar av minuten (FR8).",
          "minimum": 0,
          "title": "Expires In",
          "type": "integer"
        }
      },
      "required": [
        "place",
        "to",
        "expires_in"
      ],
      "title": "OfferHere",
      "type": "object"
    },
    "PartRequest": {
      "additionalProperties": true,
      "description": "DRIFT-40, FR50: a part's request (begär väg) that the controller answers instead of the\nclearer, when a station with parts is remote-controlled. The station forwards it.",
      "properties": {
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Request Id",
          "type": "string"
        },
        "part": {
          "description": "Delens id i utsidan.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Part",
          "type": "string"
        },
        "text": {
          "description": "Vad delen begär, som stationen skriver det.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "part",
        "text"
      ],
      "title": "PartRequest",
      "type": "object"
    },
