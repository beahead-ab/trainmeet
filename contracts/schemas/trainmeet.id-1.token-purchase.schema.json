{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.token-purchase.schema.json",
  "title": "trainmeet.id-1.token-purchase",
  "$defs": {
    "TokenOwner": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "$ref": "#/$defs/TokenOwnerKind"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "TokenOwner",
      "type": "object"
    },
    "TokenOwnerKind": {
      "description": "Vems saldo (TK1): personens, för egna fordon och moduler, eller klubbens, för\nträffarnas import (TK16).",
      "enum": [
        "person",
        "club"
      ],
      "title": "TokenOwnerKind",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Köp ett paket till sitt eget saldo, eller till klubbens som dess administratör.",
  "properties": {
    "owner": {
      "$ref": "#/$defs/TokenOwner"
    },
    "tokens": {
      "enum": [
        500,
        1500,
        5000
      ],
      "title": "Tokens",
      "type": "integer"
    }
  },
  "required": [
    "owner",
    "tokens"
  ],
  "type": "object"
}
