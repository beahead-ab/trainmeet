{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.catalog-1.prototype-list.schema.json",
  "title": "trainmeet.catalog-1.prototype-list",
  "$defs": {
    "FieldEvidence": {
      "additionalProperties": true,
      "description": "Belägget för ett fält (CAT-169): the source the web search found the value in, with its\naddress and an excerpt of it. The source was in the real search result (CAT-167), and the\nexcerpt held the value when it was searched.",
      "properties": {
        "value": {
          "description": "The value the excerpt was found to support.",
          "maxLength": 1000,
          "title": "Value",
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "$ref": "#/$defs/PublisherKind"
        },
        "excerpt": {
          "description": "Utdraget ur källan, as the search gave it.",
          "maxLength": 2000,
          "title": "Excerpt",
          "type": "string"
        },
        "searched_at": {
          "format": "date-time",
          "title": "Searched At",
          "type": "string"
        },
        "agrees": {
          "description": "Stämmer belägget fortfarande med värdet som står där (CAT-170)? False when the value was changed after the search, so that the excerpt no longer holds it.",
          "title": "Agrees",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "url",
        "publisher",
        "excerpt",
        "searched_at",
        "agrees"
      ],
      "title": "FieldEvidence",
      "type": "object"
    },
    "FieldProfile": {
      "description": "The field profiles from the start (CAT-158, C31).",
      "enum": [
        "SE",
        "EU",
        "US"
      ],
      "title": "FieldProfile",
      "type": "string"
    },
    "Prototype": {
      "additionalProperties": true,
      "description": "A type in the catalog: one row in the list (CAT-173), and the prototype's page.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PrototypeStatus",
          "description": "Reviewed once a revision is; until then the first proposal's status."
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The reviewed revision shown, the latest one; null before.",
          "title": "Revision"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/VehicleKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile": {
          "$ref": "#/$defs/FieldProfile"
        },
        "fields": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "maxLength": 1000,
              "type": "string"
            }
          },
          "title": "Fields",
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/PrototypeSource"
        },
        "evidence": {
          "description": "Belägget per fält for the revision shown (CAT-169, CAT-170).",
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "items": {
                "$ref": "#/$defs/FieldEvidence"
              },
              "type": "array"
            }
          },
          "title": "Evidence",
          "type": "object"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "vehicles": {
          "description": "Används: how many vehicles in Catalog are linked to it.",
          "title": "Vehicles",
          "type": "integer"
        },
        "waiting": {
          "default": 0,
          "description": "Proposals for it waiting in the review queue that one may see.",
          "title": "Waiting",
          "type": "integer"
        },
        "revisions": {
          "description": "Only on the prototype's page: the reviewed revisions, newest first, and the ones the person may see besides.",
          "items": {
            "$ref": "#/$defs/PrototypeRevision"
          },
          "title": "Revisions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "status",
        "name",
        "profile",
        "fields",
        "source",
        "vehicles"
      ],
      "title": "Prototype",
      "type": "object"
    },
    "PrototypeRevision": {
      "additionalProperties": true,
      "description": "One revision of a prototype: a proposal, reviewed or rejected (CAT-159).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "prototype": {
          "format": "uuid",
          "title": "Prototype",
          "type": "string"
        },
        "number": {
          "description": "Counts every proposal for the prototype, from 1.",
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "base": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The reviewed revision a change was built on; null if new.",
          "title": "Base"
        },
        "status": {
          "$ref": "#/$defs/PrototypeStatus"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/VehicleKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile": {
          "$ref": "#/$defs/FieldProfile"
        },
        "fields": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "maxLength": 1000,
              "type": "string"
            }
          },
          "title": "Fields",
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/PrototypeSource"
        },
        "mine": {
          "default": false,
          "description": "The person asking proposed it.",
          "title": "Mine",
          "type": "boolean"
        },
        "proposed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The proposer's name: only in the review queue, and in one's own proposals.",
          "title": "Proposed By"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "comment": {
          "default": "",
          "description": "The reviewer's comment.",
          "title": "Comment",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "evidence": {
          "description": "Belägget per fält, from the web search (CAT-169). A change of a prototype keeps the evidence of the fields it keeps; agrees says whether each still holds the value that stands there (CAT-170).",
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "items": {
                "$ref": "#/$defs/FieldEvidence"
              },
              "type": "array"
            }
          },
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "id",
        "prototype",
        "number",
        "status",
        "name",
        "profile",
        "fields",
        "source",
        "created_at"
      ],
      "title": "PrototypeRevision",
      "type": "object"
    },
    "PrototypeSource": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "$ref": "#/$defs/PrototypeSourceKind"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "PrototypeSource",
      "type": "object"
    },
    "PrototypeSourceKind": {
      "description": "Where the type data come from (CAT-163).",
      "enum": [
        "own",
        "reference",
        "web_search"
      ],
      "title": "PrototypeSourceKind",
      "type": "string"
    },
    "PrototypeStatus": {
      "description": "A prototype's or a revision's place in the review (CAT-164).",
      "enum": [
        "proposed",
        "reviewed",
        "rejected"
      ],
      "title": "PrototypeStatus",
      "type": "string"
    },
    "PublisherKind": {
      "description": "Who published a source, classed against Catalog's small, reviewed list of publishers\n(CAT-168): exact hosts only. The class says who stands behind the page, never that a fact\nis right.",
      "enum": [
        "manufacturer",
        "operator",
        "museum",
        "archive",
        "unknown"
      ],
      "title": "PublisherKind",
      "type": "string"
    },
    "VehicleKind": {
      "description": "The kinds of vehicle (CAT-54).",
      "enum": [
        "locomotive",
        "freight_wagon",
        "passenger_coach",
        "multiple_unit",
        "other"
      ],
      "title": "VehicleKind",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "The catalog (CAT-173): one type per row with its type data. The reviewed prototypes, and\nthe person's own proposals for new ones.",
  "properties": {
    "prototypes": {
      "items": {
        "$ref": "#/$defs/Prototype"
      },
      "title": "Prototypes",
      "type": "array"
    },
    "reviewer": {
      "description": "The person is a reviewer and sees the review queue.",
      "title": "Reviewer",
      "type": "boolean"
    },
    "to_review": {
      "default": 0,
      "description": "Proposals in the queue, for a reviewer.",
      "title": "To Review",
      "type": "integer"
    },
    "license": {
      "default": "CC BY-SA 4.0",
      "description": "CC BY-SA 4.0 (CAT-213).",
      "title": "License",
      "type": "string"
    },
    "license_url": {
      "default": "https://creativecommons.org/licenses/by-sa/4.0/",
      "title": "License Url",
      "type": "string"
    }
  },
  "required": [
    "prototypes",
    "reviewer"
  ],
  "type": "object"
}
