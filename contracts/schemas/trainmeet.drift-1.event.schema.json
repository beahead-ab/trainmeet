{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.drift-1.event.schema.json",
  "title": "trainmeet.drift-1.event",
  "$defs": {
    "Actor": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "client",
        "dispatcher",
        "automation",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "EventKind": {
      "enum": [
        "meet.started",
        "clock.started",
        "clock.stopped",
        "clock.speed",
        "clock.jump",
        "clock.jump_undone",
        "day.changed",
        "client.approved",
        "client.revoked",
        "client.assigned",
        "clearance.requested",
        "clearance.answered",
        "clearance.cancelled",
        "clearance.reminded",
        "clearance.invalidated",
        "train.departed",
        "train.arrived",
        "train.moved_here",
        "train.track_changed",
        "train.set_aside",
        "train.positioned",
        "train.crew_ready",
        "line.available",
        "line.acknowledged",
        "section.occupancy",
        "signal.exit",
        "place.manned",
        "place.left",
        "place.taken_back",
        "automation.set"
      ],
      "title": "EventKind",
      "type": "string"
    },
    "Weekday": {
      "description": "The timetable's weekday (trafikdag). Not the same as the game day (Dag 1…N).",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "title": "Weekday",
      "type": "string"
    },
    "MeetStarted": {
      "additionalProperties": true,
      "properties": {
        "traffic_day": {
          "$ref": "#/$defs/Weekday"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Speed",
          "type": "number"
        },
        "game_day": {
          "default": 1,
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        }
      },
      "required": [
        "traffic_day",
        "speed"
      ],
      "title": "MeetStarted",
      "type": "object"
    },
    "ClockChanged": {
      "additionalProperties": true,
      "properties": {
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "seconds",
        "speed"
      ],
      "title": "ClockChanged",
      "type": "object"
    },
    "ClearanceRequested": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "to_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To Place",
          "type": "string"
        }
      },
      "required": [
        "clearance_id",
        "section",
        "to_place"
      ],
      "title": "ClearanceRequested",
      "type": "object"
    },
    "ClearanceAnswered": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        }
      },
      "required": [
        "clearance_id",
        "approved"
      ],
      "title": "ClearanceAnswered",
      "type": "object"
    },
    "ClearanceRef": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        }
      },
      "required": [
        "clearance_id"
      ],
      "title": "ClearanceRef",
      "type": "object"
    },
    "TrainArrived": {
      "additionalProperties": true,
      "description": "The train is in. Without a track it came in on the planned one (old Server 4.9.0).",
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spåret tåget kom in på.",
          "title": "Track"
        }
      },
      "required": [
        "clearance_id"
      ],
      "title": "TrainArrived",
      "type": "object"
    },
    "TrainMovedHere": {
      "additionalProperties": true,
      "description": "FLYTTA HIT: a train nobody sent is placed here, so the game goes on (issue #115).",
      "properties": {
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        }
      },
      "title": "TrainMovedHere",
      "type": "object"
    },
    "TrainSetAside": {
      "additionalProperties": true,
      "description": "Ställ undan: a train that ended here is put away, and its track is free.",
      "properties": {},
      "title": "TrainSetAside",
      "type": "object"
    },
    "TrackChanged": {
      "additionalProperties": true,
      "description": "The call's track now. A train standing there moves with it.",
      "properties": {
        "track": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "track"
      ],
      "title": "TrackChanged",
      "type": "object"
    },
    "FlagSet": {
      "additionalProperties": true,
      "description": "Uppställt or föraren på plats, set or taken back. REDO is both, never set itself.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "title": "FlagSet",
      "type": "object"
    },
    "LineAvailableSent": {
      "additionalProperties": true,
      "description": "Ledig linje: a message to the other end, never a request (old Server v2).",
      "properties": {
        "message_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Message Id",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "to_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To Place",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "section",
        "to_place"
      ],
      "title": "LineAvailableSent",
      "type": "object"
    },
    "LineAcknowledged": {
      "additionalProperties": true,
      "properties": {
        "message_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id"
      ],
      "title": "LineAcknowledged",
      "type": "object"
    },
    "PlaceManned": {
      "additionalProperties": true,
      "description": "The first box or TKL that works a place mans it (F14).",
      "properties": {
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Client Id",
          "type": "string"
        }
      },
      "required": [
        "client_id"
      ],
      "title": "PlaceManned",
      "type": "object"
    },
    "LeftBy": {
      "enum": [
        "dispatcher",
        "operator",
        "lost_contact"
      ],
      "title": "LeftBy",
      "type": "string"
    },
    "PlaceLeft": {
      "additionalProperties": true,
      "description": "Lämnad till automatiken, until someone takes it back, also over a new day.",
      "properties": {
        "by": {
          "$ref": "#/$defs/LeftBy"
        },
        "client_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        }
      },
      "required": [
        "by"
      ],
      "title": "PlaceLeft",
      "type": "object"
    },
    "PlaceTakenBack": {
      "additionalProperties": true,
      "properties": {
        "by": {
          "enum": [
            "dispatcher",
            "operator"
          ],
          "title": "By",
          "type": "string"
        },
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Client Id",
          "type": "string"
        }
      },
      "required": [
        "by",
        "client_id"
      ],
      "title": "PlaceTakenBack",
      "type": "object"
    },
    "Disturbance": {
      "enum": [
        "off",
        "normal",
        "disrupted"
      ],
      "title": "Disturbance",
      "type": "string"
    },
    "DisturbanceWhere": {
      "enum": [
        "both",
        "station",
        "line"
      ],
      "title": "DisturbanceWhere",
      "type": "string"
    },
    "AutomationSettings": {
      "additionalProperties": true,
      "description": "Trafikledningens val för automatiken, med gamla Servers förval (H42).",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Av: automatiken rör ingenting.",
          "title": "Enabled",
          "type": "boolean"
        },
        "lost_contact_minutes": {
          "default": 0,
          "description": "Övertag efter Kontakt saknas; 0 är aldrig.",
          "enum": [
            0,
            2,
            5,
            10
          ],
          "title": "Lost Contact Minutes",
          "type": "integer"
        },
        "disturbance": {
          "$ref": "#/$defs/Disturbance",
          "default": "off"
        },
        "where": {
          "$ref": "#/$defs/DisturbanceWhere",
          "default": "both"
        },
        "seed": {
          "default": "",
          "description": "Scenarionyckel.",
          "maxLength": 40,
          "title": "Seed",
          "type": "string"
        },
        "stabling": {
          "default": true,
          "description": "Undanställning vid slutstationen.",
          "title": "Stabling",
          "type": "boolean"
        },
        "stabling_minutes": {
          "default": 5,
          "description": "Spelminuter.",
          "maximum": 60,
          "minimum": 1,
          "title": "Stabling Minutes",
          "type": "integer"
        },
        "late_stop_minutes": {
          "default": 2,
          "description": "Ett försenat tåg står så här länge (spelminuter).",
          "maximum": 10,
          "minimum": 1,
          "title": "Late Stop Minutes",
          "type": "integer"
        },
        "answer_seconds": {
          "default": 3,
          "description": "Klartecken efter så här många verkliga sekunder.",
          "maximum": 30,
          "minimum": 0,
          "title": "Answer Seconds",
          "type": "integer"
        }
      },
      "title": "AutomationSettings",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "protocol": {
      "const": "trainmeet.drift/1",
      "default": "trainmeet.drift/1",
      "title": "Protocol",
      "type": "string"
    },
    "seq": {
      "description": "Händelsens nummer i den körande träffen.",
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "epoch": {
      "description": "Ledarens epok; högre epok vinner.",
      "minimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "meet_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Meet Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "game_day": {
      "minimum": 1,
      "title": "Game Day",
      "type": "integer"
    },
    "model_time": {
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "title": "Model Time",
      "type": "string"
    },
    "wall_time": {
      "format": "date-time",
      "title": "Wall Time",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/EventKind"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "message_id": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Kommandots id, för spårbarhet.",
      "title": "Message Id"
    },
    "place": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Place"
    },
    "train": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Train"
    },
    "call": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    }
  },
  "required": [
    "seq",
    "epoch",
    "meet_id",
    "version",
    "game_day",
    "model_time",
    "wall_time",
    "kind",
    "actor"
  ],
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "meet.started",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/MeetStarted"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "clock.started",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClockChanged"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "clock.stopped",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClockChanged"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "clock.speed",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClockChanged"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "clearance.requested",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClearanceRequested"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "clearance.answered",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClearanceAnswered"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "clearance.cancelled",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClearanceRef"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "train.departed",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClearanceRef"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "train.arrived",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TrainArrived"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "train.moved_here",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TrainMovedHere"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "train.set_aside",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TrainSetAside"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "train.track_changed",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TrackChanged"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "train.positioned",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/FlagSet"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "train.crew_ready",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/FlagSet"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "clearance.invalidated",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClearanceRef"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "line.available",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/LineAvailableSent"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "line.acknowledged",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/LineAcknowledged"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "place.manned",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/PlaceManned"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "place.left",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/PlaceLeft"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "place.taken_back",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/PlaceTakenBack"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "automation.set",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/AutomationSettings"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "properties": {
        "kind": {
          "not": {
            "enum": [
              "meet.started",
              "clock.started",
              "clock.stopped",
              "clock.speed",
              "clearance.requested",
              "clearance.answered",
              "clearance.cancelled",
              "train.departed",
              "train.arrived",
              "train.moved_here",
              "train.set_aside",
              "train.track_changed",
              "train.positioned",
              "train.crew_ready",
              "clearance.invalidated",
              "line.available",
              "line.acknowledged",
              "place.manned",
              "place.left",
              "place.taken_back",
              "automation.set"
            ]
          }
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "clearance.requested"
          }
        }
      },
      "then": {
        "properties": {
          "call": {
            "type": "string"
          }
        },
        "required": [
          "call"
        ]
      }
    }
  ]
}
