{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.assembly-brief.schema.json",
  "title": "trainmeet.cad-1.assembly-brief",
  "$defs": {
    "Owner": {
      "additionalProperties": true,
      "description": "Who owns a module or an own gable profile: a person or a club in TrainMeet ID.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/OwnerKind"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "name"
      ],
      "title": "Owner",
      "type": "object"
    },
    "OwnerKind": {
      "enum": [
        "person",
        "club"
      ],
      "title": "OwnerKind",
      "type": "string"
    },
    "Scale": {
      "description": "The module's scale (CAD10, CAD12).",
      "enum": [
        "H0",
        "N",
        "0"
      ],
      "title": "Scale",
      "type": "string"
    },
    "StationUse": {
      "additionalProperties": true,
      "description": "Används i: a station in TKL that took an assembly or a module into use, as Studio told CAD\nwhen the owner confirmed it (CAD-15). The station's id is TKL's, the station's own.",
      "properties": {
        "station_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Station Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "description": "The assembly's revision, or the module's version.",
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "station_id",
        "name",
        "revision",
        "at"
      ],
      "title": "StationUse",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "An assembly as the list on Anläggningar shows it.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "$ref": "#/$defs/Owner"
    },
    "scale": {
      "$ref": "#/$defs/Scale"
    },
    "modules": {
      "minimum": 0,
      "title": "Modules",
      "type": "integer"
    },
    "problems": {
      "description": "How many things keep it from Studio.",
      "minimum": 0,
      "title": "Problems",
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "changed_at": {
      "format": "date-time",
      "title": "Changed At",
      "type": "string"
    },
    "may_edit": {
      "title": "May Edit",
      "type": "boolean"
    },
    "stations": {
      "items": {
        "$ref": "#/$defs/StationUse"
      },
      "title": "Stations",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "owner",
    "scale",
    "modules",
    "problems",
    "revision",
    "changed_at",
    "may_edit"
  ],
  "type": "object"
}
