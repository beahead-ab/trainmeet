{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.station-1.event.schema.json",
  "title": "trainmeet.station-1.event",
  "$defs": {
    "EventKind": {
      "enum": [
        "changed",
        "train.approaching",
        "clearance.requested",
        "clearance.answered",
        "clearance.reminder",
        "line.available",
        "approval"
      ],
      "title": "EventKind",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "protocol": {
      "const": "trainmeet.station/1",
      "default": "trainmeet.station/1",
      "title": "Protocol",
      "type": "string"
    },
    "seq": {
      "description": "Ökar per händelseström; ingen uppspelning av missade.",
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/EventKind"
    },
    "place": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Place",
      "type": "string"
    },
    "place_revision": {
      "minimum": 0,
      "title": "Place Revision",
      "type": "integer"
    },
    "clearance_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clearance Id"
    },
    "call": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call"
    },
    "train_number": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Train Number"
    }
  },
  "required": [
    "seq",
    "kind",
    "place",
    "place_revision"
  ],
  "type": "object"
}
