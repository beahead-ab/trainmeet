{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.problem.schema.json",
  "title": "trainmeet.cad-1.problem",
  "$defs": {
    "ProblemCode": {
      "description": "Why CAD said no. The web app has the text for each.",
      "enum": [
        "login",
        "not_found",
        "forbidden",
        "changed",
        "invalid",
        "unavailable",
        "no_tokens",
        "too_many",
        "reading_failed",
        "bad_photo",
        "storage_full",
        "consent_required",
        "busy",
        "bad_drawing"
      ],
      "title": "ProblemCode",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "The answer when CAD says no: 401, 402, 403, 404, 409, 413, 415, 422, 429, 502 or 503.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ProblemCode"
    },
    "message": {
      "description": "In Swedish, for the person and for logs.",
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "type": "object"
}
