{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.interlocking.schema.json",
  "title": "trainmeet.tkl-1.interlocking",
  "$defs": {
    "ExitSignalAspect": {
      "enum": [
        "stop",
        "proceed",
        "unknown"
      ],
      "title": "ExitSignalAspect",
      "type": "string"
    },
    "Position": {
      "description": "A switch's two positions. + is straight (rakt), - is diverging (avvikande).",
      "enum": [
        "+",
        "-"
      ],
      "title": "Position",
      "type": "string"
    },
    "RouteKind": {
      "enum": [
        "train",
        "shunting"
      ],
      "title": "RouteKind",
      "type": "string"
    },
    "SwitchControl": {
      "description": "Who lays the switch. Only TKL's switches have a lever, and no route crosses another.",
      "enum": [
        "tkl",
        "manual",
        "planned",
        "not_laid"
      ],
      "title": "SwitchControl",
      "type": "string"
    },
    "TklAspect": {
      "description": "What a signal shows. A combined signal shows SHUNT with the dwarf part (STV-24).",
      "enum": [
        "stop",
        "proceed",
        "shunt"
      ],
      "title": "TklAspect",
      "type": "string"
    },
    "TklExitShown": {
      "additionalProperties": true,
      "description": "A line exit: the line's pieces outside the entry signal, which belong to the line and\nnever turn green with a route (STV-54), and what goes up to Hubben as signal.exit.",
      "properties": {
        "exit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Exit",
          "type": "string"
        },
        "outside": {
          "description": "Utfartens id i utsidan.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Outside",
          "type": "string"
        },
        "pieces": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        },
        "aspect": {
          "$ref": "#/$defs/ExitSignalAspect",
          "default": "stop"
        }
      },
      "required": [
        "exit",
        "outside"
      ],
      "title": "TklExitShown",
      "type": "object"
    },
    "TklHappening": {
      "additionalProperties": true,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "at",
        "text"
      ],
      "title": "TklHappening",
      "type": "object"
    },
    "TklNumber": {
      "additionalProperties": true,
      "description": "Var ett tågnummer står (STV-06, STV-21): the section or the exit, its pieces, and the\nstation track when the section is on one, where the track's name is hidden (STV-57).",
      "properties": {
        "number": {
          "anyOf": [
            {
              "pattern": "^[0-9A-Za-z]{1,8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "train": {
          "minimum": 1,
          "title": "Train",
          "type": "integer"
        },
        "colour": {
          "$ref": "#/$defs/TklNumberColour"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "exit": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "pieces": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stationsspåret, med modellens namn.",
          "title": "Track"
        },
        "route": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "estimated": {
          "default": true,
          "description": "Numret följer knapparna, inte detekteringen: en uppskattad position.",
          "title": "Estimated",
          "type": "boolean"
        }
      },
      "required": [
        "train",
        "colour"
      ],
      "title": "TklNumber",
      "type": "object"
    },
    "TklNumberColour": {
      "enum": [
        "red",
        "green"
      ],
      "title": "TklNumberColour",
      "type": "string"
    },
    "TklPieceShown": {
      "additionalProperties": true,
      "properties": {
        "state": {
          "$ref": "#/$defs/TklPieceState"
        },
        "route": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        }
      },
      "required": [
        "state"
      ],
      "title": "TklPieceShown",
      "type": "object"
    },
    "TklPieceState": {
      "enum": [
        "train",
        "shunting",
        "occupied"
      ],
      "title": "TklPieceState",
      "type": "string"
    },
    "TklSectionPart": {
      "additionalProperties": true,
      "description": "A section of a set route, in the order the route runs through it: a track circuit, or\nwhere the model has none, the pieces between two switches, signals or ends (spårdel). It\nis released behind the train, one at a time (STV-29).",
      "properties": {
        "section": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "pieces": {
          "description": "Vägens spårbitar i delen, i färdriktningen.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        },
        "released": {
          "default": false,
          "title": "Released",
          "type": "boolean"
        }
      },
      "required": [
        "section",
        "pieces"
      ],
      "title": "TklSectionPart",
      "type": "object"
    },
    "TklSetRoute": {
      "additionalProperties": true,
      "description": "Lagd väg: a train route or shunting route the interlocking has set and locked.",
      "properties": {
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/RouteKind"
        },
        "start": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Start",
          "type": "string"
        },
        "end": {
          "maxLength": 80,
          "minLength": 1,
          "title": "End",
          "type": "string"
        },
        "chain": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Den sammansatta vägens första del, när vägen är en del av en (TKL53).",
          "title": "Chain"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/TklSectionPart"
          },
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        },
        "positions": {
          "additionalProperties": {
            "$ref": "#/$defs/Position"
          },
          "description": "Växlarna vägen lägger: sina egna, de kopplade och de som dras med (TKL104).",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Positions",
          "type": "object"
        },
        "locked": {
          "additionalProperties": {
            "$ref": "#/$defs/Position"
          },
          "description": "Växlarna vägen fortfarande låser.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Locked",
          "type": "object"
        },
        "protection": {
          "description": "Växlar vägen låser utan att gå över dem, som spakens andra halva (skyddsväxlar, STV-20).",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Protection",
          "type": "array"
        },
        "crossings": {
          "description": "Korsningar och korsningsväxlar vägen håller.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Crossings",
          "type": "array"
        },
        "turntable": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vändskivans spår som bryggan står mot, medan vägen håller.",
          "title": "Turntable"
        },
        "train": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tåget som tar vägen, när det är känt.",
          "title": "Train"
        },
        "at": {
          "default": -1,
          "description": "Delen där tågets front är: -1 innan tåget har passerat starten.",
          "minimum": -1,
          "title": "At",
          "type": "integer"
        },
        "aspect": {
          "$ref": "#/$defs/TklAspect",
          "description": "Vad startsignalen visar för vägen just nu."
        },
        "passed": {
          "description": "Signaler i färdriktningen som visar vägens besked tills tåget har passerat dem (STV-19).",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Passed",
          "type": "array"
        },
        "leaves": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linjeutfarten vägen leder ut till: förbi målet är linjen.",
          "title": "Leaves"
        },
        "enters": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linjeutfarten vägen kommer in från.",
          "title": "Enters"
        },
        "set_at": {
          "format": "date-time",
          "title": "Set At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "start",
        "end",
        "sections",
        "positions",
        "aspect",
        "set_at"
      ],
      "title": "TklSetRoute",
      "type": "object"
    },
    "TklSignalShown": {
      "additionalProperties": true,
      "properties": {
        "aspect": {
          "$ref": "#/$defs/TklAspect",
          "default": "stop"
        },
        "end": {
          "default": false,
          "description": "Slutpunkt för en lagd väg: röd i 85 och 95.",
          "title": "End",
          "type": "boolean"
        }
      },
      "title": "TklSignalShown",
      "type": "object"
    },
    "TklSwitchShown": {
      "additionalProperties": true,
      "description": "A switch part as the panel shows it.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "description": "Okänt för en växel TKL inte lägger."
        },
        "control": {
          "$ref": "#/$defs/SwitchControl",
          "default": "tkl"
        },
        "routes": {
          "description": "Vägarna som låser växeln.",
          "items": {
            "type": "integer"
          },
          "title": "Routes",
          "type": "array"
        },
        "protection": {
          "default": false,
          "description": "Låst av en väg som inte går över den: kort gult vid knuten (STV-20).",
          "title": "Protection",
          "type": "boolean"
        }
      },
      "required": [
        "position"
      ],
      "title": "TklSwitchShown",
      "type": "object"
    },
    "TklTrain": {
      "additionalProperties": true,
      "description": "Ett tåg i ställverket: its number, if any, and where its front is. Without detection\n(level 1–2) the number follows the buttons (STV-15). On a section, or on the line outside\nan exit, on its way in.",
      "properties": {
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "number": {
          "anyOf": [
            {
              "pattern": "^[0-9A-Za-z]{1,8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Utan nummer: en växling.",
          "title": "Number"
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tågbesöket i hubbens bild, när det är känt.",
          "title": "Call"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "exit": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "På linjen utanför linjeutfarten.",
          "title": "Exit"
        }
      },
      "required": [
        "id"
      ],
      "title": "TklTrain",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Ställverkets läge i stunden (STV-08): everything the panel draws, kept with the station\nso that a restart keeps it. Never the model, the clearance or the timetable (STV-09).",
  "properties": {
    "station_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Station Id",
      "type": "string"
    },
    "level": {
      "maximum": 3,
      "minimum": 1,
      "title": "Level",
      "type": "integer"
    },
    "model": {
      "description": "Stationsmodellens fingeravtryck: läget gäller den.",
      "title": "Model",
      "type": "string"
    },
    "revision": {
      "description": "Räknar upp vid varje ändring; väntan följer den.",
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "problem": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Läget gäller inte stationsmodellen: allt utom nollställning nekas.",
      "title": "Problem"
    },
    "switches": {
      "additionalProperties": {
        "$ref": "#/$defs/TklSwitchShown"
      },
      "propertyNames": {
        "maxLength": 80,
        "minLength": 1
      },
      "title": "Switches",
      "type": "object"
    },
    "levers": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/Position"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "Spakarnas lägen; inget när spakens växlar ligger i kors.",
      "propertyNames": {
        "maxLength": 80,
        "minLength": 1
      },
      "title": "Levers",
      "type": "object"
    },
    "turntables": {
      "additionalProperties": {
        "anyOf": [
          {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "Spåret vändskivans brygga står mot.",
      "propertyNames": {
        "maxLength": 80,
        "minLength": 1
      },
      "title": "Turntables",
      "type": "object"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/TklSetRoute"
      },
      "title": "Routes",
      "type": "array"
    },
    "trains": {
      "items": {
        "$ref": "#/$defs/TklTrain"
      },
      "title": "Trains",
      "type": "array"
    },
    "signals": {
      "additionalProperties": {
        "$ref": "#/$defs/TklSignalShown"
      },
      "propertyNames": {
        "maxLength": 80,
        "minLength": 1
      },
      "title": "Signals",
      "type": "object"
    },
    "pieces": {
      "additionalProperties": {
        "$ref": "#/$defs/TklPieceShown"
      },
      "description": "Spårbitar som inte är lediga.",
      "propertyNames": {
        "maxLength": 80,
        "minLength": 1
      },
      "title": "Pieces",
      "type": "object"
    },
    "numbers": {
      "items": {
        "$ref": "#/$defs/TklNumber"
      },
      "title": "Numbers",
      "type": "array"
    },
    "exits": {
      "items": {
        "$ref": "#/$defs/TklExitShown"
      },
      "title": "Exits",
      "type": "array"
    },
    "events": {
      "description": "Senaste först.",
      "items": {
        "$ref": "#/$defs/TklHappening"
      },
      "title": "Events",
      "type": "array"
    },
    "last_id": {
      "default": 0,
      "description": "Det senaste id:t för en väg eller ett tåg.",
      "minimum": 0,
      "title": "Last Id",
      "type": "integer"
    }
  },
  "required": [
    "station_id",
    "level",
    "model",
    "revision"
  ],
  "type": "object"
}
