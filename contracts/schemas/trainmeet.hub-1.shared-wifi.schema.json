{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.hub-1.shared-wifi.schema.json",
  "title": "trainmeet.hub-1.shared-wifi",
  "additionalProperties": true,
  "description": "Träffens Wi-Fi som deltagarna ser det, på träffens nät eller inloggade (S8).",
  "properties": {
    "name": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "open": {
      "title": "Open",
      "type": "boolean"
    },
    "password": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Lösenordet, när ett är inlagt: det boxen och telefonen frågar efter.",
      "title": "Password"
    }
  },
  "required": [
    "name",
    "open"
  ],
  "type": "object"
}
