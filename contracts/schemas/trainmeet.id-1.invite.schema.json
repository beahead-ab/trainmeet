{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.invite.schema.json",
  "title": "trainmeet.id-1.invite",
  "additionalProperties": true,
  "description": "Invite someone to the club with their e-mail address (KONTO-35).",
  "properties": {
    "email": {
      "maxLength": 254,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "title": "Email",
      "type": "string"
    }
  },
  "required": [
    "email"
  ],
  "type": "object"
}
