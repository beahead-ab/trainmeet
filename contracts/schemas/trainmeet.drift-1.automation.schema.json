{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.drift-1.automation.schema.json",
  "title": "trainmeet.drift-1.automation",
  "$defs": {
    "AutomationPlaceStatus": {
      "additionalProperties": true,
      "properties": {
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/PlaceMode"
        },
        "left_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeftBy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "takes_over_in": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sekunder tills automatiken tar över; null är aldrig.",
          "title": "Takes Over In"
        },
        "operator": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "present": {
          "description": "Klienter i kontakt här.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Present",
          "type": "array"
        }
      },
      "required": [
        "place",
        "name",
        "code",
        "mode"
      ],
      "title": "AutomationPlaceStatus",
      "type": "object"
    },
    "AutomationSettings": {
      "additionalProperties": true,
      "description": "Trafikledningens val för automatiken, med gamla Servers förval (H42).",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Av: automatiken rör ingenting.",
          "title": "Enabled",
          "type": "boolean"
        },
        "lost_contact_minutes": {
          "default": 0,
          "description": "Övertag efter Kontakt saknas; 0 är aldrig.",
          "enum": [
            0,
            2,
            5,
            10
          ],
          "title": "Lost Contact Minutes",
          "type": "integer"
        },
        "disturbance": {
          "$ref": "#/$defs/Disturbance",
          "default": "off"
        },
        "where": {
          "$ref": "#/$defs/DisturbanceWhere",
          "default": "both"
        },
        "seed": {
          "default": "",
          "description": "Scenarionyckel.",
          "maxLength": 40,
          "title": "Seed",
          "type": "string"
        },
        "stabling": {
          "default": true,
          "description": "Undanställning vid slutstationen.",
          "title": "Stabling",
          "type": "boolean"
        },
        "stabling_minutes": {
          "default": 5,
          "description": "Spelminuter.",
          "maximum": 60,
          "minimum": 1,
          "title": "Stabling Minutes",
          "type": "integer"
        },
        "late_stop_minutes": {
          "default": 2,
          "description": "Ett försenat tåg står så här länge (spelminuter).",
          "maximum": 10,
          "minimum": 1,
          "title": "Late Stop Minutes",
          "type": "integer"
        },
        "answer_seconds": {
          "default": 3,
          "description": "Klartecken efter så här många verkliga sekunder.",
          "maximum": 30,
          "minimum": 0,
          "title": "Answer Seconds",
          "type": "integer"
        }
      },
      "title": "AutomationSettings",
      "type": "object"
    },
    "AutomationTrain": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "train": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train",
          "type": "string"
        },
        "from_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "From Place",
          "type": "string"
        },
        "to_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To Place",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "call",
        "train",
        "from_place",
        "to_place",
        "reason"
      ],
      "title": "AutomationTrain",
      "type": "object"
    },
    "Disturbance": {
      "enum": [
        "off",
        "normal",
        "disrupted"
      ],
      "title": "Disturbance",
      "type": "string"
    },
    "DisturbanceWhere": {
      "enum": [
        "both",
        "station",
        "line"
      ],
      "title": "DisturbanceWhere",
      "type": "string"
    },
    "LeftBy": {
      "enum": [
        "dispatcher",
        "operator",
        "lost_contact"
      ],
      "title": "LeftBy",
      "type": "string"
    },
    "PlaceMode": {
      "enum": [
        "manned",
        "no_contact",
        "automatic"
      ],
      "title": "PlaceMode",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "settings": {
      "$ref": "#/$defs/AutomationSettings"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/AutomationPlaceStatus"
      },
      "title": "Places",
      "type": "array"
    },
    "trains": {
      "description": "Tåg som automatiken väntar med, och varför.",
      "items": {
        "$ref": "#/$defs/AutomationTrain"
      },
      "title": "Trains",
      "type": "array"
    }
  },
  "required": [
    "settings"
  ],
  "type": "object"
}
