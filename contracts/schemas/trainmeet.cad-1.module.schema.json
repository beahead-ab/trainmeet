{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.module.schema.json",
  "title": "trainmeet.cad-1.module",
  "$defs": {
    "ArcSegment": {
      "additionalProperties": true,
      "description": "ARC: a circular piece of track centre, in mm, as DXF's ARC. clockwise is as the drawing\nshows it, with y down.",
      "properties": {
        "kind": {
          "const": "arc",
          "default": "arc",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "center": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Radius",
          "type": "number"
        },
        "clockwise": {
          "title": "Clockwise",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "center",
        "radius",
        "clockwise"
      ],
      "title": "ArcSegment",
      "type": "object"
    },
    "Certainty": {
      "description": "How sure a fact is, as in the import and the photo chain (bildkedjan, principle 4).",
      "enum": [
        "certain",
        "probable",
        "uncertain",
        "confirmed"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "CheckAnswer": {
      "additionalProperties": true,
      "description": "Ägarens svar på en sak att kolla: kept with the version, by the item's key.",
      "properties": {
        "key": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "answer": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "title": "Answer",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        }
      },
      "required": [
        "key",
        "answer"
      ],
      "title": "CheckAnswer",
      "type": "object"
    },
    "CheckChoice": {
      "additionalProperties": true,
      "description": "An answer button. closes: the answer settles the item; action: what the view does\ninstead, with no answer stored (choose a switch type, open Lås mått, or answer the photo's\nquestion in Osäkert parti).",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "closes": {
          "default": true,
          "title": "Closes",
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "enum": [
                "design",
                "lock",
                "photo"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "CheckChoice",
      "type": "object"
    },
    "CheckItem": {
      "additionalProperties": true,
      "description": "Att kolla: one thing the owner answers before the track plan is approved. The key names\nthe kind, the parts and the measured value, so a changed value asks again.",
      "properties": {
        "key": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CheckKind"
        },
        "source": {
          "$ref": "#/$defs/CheckSource",
          "default": "code"
        },
        "at": {
          "description": "The place in mm, in the module's coordinates.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "refs": {
          "description": "The nodes, pieces and switches.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/CheckChoice"
          },
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        },
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckAnswer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "assumed": {
          "default": false,
          "description": "Antagen (AR3): yellow; otherwise orange, as a proposal.",
          "title": "Assumed",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "kind",
        "at",
        "title",
        "text",
        "choices"
      ],
      "title": "CheckItem",
      "type": "object"
    },
    "CheckKind": {
      "description": "Att kolla: what the code found, or (part c) what AI asks.",
      "enum": [
        "short_rail",
        "open_end",
        "switch_radius",
        "switch_assumed",
        "kink",
        "tight_radius",
        "gable_position",
        "question"
      ],
      "title": "CheckKind",
      "type": "string"
    },
    "CheckSource": {
      "enum": [
        "code",
        "ai"
      ],
      "title": "CheckSource",
      "type": "string"
    },
    "Curve": {
      "additionalProperties": true,
      "description": "Kurvmodul: track 1's radius and the angle, from the string and sagitta or given directly.\nWith Kant 1 as the outer edge the curve turns right seen from gable A, as in the drawing.",
      "properties": {
        "kind": {
          "const": "curve",
          "default": "curve",
          "title": "Kind",
          "type": "string"
        },
        "radius": {
          "description": "Track 1's centre line, in mm.",
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Radius",
          "type": "number"
        },
        "angle": {
          "description": "The angle, in degrees.",
          "exclusiveMaximum": 180,
          "exclusiveMinimum": 0,
          "title": "Angle",
          "type": "number"
        },
        "width": {
          "description": "The module body's width, Kant 1 to the other edge.",
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Width",
          "type": "number"
        },
        "edge": {
          "$ref": "#/$defs/EdgeSide",
          "default": "outer"
        },
        "sides": {
          "$ref": "#/$defs/CurveSides",
          "default": "bent"
        },
        "measured": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurveMeasure"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The string and sagitta the radius and angle came from."
        }
      },
      "required": [
        "radius",
        "angle",
        "width"
      ],
      "title": "Curve",
      "type": "object"
    },
    "CurveMeasure": {
      "additionalProperties": true,
      "description": "The owner's measurement of a curve: a string between track 1's centre at A and B, and the\nsagitta (pilhöjd) from the string's middle to the track (CADMOB-03).",
      "properties": {
        "chord": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Chord",
          "type": "number"
        },
        "sagitta": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Sagitta",
          "type": "number"
        }
      },
      "required": [
        "chord",
        "sagitta"
      ],
      "title": "CurveMeasure",
      "type": "object"
    },
    "CurveSides": {
      "description": "The box's long sides.",
      "enum": [
        "bent",
        "straight"
      ],
      "title": "CurveSides",
      "type": "string"
    },
    "DrawingSource": {
      "description": "Where the track plan comes from: the badge in Ritningen.",
      "enum": [
        "measures",
        "drawn",
        "photo",
        "sketch"
      ],
      "title": "DrawingSource",
      "type": "string"
    },
    "DrawingState": {
      "additionalProperties": true,
      "description": "What a version keeps of its drawing besides the graph: where it came from, the\nutjämning, the owner's answers, the drawn lines, the locked measures, and the ids this\nversion split or replaced.",
      "properties": {
        "source": {
          "$ref": "#/$defs/DrawingSource",
          "default": "measures"
        },
        "smoothing": {
          "$ref": "#/$defs/Smoothing",
          "default": "normal"
        },
        "answers": {
          "items": {
            "$ref": "#/$defs/CheckAnswer"
          },
          "title": "Answers",
          "type": "array"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/DrawnLine"
          },
          "title": "Lines",
          "type": "array"
        },
        "locks": {
          "items": {
            "$ref": "#/$defs/LockedMeasure"
          },
          "title": "Locks",
          "type": "array"
        },
        "ids": {
          "description": "This version's splits.",
          "items": {
            "$ref": "#/$defs/IdChange"
          },
          "title": "Ids",
          "type": "array"
        },
        "plan_approved": {
          "default": false,
          "description": "Godkänn spårplanen gave this one.",
          "title": "Plan Approved",
          "type": "boolean"
        },
        "questions": {
          "description": "The photo chain's questions (part c1): Att kolla items of the kind question, source code or ai, kept with the version.",
          "items": {
            "$ref": "#/$defs/CheckItem"
          },
          "title": "Questions",
          "type": "array"
        },
        "photo": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The photo job the drawing came from (part c1).",
          "title": "Photo"
        }
      },
      "title": "DrawingState",
      "type": "object"
    },
    "DrawnLine": {
      "additionalProperties": true,
      "description": "The line a piece was drawn from, by hand (or, in part c, traced in the photo or the\nsketch): utjämning makes it LINE and ARC again when its level changes, and the deviation is\nmeasured from it.",
      "properties": {
        "piece": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Piece",
          "type": "string"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 4000,
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "source": {
          "default": "hand",
          "enum": [
            "hand",
            "photo",
            "sketch"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "piece",
        "points"
      ],
      "title": "DrawnLine",
      "type": "object"
    },
    "EdgeSide": {
      "description": "Which edge of a curve module is Kant 1.",
      "enum": [
        "outer",
        "inner"
      ],
      "title": "EdgeSide",
      "type": "string"
    },
    "GableEnd": {
      "enum": [
        "A",
        "B"
      ],
      "title": "GableEnd",
      "type": "string"
    },
    "GableLabel": {
      "additionalProperties": true,
      "description": "A gable as the library shows it: \"FREMO dubbelspår\", \"Egen gavel · 3 spår\".",
      "properties": {
        "end": {
          "$ref": "#/$defs/GableEnd"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "norm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Norm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "tracks": {
          "items": {
            "type": "number"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "end",
        "label",
        "tracks"
      ],
      "title": "GableLabel",
      "type": "object"
    },
    "GraphLabel": {
      "additionalProperties": true,
      "description": "Etikett: a text in the drawing at a point in mm, on a piece or a switch or free\n(bildkedjan, R4 and point 21). The Text tool writes them. In a drawing read for Studio the\npoint is in the drawing's own coordinates, ref is the object code tied it to (the nearest\none), and read_by says how the text was read.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "at": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The piece, switch, node or symbol it names.",
          "title": "Ref"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "read_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadBy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Textlager, OCR eller AI; null: written in CAD."
        }
      },
      "required": [
        "id",
        "text",
        "at"
      ],
      "title": "GraphLabel",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": true,
      "description": "Nod: where pieces meet or end. A track at a gable is a module joint with its gable and\nits track number there.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        },
        "at": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "gable": {
          "anyOf": [
            {
              "$ref": "#/$defs/GableEnd"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "track": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spår n i gaveln.",
          "title": "Track"
        }
      },
      "required": [
        "id",
        "type",
        "at"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphOrigin": {
      "additionalProperties": true,
      "properties": {
        "source": {
          "$ref": "#/$defs/GraphSource"
        },
        "certainty": {
          "$ref": "#/$defs/Certainty"
        }
      },
      "required": [
        "source",
        "certainty"
      ],
      "title": "GraphOrigin",
      "type": "object"
    },
    "GraphPiece": {
      "additionalProperties": true,
      "description": "Spårbit: track centre from one node to another, as LINE and ARC segments in order.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "start": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "End",
          "type": "string"
        },
        "segments": {
          "items": {
            "discriminator": {
              "mapping": {
                "arc": "#/$defs/ArcSegment",
                "line": "#/$defs/LineSegment"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LineSegment"
              },
              {
                "$ref": "#/$defs/ArcSegment"
              }
            ]
          },
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spårnummer, när ägaren har gett det.",
          "title": "Track"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "segments"
      ],
      "title": "GraphPiece",
      "type": "object"
    },
    "GraphSource": {
      "description": "Where a piece of the graph comes from.",
      "enum": [
        "measures",
        "photo",
        "sketch",
        "anyrail",
        "drawn",
        "drawing"
      ],
      "title": "GraphSource",
      "type": "string"
    },
    "GraphSwitch": {
      "additionalProperties": true,
      "description": "Växel, korsningsväxel eller korsning, at a node: the station model's Switch with CAD's\nids. The diverging leg's radius and angle, when known. The node is the points (tungspetsen);\nthe diverging leg leaves the through track tangentially toward gable A or B (lärdomarna,\nVäxlar). design is the switch type from the switch library (Växeltyp), null while Okänd.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "node": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Node",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SwitchType"
        },
        "trunk": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trunk"
        },
        "straight": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Straight"
        },
        "diverging": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diverging"
        },
        "radius": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 20000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius"
        },
        "angle": {
          "anyOf": [
            {
              "exclusiveMaximum": 90,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "number": {
          "anyOf": [
            {
              "maxLength": 20,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Växelnummer.",
          "title": "Number"
        },
        "design": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Växeltyp; null: Okänd.",
          "title": "Design"
        },
        "toward": {
          "anyOf": [
            {
              "$ref": "#/$defs/GableEnd"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The gable the diverging leg heads for."
        },
        "locked": {
          "default": false,
          "description": "Lås växelns läge när kurvorna räknas om: Lås mått keeps the points where they are.",
          "title": "Locked",
          "type": "boolean"
