{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.cad-1.account.schema.json",
  "title": "trainmeet.cad-1.account",
  "additionalProperties": true,
  "description": "The person who is logged in, as CAD knows them. The id is ID's subject.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "initials": {
      "description": "For the account button.",
      "maxLength": 3,
      "minLength": 1,
      "title": "Initials",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "initials"
  ],
  "type": "object"
}
