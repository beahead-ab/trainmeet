{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.meet-page.schema.json",
  "title": "trainmeet.id-1.meet-page",
  "$defs": {
    "Grant": {
      "additionalProperties": true,
      "description": "A role someone has for a resource.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "person": {
          "$ref": "#/$defs/Person"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "person",
        "role",
        "resource",
        "at"
      ],
      "title": "Grant",
      "type": "object"
    },
    "Meet": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "club": {
          "format": "uuid",
          "title": "Club",
          "type": "string"
        },
        "club_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Club Name",
          "type": "string"
        },
        "roles": {
          "description": "The person's own roles at the meet.",
          "items": {
            "$ref": "#/$defs/MeetRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "club_admin": {
          "default": false,
          "description": "The person is the club's admin, with the admin's say at its meets (KONTO-36). The Hub plans the meet then, as it does for the organizer (#78).",
          "title": "Club Admin",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "starts_on",
        "ends_on",
        "id",
        "club",
        "club_name",
        "roles"
      ],
      "title": "Meet",
      "type": "object"
    },
    "MeetRole": {
      "description": "The roles per meet that ID hands out until the Hub logs in with ID (ID10, KONTO-28).",
      "enum": [
        "organizer",
        "dispatcher",
        "loco_lead",
        "remote_clearer"
      ],
      "title": "MeetRole",
      "type": "string"
    },
    "Person": {
      "additionalProperties": true,
      "description": "Someone else, as a member or someone with a role: never their address.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "initials": {
          "maxLength": 3,
          "minLength": 1,
          "title": "Initials",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "initials"
      ],
      "title": "Person",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": true,
      "description": "One thing a role applies to: its kind and its id in the app that owns it.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Resource",
      "type": "object"
    },
    "ResourceKind": {
      "description": "What a role applies to (KONTO-03). ID only holds the reference, never the thing.",
      "enum": [
        "club",
        "fleet",
        "meet",
        "station",
        "module",
        "hub",
        "catalog"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "Role": {
      "description": "The roles ID holds on one place (KONTO-28, KONTO-30, CAT-44, KONTO-35).",
      "enum": [
        "admin",
        "member",
        "organizer",
        "reader",
        "dispatcher",
        "loco_lead",
        "remote_clearer",
        "reviewer",
        "viewer",
        "editor"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "A meet's roles, as the club's members see them (ID10). Whoever may hand out roles also\ngets the club's members to choose from (KONTO-17: clubs are kept apart).",
  "properties": {
    "meet": {
      "$ref": "#/$defs/Meet"
    },
    "grants": {
      "items": {
        "$ref": "#/$defs/Grant"
      },
      "title": "Grants",
      "type": "array"
    },
    "may_give": {
      "description": "The roles the person may hand out here: the club's admin all of them, the organizer Trafikledare and Lokledare (KONTO-36).",
      "items": {
        "$ref": "#/$defs/MeetRole"
      },
      "title": "May Give",
      "type": "array"
    },
    "may_change": {
      "description": "May change the name and the dates.",
      "title": "May Change",
      "type": "boolean"
    },
    "may_remove": {
      "description": "May remove the meet: the club's admin.",
      "title": "May Remove",
      "type": "boolean"
    },
    "members": {
      "description": "The club's members, when the person may hand out.",
      "items": {
        "$ref": "#/$defs/Person"
      },
      "title": "Members",
      "type": "array"
    }
  },
  "required": [
    "meet",
    "grants",
    "may_give",
    "may_change",
    "may_remove"
  ],
  "type": "object"
}
