          },
          "title": "Switches",
          "type": "array"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/GraphLabel"
          },
          "title": "Labels",
          "type": "array"
        },
        "symbols": {
          "description": "Symbols read from a drawing (bildkedjan R3, 21).",
          "items": {
            "$ref": "#/$defs/GraphSymbol"
          },
          "title": "Symbols",
          "type": "array"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "issued": {
          "default": 0,
          "description": "Ids issued so far; the next is one more.",
          "minimum": 0,
          "title": "Issued",
          "type": "integer"
        }
      },
      "title": "TrackGraph",
      "type": "object"
    }
