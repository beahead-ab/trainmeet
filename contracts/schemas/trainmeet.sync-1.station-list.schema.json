{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.sync-1.station-list.schema.json",
  "title": "trainmeet.sync-1.station-list",
  "$defs": {
    "StationVersionInfo": {
      "additionalProperties": true,
      "properties": {
        "station_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Station Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "saved": {
          "format": "date-time",
          "title": "Saved",
          "type": "string"
        },
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "station_id",
        "version",
        "saved",
        "checksum",
        "name"
      ],
      "title": "StationVersionInfo",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Ägarens stationer i Synk (TKL5, TKLMOLN-02): den senaste versionen av var och en, för\nDina stationer i TKL i molnet. Bara den som ID:s token säger, aldrig någon annans.",
  "properties": {
    "stations": {
      "items": {
        "$ref": "#/$defs/StationVersionInfo"
      },
      "maxItems": 500,
      "title": "Stations",
      "type": "array"
    }
  },
  "type": "object"
}
