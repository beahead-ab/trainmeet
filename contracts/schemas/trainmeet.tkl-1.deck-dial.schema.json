{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.deck-dial.schema.json",
  "title": "trainmeet.tkl-1.deck-dial",
  "additionalProperties": true,
  "description": "A dial turned some steps, or pressed (SD83).",
  "properties": {
    "dial": {
      "maximum": 7,
      "minimum": 0,
      "title": "Dial",
      "type": "integer"
    },
    "turn": {
      "default": 0,
      "maximum": 20,
      "minimum": -20,
      "title": "Turn",
      "type": "integer"
    },
    "press": {
      "default": false,
      "title": "Press",
      "type": "boolean"
    }
  },
  "required": [
    "dial"
  ],
  "type": "object"
}
