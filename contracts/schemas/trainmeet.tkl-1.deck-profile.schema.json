{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.deck-profile.schema.json",
  "title": "trainmeet.tkl-1.deck-profile",
  "$defs": {
    "DeckAction": {
      "enum": [
        "los",
        "ankommit",
        "kor",
        "avbryt",
        "tillbaka",
        "las",
        "lagg",
        "los-vagen",
        "los-alla",
        "noll",
        "nodutlosning",
        "ingenting",
        "lamna",
        "klart",
        "ring",
        "grindar",
        "tuta",
        "fika",
        "klocka",
        "begaran"
      ],
      "title": "DeckAction",
      "type": "string"
    },
    "DeckDial": {
      "description": "What a dial does in a mode (SD83): turn chooses, press does it.",
      "enum": [
        "tag",
        "spar",
        "sida",
        "lagd-vag",
        "start",
        "mal",
        "del",
        "sidled",
        "hojdled",
        "signal",
        "begar",
        "gata",
        "klart-tag"
      ],
      "title": "DeckDial",
      "type": "string"
    },
    "DeckKeyType": {
      "description": "The fixed catalogue of keys (SD4): a new type is added for all, never for a station.",
      "enum": [
        "train",
        "line",
        "alarm",
        "track",
        "place",
        "part",
        "signal",
        "daily",
        "favourite",
        "tile",
        "cell",
        "pan",
        "mode",
        "next",
        "page",
        "action",
        "panel",
        "route",
        "ande",
        "gata",
        "begar",
        "klart-tag",
        "fjarrvag",
        "erbjudande"
      ],
      "title": "DeckKeyType",
      "type": "string"
    },
    "DeckMode": {
      "description": "Lägena (SD63): a group of pages with the same way of working. Bangård is the shunter's\ndeck, for a deck with a part's role (#87 del d, SD74). Fjärr is the fjärrtågklarerare's,\na page per station it controls (#36 del d, SD37).",
      "enum": [
        "tagen",
        "platser",
        "sparplan",
        "bangard",
        "fjarr"
      ],
      "title": "DeckMode",
      "type": "string"
    },
    "DeckModelId": {
      "description": "Elgato's models (SD52). Module 6, 15 and 32 and the older editions of the 15 get the\nprofile of the size they have (SD54).",
      "enum": [
        "mini",
        "neo",
        "15",
        "xl",
        "plus",
        "plus-xl",
        "pedal",
        "module-6",
        "module-15",
        "module-32",
        "studio"
      ],
      "title": "DeckModelId",
      "type": "string"
    },
    "DeckPageKind": {
      "enum": [
        "nu",
        "dagens",
        "favoriter",
        "platser",
        "delar",
        "del",
        "signaler",
        "alla",
        "hela",
        "utsnitt",
        "egen",
        "bangard",
        "fjarr"
      ],
      "title": "DeckPageKind",
      "type": "string"
    },
    "DeckPan": {
      "enum": [
        "hela",
        "vaster",
        "oster",
        "upp",
        "ner"
      ],
      "title": "DeckPan",
      "type": "string"
    },
    "DeckStyle": {
      "description": "Where Läge and the fixed keys sit (SD27, SD75, SD77, SD78).",
      "enum": [
        "none",
        "next",
        "last",
        "row",
        "column"
      ],
      "title": "DeckStyle",
      "type": "string"
    },
    "PartSide": {
      "description": "Ände: the end of the part a switch street or a route out belongs to (TKL109, TKL122).",
      "enum": [
        "left",
        "right"
      ],
      "title": "PartSide",
      "type": "string"
    },
    "RouteKind": {
      "enum": [
        "train",
        "shunting"
      ],
      "title": "RouteKind",
      "type": "string"
    },
    "TklDeckGrid": {
      "additionalProperties": true,
      "description": "What a deck has (SD53): the keys in columns and rows, and the dials, the touch strip,\nthe info line, the touch points and the pedals. A model TKL does not know is read this\nway too, and gets the default for its grid.",
      "properties": {
        "columns": {
          "maximum": 32,
          "minimum": 0,
          "title": "Columns",
          "type": "integer"
        },
        "rows": {
          "maximum": 8,
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "dials": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Dials",
          "type": "integer"
        },
        "strip": {
          "default": false,
          "description": "Pekremsan, på + och + XL.",
          "title": "Strip",
          "type": "boolean"
        },
        "info": {
          "default": false,
          "description": "Inforaden, på Neo.",
          "title": "Info",
          "type": "boolean"
        },
        "touch": {
          "default": 0,
          "description": "Pekpunkterna, på Neo.",
          "maximum": 4,
          "minimum": 0,
          "title": "Touch",
          "type": "integer"
        },
        "pedals": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Pedals",
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "TklDeckGrid",
      "type": "object"
    },
    "TklDeckKey": {
      "additionalProperties": true,
      "description": "A key in a profile: its type from the catalogue and what it points at, as data (SD5).\n\nWhat the owner may change in Studio (SD43) is here too: the text and the line under, what a\npress and a hold do from the fixed list `DeckAction`, and what the key shows. Never the\ncolours, the symbols or what a gesture means (SD3): those follow the catalogue.",
      "properties": {
        "type": {
          "$ref": "#/$defs/DeckKeyType"
        },
        "slot": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tåget, linjen eller vägen i tur.",
          "title": "Slot"
        },
        "point": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Signalen eller punkten (SIGNAL).",
          "title": "Point"
        },
        "place": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platsen (PLACE, TRACK).",
          "title": "Place"
        },
        "part": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Delen (PART).",
          "title": "Part"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sidan knappen öppnar.",
          "title": "Page"
        },
        "dx": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Utsnittets kolumn (CELL).",
          "title": "Dx"
        },
        "dy": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Utsnittets rad (CELL).",
          "title": "Dy"
        },
        "rect": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Biten av spårplanen i rutor: x, y, bredd, höjd (TILE).",
          "title": "Rect"
        },
        "pan": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckPan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "function": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Panelfunktionens namn (PANEL).",
          "title": "Function"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/TklDeckRoute"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Snabbvägens väg (ROUTE)."
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spåret: växelgatans eller vägen ut:s spår i delen (STREET, REQUEST, #87).",
          "title": "Track"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartSide"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Änden knappen alltid gäller; inget: den ände Ände har valt (STREET, REQUEST)."
        },
        "remote": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tågvägens id i stationens fjärrkatalog, med driftplatsen i place (REMOTE_ROUTE, #36 del d).",
          "title": "Remote"
        },
        "text": {
          "default": "",
          "description": "Knappens text, när den är given.",
          "maxLength": 60,
          "title": "Text",
          "type": "string"
        },
        "under": {
          "default": "",
          "description": "Undertexten, när ägaren har gett den.",
          "maxLength": 60,
          "title": "Under",
          "type": "string"
        },
        "press": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vad ett tryck gör, ur den fasta listan; annars katalogens."
        },
        "hold": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vad håll in gör, ur den fasta listan; annars katalogens."
        },
        "number": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Visa tågnumret på målspåret (snabbväg). Förval: ja.",
          "title": "Number"
        },
        "dim": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tona ned knappen när vägen är hindrad (SD17). Förval: ja.",
          "title": "Dim"
        },
        "confirm": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fråga en gång till före trycket. Förval: nej.",
          "title": "Confirm"
        }
      },
      "required": [
        "type"
      ],
      "title": "TklDeckKey",
      "type": "object"
    },
    "TklDeckPage": {
      "additionalProperties": true,
      "description": "A page: every key of the grid, row by row, the fixed ones included.",
      "properties": {
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/DeckMode"
        },
        "kind": {
          "$ref": "#/$defs/DeckPageKind"
        },
        "keys": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TklDeckKey"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Keys",
          "type": "array"
        },
        "listed": {
          "default": true,
          "description": "Står bland Sidor (SD26). En dels sida gör inte det.",
          "title": "Listed",
          "type": "boolean"
        },
        "cancel": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Där Avbryt står medan en start är vald.",
          "title": "Cancel"
        },
        "part": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Delen sidan visar (SD79).",
          "title": "Part"
        }
      },
      "required": [
        "name",
        "mode",
        "kind",
        "keys"
      ],
      "title": "TklDeckPage",
      "type": "object"
    },
    "TklDeckPart": {
      "additionalProperties": true,
      "description": "A part of the station, west to east (SD79): the west exits, a group of track parts, or\nthe east exits.",
      "properties": {
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "places": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Places",
          "type": "array"
        },
        "said": {
          "default": "",
          "description": "Platserna i korthet, till exempel A1–A4.",
          "maxLength": 60,
          "title": "Said",
          "type": "string"
        }
      },
      "required": [
        "name",
        "places"
      ],
      "title": "TklDeckPart",
      "type": "object"
    },
    "TklDeckPlace": {
      "additionalProperties": true,
      "description": "A place where a train route starts or ends (SD66): an exit or a station track.",
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "exit",
            "track"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "Exit's or track's own name (SD73).",
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "part": {
          "minimum": 0,
          "title": "Part",
          "type": "integer"
        },
        "starts": {
          "description": "Tågvägarnas starter här.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Starts",
          "type": "array"
        },
        "ends": {
          "description": "Tågvägarnas mål här.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Ends",
          "type": "array"
        },
        "signals": {
          "description": "Signalen i var ände (SD69).",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "part",
        "x",
        "y"
      ],
      "title": "TklDeckPlace",
      "type": "object"
    },
    "TklDeckPoint": {
      "additionalProperties": true,
      "description": "A route's start or goal where the panel has it, for the geographic pages and Spårplan.",
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "start": {
          "title": "Start",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "x",
        "y",
        "start"
      ],
      "title": "TklDeckPoint",
      "type": "object"
    },
    "TklDeckRoute": {
      "additionalProperties": true,
      "properties": {
        "start": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Start",
          "type": "string"
        },
        "end": {
          "maxLength": 80,
          "minLength": 1,
          "title": "End",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RouteKind"
        }
      },
      "required": [
        "start",
        "end",
        "kind"
      ],
      "title": "TklDeckRoute",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The deck's profile for one grid (SD5, SD32, SD53): computed from the station model and\nnever stored as code, with the owner's deviations laid on (SD40, tkl.deck.deviations).",
  "properties": {
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeckModelId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "grid": {
      "$ref": "#/$defs/TklDeckGrid"
    },
    "style": {
      "$ref": "#/$defs/DeckStyle"
    },
    "fixed": {
      "description": "Den fasta radens knappar (SD27).",
      "items": {
        "type": "integer"
      },
      "title": "Fixed",
      "type": "array"
    },
    "modes": {
      "description": "Lägena decket har (SD76).",
      "items": {
        "$ref": "#/$defs/DeckMode"
      },
      "title": "Modes",
      "type": "array"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/TklDeckPage"
      },
      "title": "Pages",
      "type": "array"
    },
    "dials": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/DeckDial"
        },
        "type": "array"
      },
      "propertyNames": {
        "$ref": "#/$defs/DeckMode"
      },
      "title": "Dials",
      "type": "object"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/TklDeckPlace"
      },
      "title": "Places",
      "type": "array"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/TklDeckPart"
      },
      "title": "Parts",
      "type": "array"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/TklDeckPoint"
      },
      "title": "Points",
      "type": "array"
    },
    "one_line": {
      "default": false,
      "description": "Stationen har en linje: spårknappar (SD12).",
      "title": "One Line",
      "type": "boolean"
    },
    "tile": {
      "default": 1,
      "description": "En ruta i utsnittet, i spårplanens rutor.",
      "exclusiveMinimum": 0,
      "title": "Tile",
      "type": "number"
    },
    "tile_origin": {
      "default": [
        0,
        0
      ],
      "description": "Där utsnittets rutor börjar, i spårplanens rutor.",
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Tile Origin",
      "type": "array"
    },
    "plan": {
      "default": [
        0,
        0
      ],
      "description": "Spårplanens storlek i rutor.",
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Plan",
      "type": "array"
    },
    "pedals": {
      "description": "Pedalernas funktioner (SD55): inget förval, ingenting förrän ägaren väljer.",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/TklDeckKey"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Pedals",
      "type": "array"
    },
    "part": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Delen profilen är för: rangerarens deck, läget Bangård (#87 del d).",
      "title": "Part"
    }
  },
  "required": [
    "grid",
    "style"
  ],
  "type": "object"
}
