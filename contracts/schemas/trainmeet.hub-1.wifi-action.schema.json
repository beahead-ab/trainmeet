{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.hub-1.wifi-action.schema.json",
  "title": "trainmeet.hub-1.wifi-action",
  "additionalProperties": true,
  "description": "Det övriga: sök (interface), ta bort (uuid), ordning (uuids), anslut nu (uuid och\ninterface), behåll eller återställ (token).",
  "properties": {
    "uuid": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uuid"
    },
    "uuids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uuids"
    },
    "interface": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interface"
    },
    "token": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token"
    }
  },
  "type": "object"
}
