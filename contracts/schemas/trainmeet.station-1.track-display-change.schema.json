{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.station-1.track-display-change.schema.json",
  "title": "trainmeet.station-1.track-display-change",
  "$defs": {
    "TrackShown": {
      "additionalProperties": true,
      "properties": {
        "track": {
          "description": "Spårets namn i planen, som tågbesöken använder.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Track",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "track"
      ],
      "title": "TrackShown",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "PUT /api/station/1/places/{place}/track-display med nyckeln. Every current track exactly\nonce, in the new order; without tracks the meet's own order comes back (Återställ). A\nrevision other than the current one is refused, so no one's choice is overwritten.",
  "properties": {
    "revision": {
      "description": "Revisionen klienten läste.",
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "tracks": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TrackShown"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tracks"
    }
  },
  "required": [
    "revision"
  ],
  "type": "object"
}
