{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.token-owner.schema.json",
  "title": "trainmeet.id-1.token-owner",
  "$defs": {
    "TokenOwnerKind": {
      "description": "Vems saldo (TK1): personens, för egna fordon och moduler, eller klubbens, för\nträffarnas import (TK16).",
      "enum": [
        "person",
        "club"
      ],
      "title": "TokenOwnerKind",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "kind": {
      "$ref": "#/$defs/TokenOwnerKind"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "type": "object"
}
