{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.interlocking-answer.schema.json",
  "title": "trainmeet.tkl-1.interlocking-answer",
  "$defs": {
    "Action": {
      "enum": [
        "train.lookup",
        "train.track.change",
        "train.departed",
        "train.arrived",
        "train.position.set",
        "train.crew_ready.set",
        "train.set_aside",
        "clearance.request",
        "clearance.response",
        "clearance.cancel",
        "line.available.publish",
        "line.available.acknowledge",
        "section.occupancy",
        "signal.exit",
        "place.leave",
        "place.take_back"
      ],
      "title": "Action",
      "type": "string"
    },
    "ExitSignalAspect": {
      "enum": [
        "stop",
        "proceed",
        "unknown"
      ],
      "title": "ExitSignalAspect",
      "type": "string"
    },
    "PanelFunctionType": {
      "description": "The panel functions' catalogue. New functions are added here for all (STD-19).",
      "enum": [
        "signal_stop",
        "local_release",
        "traction_current",
        "out_of_service",
        "emergency_release",
        "turntable",
        "programming_track"
      ],
      "title": "PanelFunctionType",
      "type": "string"
    },
    "Position": {
      "description": "A switch's two positions. + is straight (rakt), - is diverging (avvikande).",
      "enum": [
        "+",
        "-"
      ],
      "title": "Position",
      "type": "string"
    },
    "RouteKind": {
      "enum": [
        "train",
        "shunting"
      ],
      "title": "RouteKind",
      "type": "string"
    },
    "SwitchControl": {
      "description": "Who lays the switch. Only TKL's switches have a lever, and no route crosses another.",
      "enum": [
        "tkl",
        "manual",
        "planned",
        "not_laid"
      ],
      "title": "SwitchControl",
      "type": "string"
    },
    "TklAspect": {
      "description": "What a signal shows. A combined signal shows SHUNT with the dwarf part (STV-24).",
      "enum": [
        "stop",
        "proceed",
        "shunt",
        "local"
      ],
      "title": "TklAspect",
      "type": "string"
    },
    "TklExitShown": {
      "additionalProperties": true,
      "description": "A line exit: the line's pieces outside the entry signal, which belong to the line and\nnever turn green with a route (STV-54), and what goes up to Hubben as signal.exit.",
      "properties": {
        "exit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Exit",
          "type": "string"
        },
        "outside": {
          "description": "Utfartens id i utsidan.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Outside",
          "type": "string"
        },
        "pieces": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        },
        "aspect": {
          "$ref": "#/$defs/ExitSignalAspect",
          "default": "stop"
        }
      },
      "required": [
        "exit",
        "outside"
      ],
      "title": "TklExitShown",
      "type": "object"
    },
    "TklFunctionMode": {
      "additionalProperties": true,
      "description": "One of a function's positions: a traction current's mode, or a turntable's track.",
      "properties": {
        "value": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "TklFunctionMode",
      "type": "object"
    },
    "TklFunctionShown": {
      "additionalProperties": true,
      "description": "A panel function from the catalogue (STV-04) with its state of the moment: what the\npanel draws and what is saved with the interlocking. The parameters are the model's.",
      "properties": {
        "name": {
          "description": "Funktionens namn, som i stationsmodellen. Unikt i stationen.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/PanelFunctionType"
        },
        "on": {
          "default": false,
          "description": "Inkopplad: signalstopp, lokal frigivning, ur drift eller programmeringsspår.",
          "title": "On",
          "type": "boolean"
        },
        "mode": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Körströmmens läge, eller spåret vändskivans brygga står mot.",
          "title": "Mode"
        },
        "modes": {
          "description": "Lägena att välja.",
          "items": {
            "$ref": "#/$defs/TklFunctionMode"
          },
          "title": "Modes",
          "type": "array"
        },
        "pieces": {
          "description": "Spårbitarna funktionen gäller: området eller spåret.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        },
        "signals": {
          "description": "Signalerna i stopp, eller som visar växling.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "blocked": {
          "description": "Infartssignalerna som spärras medan området är lokalt frigivet (FR41).",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Blocked",
          "type": "array"
        },
        "switches": {
          "description": "De lokala växlarna, som läggs med knappar på modulerna.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Switches",
          "type": "array"
        },
        "locked": {
          "additionalProperties": {
            "$ref": "#/$defs/Position"
          },
          "description": "Skyddsväxlarnas spakar och läget de låses i.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Locked",
          "type": "object"
        },
        "at": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Noden knappen hör till i spårplanen.",
          "title": "At"
        },
        "codes": {
          "additionalProperties": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "description": "Knappens kod per skal, till exempel L01 i 95.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Codes",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "TklFunctionShown",
      "type": "object"
    },
    "TklHappening": {
      "additionalProperties": true,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "at",
        "text"
      ],
      "title": "TklHappening",
      "type": "object"
    },
    "TklInterlocking": {
      "additionalProperties": true,
      "description": "Ställverkets läge i stunden (STV-08): everything the panel draws, kept with the station\nso that a restart keeps it. Never the model, the clearance or the timetable (STV-09).",
      "properties": {
        "station_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Station Id",
          "type": "string"
        },
        "level": {
          "maximum": 3,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "model": {
          "description": "Stationsmodellens fingeravtryck: läget gäller den.",
          "title": "Model",
          "type": "string"
        },
        "revision": {
          "description": "Räknar upp vid varje ändring; väntan följer den.",
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "problem": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Läget gäller inte stationsmodellen: allt utom nollställning nekas.",
          "title": "Problem"
        },
        "switches": {
          "additionalProperties": {
            "$ref": "#/$defs/TklSwitchShown"
          },
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Switches",
          "type": "object"
        },
        "levers": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Position"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Spakarnas lägen; inget när spakens växlar ligger i kors.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Levers",
          "type": "object"
        },
        "turntables": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Spåret vändskivans brygga står mot.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Turntables",
          "type": "object"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/TklSetRoute"
          },
          "title": "Routes",
          "type": "array"
        },
        "trains": {
          "items": {
            "$ref": "#/$defs/TklTrain"
          },
          "title": "Trains",
          "type": "array"
        },
        "signals": {
          "additionalProperties": {
            "$ref": "#/$defs/TklSignalShown"
          },
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Signals",
          "type": "object"
        },
        "pieces": {
          "additionalProperties": {
            "$ref": "#/$defs/TklPieceShown"
          },
          "description": "Spårbitar som inte är lediga.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Pieces",
          "type": "object"
        },
        "numbers": {
          "items": {
            "$ref": "#/$defs/TklNumber"
          },
          "title": "Numbers",
          "type": "array"
        },
        "exits": {
          "items": {
            "$ref": "#/$defs/TklExitShown"
          },
          "title": "Exits",
          "type": "array"
        },
        "tracks": {
          "additionalProperties": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "description": "Sektionerna på stationsspåren, med spårets namn: där ett tåg kan sättas ut.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Tracks",
          "type": "object"
        },
        "sections": {
          "additionalProperties": {
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "description": "Sektionerna med sina spårbitar: där 59 har sina lampor, en till fyra per spårledning, och avbrotten mellan spårledningarna.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Sections",
          "type": "object"
        },
        "functions": {
          "description": "Panelfunktionerna ur katalogen, med sitt läge (STV-04, STV-53).",
          "items": {
            "$ref": "#/$defs/TklFunctionShown"
          },
          "title": "Functions",
          "type": "array"
        },
        "events": {
          "description": "Senaste först.",
          "items": {
            "$ref": "#/$defs/TklHappening"
          },
          "title": "Events",
          "type": "array"
        },
        "last_id": {
          "default": 0,
          "description": "Det senaste id:t för en väg eller ett tåg.",
          "minimum": 0,
          "title": "Last Id",
          "type": "integer"
        }
      },
      "required": [
        "station_id",
        "level",
        "model",
        "revision"
      ],
      "title": "TklInterlocking",
      "type": "object"
    },
    "TklNumber": {
      "additionalProperties": true,
      "description": "Var ett tågnummer står (STV-06, STV-21): the section or the exit, its pieces, and the\nstation track when the section is on one, where the track's name is hidden (STV-57).",
      "properties": {
        "number": {
          "anyOf": [
            {
              "pattern": "^[0-9A-Za-z]{1,8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "train": {
          "minimum": 1,
          "title": "Train",
          "type": "integer"
        },
        "colour": {
          "$ref": "#/$defs/TklNumberColour"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "exit": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "pieces": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stationsspåret, med modellens namn.",
          "title": "Track"
        },
        "route": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "estimated": {
          "default": true,
          "description": "Numret följer knapparna, inte detekteringen: en uppskattad position.",
          "title": "Estimated",
          "type": "boolean"
        }
      },
      "required": [
        "train",
        "colour"
      ],
      "title": "TklNumber",
      "type": "object"
    },
    "TklNumberColour": {
      "enum": [
        "red",
        "green"
      ],
      "title": "TklNumberColour",
      "type": "string"
    },
    "TklPieceShown": {
      "additionalProperties": true,
      "properties": {
        "state": {
          "$ref": "#/$defs/TklPieceState"
        },
        "route": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        }
      },
      "required": [
        "state"
      ],
      "title": "TklPieceShown",
      "type": "object"
    },
    "TklPieceState": {
      "enum": [
        "train",
        "shunting",
        "occupied",
        "local",
        "out_of_service",
        "programming"
      ],
      "title": "TklPieceState",
      "type": "string"
    },
    "TklReport": {
      "additionalProperties": true,
      "description": "Vad ställverket rapporterar upp till Hubben (STV-10), and how it went.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TklReportKind"
        },
        "train_number": {
          "anyOf": [
            {
              "pattern": "^[0-9A-Za-z]{1,8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Number"
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        },
        "exit": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Utfartens id i utsidan.",
          "title": "Exit"
        },
        "track": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stationsspårets id i utsidan.",
          "title": "Track"
        },
        "aspect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitSignalAspect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/Action"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Kommandot som skickades."
        },
        "sent": {
          "default": false,
          "title": "Sent",
          "type": "boolean"
        },
        "accepted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "kind"
      ],
      "title": "TklReport",
      "type": "object"
    },
    "TklReportKind": {
      "enum": [
        "departed",
        "arrived",
        "exit_signal"
      ],
      "title": "TklReportKind",
      "type": "string"
    },
    "TklSectionPart": {
      "additionalProperties": true,
      "description": "A section of a set route, in the order the route runs through it: a track circuit, or\nwhere the model has none, the pieces between two switches, signals or ends (spårdel). It\nis released behind the train, one at a time (STV-29).",
      "properties": {
        "section": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "pieces": {
          "description": "Vägens spårbitar i delen, i färdriktningen.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pieces",
          "type": "array"
        },
        "released": {
          "default": false,
          "title": "Released",
          "type": "boolean"
        }
      },
      "required": [
        "section",
        "pieces"
      ],
      "title": "TklSectionPart",
      "type": "object"
    },
    "TklSetRoute": {
      "additionalProperties": true,
      "description": "Lagd väg: a train route or shunting route the interlocking has set and locked.",
      "properties": {
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/RouteKind"
        },
        "start": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Start",
          "type": "string"
        },
        "end": {
          "maxLength": 80,
          "minLength": 1,
          "title": "End",
          "type": "string"
        },
        "chain": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Den sammansatta vägens första del, när vägen är en del av en (TKL53).",
          "title": "Chain"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/TklSectionPart"
          },
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        },
        "positions": {
          "additionalProperties": {
            "$ref": "#/$defs/Position"
          },
          "description": "Växlarna vägen lägger: sina egna, de kopplade och de som dras med (TKL104).",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Positions",
          "type": "object"
        },
        "locked": {
          "additionalProperties": {
            "$ref": "#/$defs/Position"
          },
          "description": "Växlarna vägen fortfarande låser.",
          "propertyNames": {
            "maxLength": 80,
            "minLength": 1
          },
          "title": "Locked",
          "type": "object"
        },
        "protection": {
          "description": "Växlar vägen låser utan att gå över dem, som spakens andra halva (skyddsväxlar, STV-20).",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Protection",
          "type": "array"
        },
        "crossings": {
          "description": "Korsningar och korsningsväxlar vägen håller.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Crossings",
          "type": "array"
        },
        "turntable": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vändskivans spår som bryggan står mot, medan vägen håller.",
          "title": "Turntable"
        },
        "train": {
          "anyOf": [
            {
              "type": "integer"
