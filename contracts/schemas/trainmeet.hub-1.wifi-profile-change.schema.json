{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.hub-1.wifi-profile-change.schema.json",
  "title": "trainmeet.hub-1.wifi-profile-change",
  "additionalProperties": true,
  "description": "Spara ett nät. Utan lösenord behålls det sparade, om SSID och säkerhet är desamma.",
  "properties": {
    "uuid": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uuid"
    },
    "ssid": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Ssid",
      "type": "string"
    },
    "security": {
      "enum": [
        "open",
        "wpa2",
        "wpa3"
      ],
      "title": "Security",
      "type": "string"
    },
    "password": {
      "default": "",
      "description": "Skrivs aldrig ut.",
      "maxLength": 63,
      "title": "Password",
      "type": "string"
    },
    "hidden": {
      "default": false,
      "title": "Hidden",
      "type": "boolean"
    }
  },
  "required": [
    "ssid",
    "security"
  ],
  "type": "object"
}
