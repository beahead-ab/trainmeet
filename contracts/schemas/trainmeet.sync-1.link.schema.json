{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.sync-1.link.schema.json",
  "title": "trainmeet.sync-1.link",
  "$defs": {
    "Hello": {
      "additionalProperties": true,
      "description": "Vem som ringer: hubben, dess program och de versioner av protokollet den talar.",
      "properties": {
        "protocols": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Protocols",
          "type": "array"
        },
        "hub_id": {
          "description": "Hubbens id: slumpat vid första start, inte hemligt.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Hub Id",
          "type": "string"
        },
        "hub_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Hub Name",
          "type": "string"
        },
        "software": {
          "description": "Hubbens programversion, till exempel 0.1.0.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Software",
          "type": "string"
        }
      },
      "required": [
        "hub_id",
        "hub_name",
        "software"
      ],
      "title": "Hello",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Molnets svar: träffen Pi:n nu följer och dess nyckel, som bara ges här, en gång.",
  "properties": {
    "meet": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Meet",
      "type": "string"
    },
    "meet_name": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Meet Name",
      "type": "string"
    },
    "key": {
      "description": "Pi:ns nyckel mot molnet. Skrivs aldrig ut.",
      "maxLength": 500,
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "hello": {
      "$ref": "#/$defs/Hello",
      "description": "Molnets hälsning."
    }
  },
  "required": [
    "meet",
    "meet_name",
    "key",
    "hello"
  ],
  "type": "object"
}
