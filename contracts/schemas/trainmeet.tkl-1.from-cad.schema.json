{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.tkl-1.from-cad.schema.json",
  "title": "trainmeet.tkl-1.from-cad",
  "$defs": {
    "Scale": {
      "description": "The module's scale (CAD10, CAD12).",
      "enum": [
        "H0",
        "N",
        "0"
      ],
      "title": "Scale",
      "type": "string"
    },
    "StationUse": {
      "additionalProperties": true,
      "description": "Används i: a station in TKL that took an assembly or a module into use, as Studio told CAD\nwhen the owner confirmed it (CAD-15). The station's id is TKL's, the station's own.",
      "properties": {
        "station_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Station Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "description": "The assembly's revision, or the module's version.",
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "station_id",
        "name",
        "revision",
        "at"
      ],
      "title": "StationUse",
      "type": "object"
    },
    "StudioModule": {
      "additionalProperties": true,
      "description": "A module in what Studio gets: its id is the prefix of its ids in the graph.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "number": {
          "pattern": "^M-\\d{3,}$",
          "title": "Number",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "number",
        "name",
        "version"
      ],
      "title": "StudioModule",
      "type": "object"
    },
    "StudioSource": {
      "additionalProperties": true,
      "description": "Från CAD: an assembly or a single module the person may connect to a station.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/StudioSourceKind"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/Scale"
        },
        "owner": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "revision": {
          "description": "The assembly's revision, or the module's version.",
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/StudioModule"
          },
          "title": "Modules",
          "type": "array"
        },
        "ready": {
          "description": "It may go to Studio: no problems.",
          "title": "Ready",
          "type": "boolean"
        },
        "problems": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Problems",
          "type": "array"
        },
        "stations": {
          "description": "Används i.",
          "items": {
            "$ref": "#/$defs/StationUse"
          },
          "title": "Stations",
          "type": "array"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "scale",
        "owner",
        "revision",
        "ready",
        "changed_at"
      ],
      "title": "StudioSource",
      "type": "object"
    },
    "StudioSourceKind": {
      "description": "What Studio's Från CAD connects to a station: a group of modules (STUDIO-03).",
      "enum": [
        "assembly",
        "module"
      ],
      "title": "StudioSourceKind",
      "type": "string"
    },
    "TklCadImage": {
      "additionalProperties": true,
      "description": "A module's measuring image from TrainMeet CAD, kept with the station so that Foto shows it\nwithout internet (#89 del d4, CAD-13, CAD-33). matrix, SVG's (a, b, c, d, e, f), takes the\nimage's pixels ((0, 0) its top left corner, y down) to the station's real geometry in mm,\nwhich is the source's in CAD (contracts.cad.StudioImage.to_source); outline is the board,\nwhich the image is clipped to.",
      "properties": {
        "module": {
          "format": "uuid",
          "title": "Module",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "job": {
          "description": "The photo it came from: a new photo is a new image.",
          "format": "uuid",
          "title": "Job",
          "type": "string"
        },
        "title": {
          "description": "\"M-002 Linje\".",
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "matrix": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Matrix",
          "type": "array"
        },
        "outline": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Outline",
          "type": "array"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TKL:s egen adress till bilden, i TklImageUnder.",
          "title": "Url"
        }
      },
      "required": [
        "module",
        "version",
        "job",
        "title",
        "width",
        "height",
        "matrix",
        "outline",
        "bytes"
      ],
      "title": "TklCadImage",
      "type": "object"
    },
    "TklCadLink": {
      "additionalProperties": true,
      "description": "The group of modules in TrainMeet CAD a station's track plan comes from: an assembly or a\nsingle module, at a revision. registered: CAD knows the station uses it (Används i).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/StudioSourceKind"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "registered": {
          "default": false,
          "title": "Registered",
          "type": "boolean"
        },
        "modules": {
          "additionalProperties": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "description": "Its modules by id, as the owner sees them: \"M-002 Linje\". A re-import says which module a piece that is gone was on.",
          "title": "Modules",
          "type": "object"
        },
        "images": {
          "description": "The modules' measuring images for Foto, kept with the station (part d4).",
          "items": {
            "$ref": "#/$defs/TklCadImage"
          },
          "title": "Images",
          "type": "array"
        },
        "missing": {
          "description": "The modules without one, and why: \"M-002 Linje: Modulen är inte fotad …\".",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "gauge": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The source's gauge in mm, for the rails over the images.",
          "title": "Gauge"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "revision"
      ],
      "title": "TklCadLink",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Från CAD i Studio: whether the way in is open here and why not, the person's assemblies and\napproved modules in TrainMeet CAD, and the one the station is linked to. TKL asks CAD for the\nperson with the person's access token from ID, as Ladda upp ritning; CAD never makes a\nstation (TKL8, CAD-15).",
  "properties": {
    "available": {
      "title": "Available",
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Varför vägen in är grå.",
      "title": "Reason"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/StudioSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "link": {
      "anyOf": [
        {
          "$ref": "#/$defs/TklCadLink"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The station's, in use."
    },
    "pending": {
      "anyOf": [
        {
          "$ref": "#/$defs/TklCadLink"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The draft's, until Använd ritningen."
    }
  },
  "required": [
    "available"
  ],
  "type": "object"
}
