{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.account-export.schema.json",
  "title": "trainmeet.id-1.account-export",
  "$defs": {
    "Account": {
      "additionalProperties": true,
      "description": "The person who is logged in, as ID knows them.",
      "properties": {
        "id": {
          "description": "The account's id, the same in every app (the token's sub).",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "initials": {
          "maxLength": 3,
          "minLength": 1,
          "title": "Initials",
          "type": "string"
        },
        "email": {
          "description": "Verified by the code to it (KONTO-10).",
          "maxLength": 254,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "initials",
        "email"
      ],
      "title": "Account",
      "type": "object"
    },
    "CatalogExport": {
      "additionalProperties": true,
      "description": "Everything Catalog holds for one owner, for the file the person fetches before removing the\naccount (KONTO-31, ID7). Only TrainMeet ID asks, with a token of its own.",
      "properties": {
        "owner": {
          "format": "uuid",
          "title": "Owner",
          "type": "string"
        },
        "vehicles": {
          "items": {
            "$ref": "#/$defs/Vehicle"
          },
          "title": "Vehicles",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/VehicleHistory"
          },
          "title": "History",
          "type": "array"
        },
        "places": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "title": "Places",
          "type": "array"
        },
        "settings": {
          "$ref": "#/$defs/OwnerSettings"
        }
      },
      "required": [
        "owner",
        "vehicles",
        "history",
        "places",
        "settings"
      ],
      "title": "CatalogExport",
      "type": "object"
    },
    "Club": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ClubRole",
          "description": "The person's role in the club."
        }
      },
      "required": [
        "id",
        "name",
        "role"
      ],
      "title": "Club",
      "type": "object"
    },
    "ClubRole": {
      "description": "A person's role in a club (KONTO-35).",
      "enum": [
        "admin",
        "member"
      ],
      "title": "ClubRole",
      "type": "string"
    },
    "DccFunction": {
      "additionalProperties": true,
      "description": "A locomotive's function: F0 light, F2 horn ... (CAT-66).",
      "properties": {
        "number": {
          "maximum": 68,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "name": {
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "number",
        "name"
      ],
      "title": "DccFunction",
      "type": "object"
    },
    "EvnParts": {
      "additionalProperties": true,
      "description": "The EVN read from the number (CAT-57). Derived every time, never stored.",
      "properties": {
        "text": {
          "description": "For example 21 74 245 2 253-0, with the computed check digit.",
          "title": "Text",
          "type": "string"
        },
        "interop": {
          "title": "Interop",
          "type": "string"
        },
        "country": {
          "title": "Country",
          "type": "string"
        },
        "country_letters": {
          "description": "For example S for 74. Empty when unknown.",
          "title": "Country Letters",
          "type": "string"
        },
        "serial": {
          "title": "Serial",
          "type": "string"
        },
        "check": {
          "title": "Check",
          "type": "integer"
        },
        "given": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The painted check digit, or null when not painted.",
          "title": "Given"
        },
        "valid": {
          "description": "False only when the painted check digit is wrong (CAT-59).",
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "interop",
        "country",
        "country_letters",
        "serial",
        "check",
        "given",
        "valid"
      ],
      "title": "EvnParts",
      "type": "object"
    },
    "FieldSource": {
      "description": "Where a core field's value came from (CAT-64).",
      "enum": [
        "owner",
        "ai",
        "prototype",
        "import"
      ],
      "title": "FieldSource",
      "type": "string"
    },
    "Grant": {
      "additionalProperties": true,
      "description": "A role someone has for a resource.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "person": {
          "$ref": "#/$defs/Person"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "person",
        "role",
        "resource",
        "at"
      ],
      "title": "Grant",
      "type": "object"
    },
    "Invitation": {
      "additionalProperties": true,
      "description": "An invitation to a club (KONTO-35) or to a shared fleet (KONTO-29). Gives nothing\nuntil the person it was sent to has said yes.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "title": {
          "description": "What it is about: the club's name, or whose fleet.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "sent_to": {
          "description": "The address, partly hidden to anyone but its owner.",
          "title": "Sent To",
          "type": "string"
        },
        "sent_by": {
          "$ref": "#/$defs/Person"
        },
        "state": {
          "$ref": "#/$defs/InvitationState"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "resource",
        "role",
        "title",
        "sent_to",
        "sent_by",
        "state",
        "at"
      ],
      "title": "Invitation",
      "type": "object"
    },
    "InvitationState": {
      "enum": [
        "waiting",
        "accepted",
        "declined"
      ],
      "title": "InvitationState",
      "type": "string"
    },
    "Lending": {
      "additionalProperties": true,
      "description": "Who has the vehicle: the owner's own note (CAT-74, CAT-75).",
      "properties": {
        "to": {
          "maxLength": 500,
          "minLength": 1,
          "title": "To",
          "type": "string"
        },
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        }
      },
      "required": [
        "to",
        "since"
      ],
      "title": "Lending",
      "type": "object"
    },
    "Meet": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "club": {
          "format": "uuid",
          "title": "Club",
          "type": "string"
        },
        "club_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Club Name",
          "type": "string"
        },
        "roles": {
          "description": "The person's own roles at the meet.",
          "items": {
            "$ref": "#/$defs/MeetRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "club_admin": {
          "default": false,
          "description": "The person is the club's admin, with the admin's say at its meets (KONTO-36). The Hub plans the meet then, as it does for the organizer (#78).",
          "title": "Club Admin",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "starts_on",
        "ends_on",
        "id",
        "club",
        "club_name",
        "roles"
      ],
      "title": "Meet",
      "type": "object"
    },
    "MeetRole": {
      "description": "The roles per meet that ID hands out until the Hub logs in with ID (ID10, KONTO-28).",
      "enum": [
        "organizer",
        "publisher",
        "reader",
        "dispatcher",
        "loco_lead",
        "remote_clearer"
      ],
      "title": "MeetRole",
      "type": "string"
    },
    "Notice": {
      "additionalProperties": true,
      "description": "Någon sa till: where someone saw the vehicle, without who said it (CAT-113).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "at"
      ],
      "title": "Notice",
      "type": "object"
    },
    "OwnerSettings": {
      "additionalProperties": true,
      "description": "Visa mitt namn när någon blippar mina fordon: off from the start (CAT-101).",
      "properties": {
        "show_name": {
          "default": false,
          "title": "Show Name",
          "type": "boolean"
        }
      },
      "title": "OwnerSettings",
      "type": "object"
    },
    "Person": {
      "additionalProperties": true,
      "description": "Someone else, as a member or someone with a role: never their address.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "initials": {
          "maxLength": 3,
          "minLength": 1,
          "title": "Initials",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "initials"
      ],
      "title": "Person",
      "type": "object"
    },
    "Place": {
      "additionalProperties": true,
      "description": "A named place at home: a box or a shelf (CAT-71).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "vehicles_home": {
          "description": "How many vehicles are at home here now.",
          "title": "Vehicles Home",
          "type": "integer"
        },
        "vehicles": {
          "description": "How many vehicles live here, wherever they are now.",
          "title": "Vehicles",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "vehicles_home",
        "vehicles"
      ],
      "title": "Place",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": true,
      "description": "One thing a role applies to: its kind and its id in the app that owns it.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Resource",
      "type": "object"
    },
    "ResourceKind": {
      "description": "What a role applies to (KONTO-03). ID only holds the reference, never the thing.",
      "enum": [
        "club",
        "fleet",
        "meet",
        "station",
        "module",
        "hub",
        "catalog"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "Role": {
      "description": "The roles ID holds on one place (KONTO-28, KONTO-30, CAT-44, KONTO-35).",
      "enum": [
        "admin",
        "member",
        "organizer",
        "publisher",
        "reader",
        "dispatcher",
        "loco_lead",
        "remote_clearer",
        "reviewer",
        "viewer",
        "editor"
      ],
      "title": "Role",
      "type": "string"
    },
    "TagKind": {
      "description": "An NFC tag, a QR label or a simulated tag (CAT-78, CAT-96, CAT-121).",
      "enum": [
        "nfc",
        "qr",
        "sim"
      ],
      "title": "TagKind",
      "type": "string"
    },
    "TokenBalance": {
      "additionalProperties": true,
      "description": "Saldot som det ser ut nu (TOKEN-01, TOKEN-12).",
      "properties": {
        "owner": {
          "$ref": "#/$defs/TokenOwner"
        },
        "title": {
          "description": "Vems saldo, som det visas: personens namn eller klubbens.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "free_left": {
          "description": "Det som är kvar av månadens gratiskvot. Sparas inte till nästa månad.",
          "minimum": 0,
          "title": "Free Left",
          "type": "integer"
        },
        "free_monthly": {
          "description": "Månadens gratiskvot: 100 per person, 300 per klubb.",
          "minimum": 0,
          "title": "Free Monthly",
          "type": "integer"
        },
        "bought": {
          "description": "Köpta tokens som är kvar. De förfaller inte.",
          "minimum": 0,
          "title": "Bought",
          "type": "integer"
        },
        "reserved": {
          "description": "Hålls av reservationer som inte är dragna eller tillbakalämnade än.",
          "minimum": 0,
          "title": "Reserved",
          "type": "integer"
        },
        "available": {
          "description": "Det som går att använda nu: gratis och köpt.",
          "minimum": 0,
          "title": "Available",
          "type": "integer"
        },
        "month": {
          "description": "Månaden gratiskvoten gäller, i svensk tid.",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "title": "Month",
          "type": "string"
        },
        "own_ai": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Modellen i kontots egen AI, om den är inkopplad: då dras inga AI-tokens.",
          "title": "Own Ai"
        }
      },
      "required": [
        "owner",
        "title",
        "free_left",
        "free_monthly",
        "bought",
        "reserved",
        "available",
        "month"
      ],
      "title": "TokenBalance",
      "type": "object"
    },
    "TokenOwner": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "$ref": "#/$defs/TokenOwnerKind"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "TokenOwner",
      "type": "object"
    },
    "TokenOwnerKind": {
      "description": "Vems saldo (TK1): personens, för egna fordon och moduler, eller klubbens, för\nträffarnas import (TK16).",
      "enum": [
        "person",
        "club"
      ],
      "title": "TokenOwnerKind",
      "type": "string"
    },
    "Vehicle": {
      "additionalProperties": true,
      "description": "A vehicle as its owner sees it.",
      "properties": {
        "status": {
          "$ref": "#/$defs/VehicleStatus",
          "default": "draft"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/VehicleKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "litt": {
          "default": "",
          "maxLength": 80,
          "title": "Litt",
          "type": "string"
        },
        "number": {
          "default": "",
          "description": "As painted: leading zeros, spaces, dashes kept.",
          "maxLength": 80,
          "title": "Number",
          "type": "string"
        },
        "operator": {
          "default": "",
          "description": "The operator as text. No logos (CAT-61).",
          "maxLength": 80,
          "title": "Operator",
          "type": "string"
        },
        "epoch": {
          "default": "",
          "maxLength": 12,
          "title": "Epoch",
          "type": "string"
        },
        "scale": {
          "default": "",
          "maxLength": 12,
          "title": "Scale",
          "type": "string"
        },
        "maker": {
          "default": "",
          "description": "The model's maker.",
          "maxLength": 80,
          "title": "Maker",
          "type": "string"
        },
        "article_number": {
          "default": "",
          "maxLength": 80,
          "title": "Article Number",
          "type": "string"
        },
        "note": {
          "default": "",
          "description": "Private. Never in a mini card or an export to others (CAT-191).",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        },
        "dcc_address": {
          "default": "",
          "description": "Locomotives and multiple units: the DCC address as text.",
          "maxLength": 8,
          "title": "Dcc Address",
          "type": "string"
        },
        "functions": {
          "items": {
            "$ref": "#/$defs/DccFunction"
          },
          "maxItems": 69,
          "title": "Functions",
          "type": "array"
        },
        "place": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The place at home.",
          "title": "Place"
        },
        "id": {
          "description": "Permanent, never reused, kept when the tag changes (CAT-52).",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/VehicleState"
        },
        "place_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Name"
        },
        "lending": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lending"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evn": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvnParts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field_sources": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldSource"
          },
          "title": "Field Sources",
          "type": "object"
        },
        "tags": {
          "description": "At most one NFC, one QR. Only the owner sees them.",
          "items": {
            "$ref": "#/$defs/VehicleTag"
          },
          "title": "Tags",
          "type": "array"
        },
        "tagged": {
          "default": false,
          "description": "The vehicle has a tag: what someone it is shared with sees (CAT-47).",
          "title": "Tagged",
          "type": "boolean"
        },
        "notices": {
          "description": "Newest first.",
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Notices",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "state",
        "created_at",
        "updated_at"
      ],
      "title": "Vehicle",
      "type": "object"
    },
    "VehicleEvent": {
      "additionalProperties": true,
      "description": "A change of state or place, with its time. Only the owner sees them (CAT-77).",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/VehicleState"
        },
        "place_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Name"
        },
        "lent_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lent To"
        }
      },
      "required": [
        "at",
        "state"
      ],
      "title": "VehicleEvent",
      "type": "object"
    },
    "VehicleHistory": {
      "additionalProperties": true,
      "description": "One vehicle's events, in the file with the person's data.",
      "properties": {
        "vehicle": {
          "format": "uuid",
          "title": "Vehicle",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/VehicleEvent"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "vehicle",
        "events"
      ],
      "title": "VehicleHistory",
      "type": "object"
    },
    "VehicleKind": {
      "description": "The kinds of vehicle (CAT-54).",
      "enum": [
        "locomotive",
        "freight_wagon",
