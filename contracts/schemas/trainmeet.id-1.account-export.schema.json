{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.account-export.schema.json",
  "title": "trainmeet.id-1.account-export",
  "$defs": {
    "Account": {
      "additionalProperties": true,
      "description": "The person who is logged in, as ID knows them.",
      "properties": {
        "id": {
          "description": "The account's id, the same in every app (the token's sub).",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "initials": {
          "maxLength": 3,
          "minLength": 1,
          "title": "Initials",
          "type": "string"
        },
        "email": {
          "description": "Verified by the code to it (KONTO-10).",
          "maxLength": 254,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "initials",
        "email"
      ],
      "title": "Account",
      "type": "object"
    },
    "CatalogExport": {
      "additionalProperties": true,
      "description": "Everything Catalog holds for one owner: for the file the person fetches in TrainMeet ID\nbefore removing the account (KONTO-31, ID7), which only ID asks for, with a token of its\nown; and as catalog.json in the owner's account export, a ZIP with the pictures' files\nbeside it (CAT-188, GET /api/catalog/1/export). In the ZIP the vehicles' picture addresses\nare left out, since they expire (CAT-130): the pictures are files in the ZIP instead.",
      "properties": {
        "owner": {
          "format": "uuid",
          "title": "Owner",
          "type": "string"
        },
        "vehicles": {
          "description": "With their tags and their link to a prototype, its type data included.",
          "items": {
            "$ref": "#/$defs/Vehicle"
          },
          "title": "Vehicles",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/VehicleHistory"
          },
          "title": "History",
          "type": "array"
        },
        "places": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "title": "Places",
          "type": "array"
        },
        "settings": {
          "$ref": "#/$defs/OwnerSettings"
        },
        "trips": {
          "description": "The meets with their pack lists and ticks (#55).",
          "items": {
            "$ref": "#/$defs/Trip"
          },
          "title": "Trips",
          "type": "array"
        },
        "tags": {
          "description": "The owner's tags with their links and the owner's own events (CAT-93).",
          "items": {
            "$ref": "#/$defs/TagHistory"
          },
          "title": "Tags",
          "type": "array"
        },
        "pictures": {
          "description": "Only in the account export: the pictures, whose files are in the same ZIP (CAT-188). Empty in the file for TrainMeet ID.",
          "items": {
            "$ref": "#/$defs/ExportPicture"
          },
          "title": "Pictures",
          "type": "array"
        }
      },
      "required": [
        "owner",
        "vehicles",
        "history",
        "places",
        "settings"
      ],
      "title": "CatalogExport",
      "type": "object"
    },
    "Club": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ClubRole",
          "description": "The person's role in the club."
        }
      },
      "required": [
        "id",
        "name",
        "role"
      ],
      "title": "Club",
      "type": "object"
    },
    "ClubRole": {
      "description": "A person's role in a club (KONTO-35).",
      "enum": [
        "admin",
        "member"
      ],
      "title": "ClubRole",
      "type": "string"
    },
    "DccFunction": {
      "additionalProperties": true,
      "description": "A locomotive's function: F0 light, F2 horn ... (CAT-66).",
      "properties": {
        "number": {
          "maximum": 68,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "name": {
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "number",
        "name"
      ],
      "title": "DccFunction",
      "type": "object"
    },
    "EvnParts": {
      "additionalProperties": true,
      "description": "The EVN read from the number (CAT-57). Derived every time, never stored.",
      "properties": {
        "text": {
          "description": "For example 21 74 245 2 253-0, with the computed check digit.",
          "title": "Text",
          "type": "string"
        },
        "interop": {
          "title": "Interop",
          "type": "string"
        },
        "country": {
          "title": "Country",
          "type": "string"
        },
        "country_letters": {
          "description": "For example S for 74. Empty when unknown.",
          "title": "Country Letters",
          "type": "string"
        },
        "serial": {
          "title": "Serial",
          "type": "string"
        },
        "check": {
          "title": "Check",
          "type": "integer"
        },
        "given": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The painted check digit, or null when not painted.",
          "title": "Given"
        },
        "valid": {
          "description": "False only when the painted check digit is wrong (CAT-59).",
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "interop",
        "country",
        "country_letters",
        "serial",
        "check",
        "given",
        "valid"
      ],
      "title": "EvnParts",
      "type": "object"
    },
    "ExportPicture": {
      "additionalProperties": true,
      "description": "A picture in the account export (CAT-188). Its files are in the same ZIP.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "vehicle": {
          "format": "uuid",
          "title": "Vehicle",
          "type": "string"
        },
        "main": {
          "title": "Main",
          "type": "boolean"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "width": {
          "description": "The display picture's width in pixels.",
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "description": "The display picture's height in pixels.",
          "title": "Height",
          "type": "integer"
        },
        "background": {
          "$ref": "#/$defs/PictureBackground"
        },
        "display": {
          "description": "The display picture's file in the ZIP (CAT-126).",
          "title": "Display",
          "type": "string"
        },
        "original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The original's file in the ZIP, only with Spara original.",
          "title": "Original"
        }
      },
      "required": [
        "id",
        "vehicle",
        "main",
        "position",
        "width",
        "height",
        "background",
        "display"
      ],
      "title": "ExportPicture",
      "type": "object"
    },
    "FieldProfile": {
      "description": "The field profiles from the start (CAT-158, C31).",
      "enum": [
        "SE",
        "EU",
        "US"
      ],
      "title": "FieldProfile",
      "type": "string"
    },
    "FieldSource": {
      "description": "Where a core field's value came from (CAT-64).",
      "enum": [
        "owner",
        "ai",
        "prototype",
        "import"
      ],
      "title": "FieldSource",
      "type": "string"
    },
    "Grant": {
      "additionalProperties": true,
      "description": "A role someone has for a resource.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "person": {
          "$ref": "#/$defs/Person"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "person",
        "role",
        "resource",
        "at"
      ],
      "title": "Grant",
      "type": "object"
    },
    "Invitation": {
      "additionalProperties": true,
      "description": "An invitation to a club (KONTO-35) or to a shared fleet (KONTO-29). Gives nothing\nuntil the person it was sent to has said yes.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "title": {
          "description": "What it is about: the club's name, or whose fleet.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "sent_to": {
          "description": "The address, partly hidden to anyone but its owner.",
          "title": "Sent To",
          "type": "string"
        },
        "sent_by": {
          "$ref": "#/$defs/Person"
        },
        "state": {
          "$ref": "#/$defs/InvitationState"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "resource",
        "role",
        "title",
        "sent_to",
        "sent_by",
        "state",
        "at"
      ],
      "title": "Invitation",
      "type": "object"
    },
    "InvitationState": {
      "enum": [
        "waiting",
        "accepted",
        "declined"
      ],
      "title": "InvitationState",
      "type": "string"
    },
    "Lending": {
      "additionalProperties": true,
      "description": "Who has the vehicle: the owner's own note (CAT-74, CAT-75).",
      "properties": {
        "to": {
          "maxLength": 500,
          "minLength": 1,
          "title": "To",
          "type": "string"
        },
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        }
      },
      "required": [
        "to",
        "since"
      ],
      "title": "Lending",
      "type": "object"
    },
    "Meet": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "club": {
          "format": "uuid",
          "title": "Club",
          "type": "string"
        },
        "club_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Club Name",
          "type": "string"
        },
        "roles": {
          "description": "The person's own roles at the meet.",
          "items": {
            "$ref": "#/$defs/MeetRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "club_admin": {
          "default": false,
          "description": "The person is the club's admin, with the admin's say at its meets (KONTO-36). The Hub plans the meet then, as it does for the organizer (#78).",
          "title": "Club Admin",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "starts_on",
        "ends_on",
        "id",
        "club",
        "club_name",
        "roles"
      ],
      "title": "Meet",
      "type": "object"
    },
    "MeetRole": {
      "description": "The roles per meet that ID hands out until the Hub logs in with ID (ID10, KONTO-28).",
      "enum": [
        "organizer",
        "publisher",
        "reader",
        "dispatcher",
        "loco_lead",
        "remote_clearer"
      ],
      "title": "MeetRole",
      "type": "string"
    },
    "Notice": {
      "additionalProperties": true,
      "description": "Någon sa till: where someone saw the vehicle, without who said it (CAT-113).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "at"
      ],
      "title": "Notice",
      "type": "object"
    },
    "OwnerSettings": {
      "additionalProperties": true,
      "description": "Visa mitt namn när någon blippar mina fordon: off from the start (CAT-101).",
      "properties": {
        "show_name": {
          "default": false,
          "title": "Show Name",
          "type": "boolean"
        }
      },
      "title": "OwnerSettings",
      "type": "object"
    },
    "Person": {
      "additionalProperties": true,
      "description": "Someone else, as a member or someone with a role: never their address.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "initials": {
          "maxLength": 3,
          "minLength": 1,
          "title": "Initials",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "initials"
      ],
      "title": "Person",
      "type": "object"
    },
    "PictureBackground": {
      "description": "The picture's background (CAT-128). All but the original need the background removal.",
      "enum": [
        "original",
        "white",
        "grey",
        "transparent",
        "rails"
      ],
      "title": "PictureBackground",
      "type": "string"
    },
    "PictureLinks": {
      "additionalProperties": true,
      "description": "The vehicle's main picture, for the lists and the card (CAT-125). Signed addresses that\nexpire (CAT-130): read the vehicle again for new ones.",
      "properties": {
        "thumb_url": {
          "description": "The thumbnail, at most 360×240 pixels (CAT-126).",
          "title": "Thumb Url",
          "type": "string"
        },
        "display_url": {
          "description": "The display picture, at most 1800 pixels (CAT-126).",
          "title": "Display Url",
          "type": "string"
        }
      },
      "required": [
        "thumb_url",
        "display_url"
      ],
      "title": "PictureLinks",
      "type": "object"
    },
    "Place": {
      "additionalProperties": true,
      "description": "A named place at home: a box or a shelf (CAT-71).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "vehicles_home": {
          "description": "How many vehicles are at home here now.",
          "title": "Vehicles Home",
          "type": "integer"
        },
        "vehicles": {
          "description": "How many vehicles live here, wherever they are now.",
          "title": "Vehicles",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "vehicles_home",
        "vehicles"
      ],
      "title": "Place",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": true,
      "description": "One thing a role applies to: its kind and its id in the app that owns it.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Resource",
      "type": "object"
    },
    "ResourceKind": {
      "description": "What a role applies to (KONTO-03). ID only holds the reference, never the thing.",
      "enum": [
        "club",
        "fleet",
        "meet",
        "station",
        "module",
        "hub",
        "catalog"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "Role": {
      "description": "The roles ID holds on one place (KONTO-28, KONTO-30, CAT-44, KONTO-35).",
      "enum": [
        "admin",
        "member",
        "organizer",
        "publisher",
        "reader",
        "dispatcher",
        "loco_lead",
        "remote_clearer",
        "reviewer",
        "viewer",
        "editor"
      ],
      "title": "Role",
      "type": "string"
    },
    "TagAssignment": {
      "additionalProperties": true,
      "description": "A link between a tag and one of the owner's vehicles, from start to end (CAT-81).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "vehicle": {
          "format": "uuid",
          "title": "Vehicle",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null while it is linked.",
          "title": "Ended At"
        }
      },
      "required": [
        "id",
        "vehicle",
        "started_at"
      ],
      "title": "TagAssignment",
      "type": "object"
    },
    "TagEvent": {
      "additionalProperties": true,
      "description": "A link or unlink the asker made (CAT-93).",
      "properties": {
        "event": {
          "$ref": "#/$defs/TagEventKind"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "vehicle_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vehicle Id"
        }
      },
      "required": [
        "event",
        "at",
        "vehicle_id"
      ],
      "title": "TagEvent",
      "type": "object"
    },
    "TagEventKind": {
      "enum": [
        "linked",
        "unlinked"
      ],
      "title": "TagEventKind",
      "type": "string"
    },
    "TagHistory": {
      "additionalProperties": true,
      "description": "One of the owner's tags in the owner's file (CAT-188, KONTO-31): its links to the owner's\nvehicles, and the events the owner made (CAT-93). Never another owner's links or events.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "uid": {
          "description": "What stands after /t/ in the address.",
          "title": "Uid",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TagKind"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "assignments": {
          "description": "Oldest first.",
          "items": {
            "$ref": "#/$defs/TagAssignment"
          },
          "title": "Assignments",
          "type": "array"
        },
        "events": {
          "description": "Oldest first.",
          "items": {
            "$ref": "#/$defs/TagEvent"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "id",
        "uid",
        "name",
        "kind",
        "address",
        "assignments",
        "events"
      ],
      "title": "TagHistory",
      "type": "object"
    },
    "TagKind": {
      "description": "An NFC tag, a QR label or a simulated tag (CAT-78, CAT-96, CAT-121).",
      "enum": [
        "nfc",
        "qr",
        "sim"
      ],
      "title": "TagKind",
      "type": "string"
    },
    "Tick": {
      "additionalProperties": true,
      "description": "A bock: one per vehicle and step, with its time (CAT-176).",
      "properties": {
        "step": {
          "$ref": "#/$defs/TripStep"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/TickBy"
        }
      },
      "required": [
        "step",
        "at",
        "by"
      ],
      "title": "Tick",
      "type": "object"
    },
    "TickBy": {
      "description": "How a tick was set (CAT-176).",
      "enum": [
        "tap",
        "press"
      ],
      "title": "TickBy",
      "type": "string"
    },
    "TokenBalance": {
      "additionalProperties": true,
      "description": "Saldot som det ser ut nu (TOKEN-01, TOKEN-12).",
      "properties": {
        "owner": {
          "$ref": "#/$defs/TokenOwner"
        },
        "title": {
          "description": "Vems saldo, som det visas: personens namn eller klubbens.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "free_left": {
          "description": "Det som är kvar av månadens gratiskvot. Sparas inte till nästa månad.",
          "minimum": 0,
          "title": "Free Left",
          "type": "integer"
        },
        "free_monthly": {
          "description": "Månadens gratiskvot: 100 per person, 300 per klubb.",
          "minimum": 0,
          "title": "Free Monthly",
          "type": "integer"
        },
        "bought": {
          "description": "Köpta tokens som är kvar. De förfaller inte.",
          "minimum": 0,
          "title": "Bought",
          "type": "integer"
        },
        "reserved": {
          "description": "Hålls av reservationer som inte är dragna eller tillbakalämnade än.",
          "minimum": 0,
          "title": "Reserved",
          "type": "integer"
        },
        "available": {
          "description": "Det som går att använda nu: gratis och köpt.",
          "minimum": 0,
          "title": "Available",
          "type": "integer"
        },
        "month": {
