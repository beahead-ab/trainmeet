{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.drift-1.now.schema.json",
  "title": "trainmeet.drift-1.now",
  "$defs": {
    "Clearance": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        },
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "from_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "From Place",
          "type": "string"
        },
        "to_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To Place",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClearanceStatus"
        },
        "departed": {
          "default": false,
          "title": "Departed",
          "type": "boolean"
        },
        "requested_at": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Requested At",
          "type": "string"
        },
        "reminders": {
          "default": 0,
          "description": "Påminnelser hittills (H39).",
          "minimum": 0,
          "title": "Reminders",
          "type": "integer"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "clearance_id",
        "call",
        "train_number",
        "section",
        "from_place",
        "to_place",
        "status",
        "requested_at",
        "revision"
      ],
      "title": "Clearance",
      "type": "object"
    },
    "ClearanceStatus": {
      "enum": [
        "waiting",
        "approved",
        "rejected",
        "cancelled",
        "invalidated"
      ],
      "title": "ClearanceStatus",
      "type": "string"
    },
    "Clock": {
      "additionalProperties": true,
      "properties": {
        "time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "seconds": {
          "description": "Sekunder sedan speldygnets midnatt; kan gå över 24 h.",
          "minimum": 0,
          "title": "Seconds",
          "type": "integer"
        },
        "running": {
          "description": "Falskt betyder stoppad klocka, inte tappad kontakt.",
          "title": "Running",
          "type": "boolean"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        }
      },
      "required": [
        "time",
        "seconds",
        "running",
        "speed",
        "game_day"
      ],
      "title": "Clock",
      "type": "object"
    },
    "DayChangeMode": {
      "enum": [
        "manual",
        "automatic"
      ],
      "title": "DayChangeMode",
      "type": "string"
    },
    "DayStatus": {
      "additionalProperties": true,
      "description": "Dygnsskiftet as Nu shows it (F7): when the next game day starts, and whether it is time.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/DayChangeMode"
        },
        "time": {
          "description": "När nästa speldygn börjar, efter midnatt.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "fixed": {
          "description": "Tiden är satt av trafikledningen, inte räknad.",
          "title": "Fixed",
          "type": "boolean"
        },
        "first": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nästa dags första tåg; tomt om dagen saknar tåg.",
          "title": "First"
        },
        "next_game_day": {
          "minimum": 1,
          "title": "Next Game Day",
          "type": "integer"
        },
        "next_traffic_day": {
          "$ref": "#/$defs/Weekday"
        },
        "suggested": {
          "description": "Klockan som Starta ny dag föreslår.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Suggested",
          "type": "string"
        },
        "due": {
          "description": "Manuellt: tiden har passerats, och nästa dag kan startas.",
          "title": "Due",
          "type": "boolean"
        },
        "waiting": {
          "description": "Automatiskt: tiden har passerats, men dagens tåg är ute (högst 30 min).",
          "title": "Waiting",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "time",
        "fixed",
        "next_game_day",
        "next_traffic_day",
        "suggested",
        "due",
        "waiting"
      ],
      "title": "DayStatus",
      "type": "object"
    },
    "LastJump": {
      "additionalProperties": true,
      "description": "The latest time jump or new day, while it can be undone (F6): until the next one.",
      "properties": {
        "seq": {
          "description": "Händelsens nummer, för Ångra.",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "kind": {
          "default": "time",
          "description": "Tidshopp eller ny dag.",
          "enum": [
            "time",
            "day"
          ],
          "title": "Kind",
          "type": "string"
        },
        "from_time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "From Time",
          "type": "string"
        },
        "to_time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "To Time",
          "type": "string"
        },
        "game_day": {
          "description": "Speldygnet efter.",
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        },
        "traffic_day": {
          "$ref": "#/$defs/Weekday",
          "description": "Trafikdagen efter."
        },
        "closed": {
          "description": "Antalet klareringar som stängdes.",
          "minimum": 0,
          "title": "Closed",
          "type": "integer"
        },
        "wall_time": {
          "format": "date-time",
          "title": "Wall Time",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "from_time",
        "to_time",
        "game_day",
        "traffic_day",
        "closed",
        "wall_time"
      ],
      "title": "LastJump",
      "type": "object"
    },
    "LegNow": {
      "additionalProperties": true,
      "description": "One train between two places today, and where it stands.",
      "properties": {
        "leg": {
          "description": "Avgångens tågbesök; nyckeln för sträckan.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Leg",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "train_type": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Type"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "from_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "From Place",
          "type": "string"
        },
        "to_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To Place",
          "type": "string"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "arrival": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "state": {
          "enum": [
            "planned",
            "requested",
            "cleared",
            "on_the_way",
            "arrived"
          ],
          "title": "State",
          "type": "string"
        },
        "clearance_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clearance Id"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ankomstspåret, planerat eller faktiskt.",
          "title": "Track"
        }
      },
      "required": [
        "leg",
        "train",
        "train_number",
        "section",
        "from_place",
        "to_place",
        "state"
      ],
      "title": "LegNow",
      "type": "object"
    },
    "NowPlace": {
      "additionalProperties": true,
      "properties": {
        "place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Place",
          "type": "string"
        },
        "code": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "place",
        "code",
        "name"
      ],
      "title": "NowPlace",
      "type": "object"
    },
    "Weekday": {
      "description": "The timetable's weekday (trafikdag). Not the same as the game day (Dag 1…N).",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "title": "Weekday",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "The meet as it runs: open to everyone, so it holds no names of people, no codes and no\nphone numbers (B13).",
  "properties": {
    "meet_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Meet Id",
      "type": "string"
    },
    "name": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "default": 1,
      "description": "Versionen av träffpaketet som körs.",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "traffic_day": {
      "$ref": "#/$defs/Weekday"
    },
    "game_day": {
      "title": "Game Day",
      "type": "integer"
    },
    "clock": {
      "$ref": "#/$defs/Clock"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/NowPlace"
      },
      "title": "Places",
      "type": "array"
    },
    "legs": {
      "items": {
        "$ref": "#/$defs/LegNow"
      },
      "title": "Legs",
      "type": "array"
    },
    "clearances": {
      "items": {
        "$ref": "#/$defs/Clearance"
      },
      "title": "Clearances",
      "type": "array"
    },
    "jump": {
      "anyOf": [
        {
          "$ref": "#/$defs/LastJump"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Det senaste tidshoppet eller nya dygnet, att ångra."
    },
    "day": {
      "anyOf": [
        {
          "$ref": "#/$defs/DayStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Dygnsskiftet."
    }
  },
  "required": [
    "meet_id",
    "name",
    "traffic_day",
    "game_day",
    "clock",
    "places",
    "legs",
    "clearances"
  ],
  "type": "object"
}
