{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.drift-1.now.schema.json",
  "title": "trainmeet.drift-1.now",
  "$defs": {
    "CallTime": {
      "additionalProperties": true,
      "properties": {
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "arrival": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        }
      },
      "required": [
        "call"
      ],
      "title": "CallTime",
      "type": "object"
    },
    "CancelTrain": {
      "additionalProperties": true,
      "description": "Ställ in tåg: the train does not run.",
      "properties": {
        "kind": {
          "const": "cancel",
          "default": "cancel",
          "title": "Kind",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        }
      },
      "required": [
        "train"
      ],
      "title": "CancelTrain",
      "type": "object"
    },
    "ChangeDays": {
      "additionalProperties": true,
      "description": "Ändrade trafikdagar för ett tåg.",
      "properties": {
        "kind": {
          "const": "days",
          "default": "days",
          "title": "Kind",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "days": {
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "minItems": 1,
          "title": "Days",
          "type": "array"
        }
      },
      "required": [
        "train",
        "days"
      ],
      "title": "ChangeDays",
      "type": "object"
    },
    "ChangeNow": {
      "additionalProperties": true,
      "description": "A Drift change as Nu lists it, with what it waits for.",
      "properties": {
        "change_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Change Id",
          "type": "string"
        },
        "change": {
          "discriminator": {
            "mapping": {
              "cancel": "#/$defs/CancelTrain",
              "days": "#/$defs/ChangeDays",
              "extra": "#/$defs/ExtraTrain",
              "no_stop": "#/$defs/NoStop",
              "note": "#/$defs/TrainNote",
              "number": "#/$defs/ChangeNumber",
              "place": "#/$defs/ChangePlace",
              "times": "#/$defs/ChangeTimes",
              "track": "#/$defs/ChangeTrack",
              "tracks": "#/$defs/ChangeSectionTracks"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CancelTrain"
            },
            {
              "$ref": "#/$defs/ExtraTrain"
            },
            {
              "$ref": "#/$defs/ChangeTimes"
            },
            {
              "$ref": "#/$defs/ChangePlace"
            },
            {
              "$ref": "#/$defs/ChangeTrack"
            },
            {
              "$ref": "#/$defs/ChangeSectionTracks"
            },
            {
              "$ref": "#/$defs/ChangeDays"
            },
            {
              "$ref": "#/$defs/ChangeNumber"
            },
            {
              "$ref": "#/$defs/NoStop"
            },
            {
              "$ref": "#/$defs/TrainNote"
            }
          ],
          "title": "Change"
        },
        "status": {
          "$ref": "#/$defs/ChangeStatus"
        },
        "forced": {
          "default": false,
          "title": "Forced",
          "type": "boolean"
        },
        "train_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tågets nummer då.",
          "title": "Train Number"
        },
        "made": {
          "description": "Modelltiden när ändringen gjordes.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Made",
          "type": "string"
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Svaret från Planering; tomt för Provbanan."
        },
        "waiting_for": {
          "description": "Tågnumren som är ute och som ändringen väntar på.",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Waiting For",
          "type": "array"
        }
      },
      "required": [
        "change_id",
        "change",
        "status",
        "made"
      ],
      "title": "ChangeNow",
      "type": "object"
    },
    "ChangeNumber": {
      "additionalProperties": true,
      "description": "Byte av tågnummer: the same train, a new number.",
      "properties": {
        "kind": {
          "const": "number",
          "default": "number",
          "title": "Kind",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Number",
          "type": "string"
        }
      },
      "required": [
        "train",
        "number"
      ],
      "title": "ChangeNumber",
      "type": "object"
    },
    "ChangePlace": {
      "additionalProperties": true,
      "description": "Ändrade driftplatser och sträckor: a section closed or opened, or its clearance mode;\nor a place unmanned, left to the automation, or manned again.",
      "properties": {
        "kind": {
          "const": "place",
          "default": "place",
          "title": "Kind",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "closed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closed"
        },
        "clearance_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClearanceMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place"
        },
        "place_kind": {
          "anyOf": [
            {
              "enum": [
                "manned",
                "unmanned"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Kind"
        }
      },
      "title": "ChangePlace",
      "type": "object"
    },
    "ChangeSectionTracks": {
      "additionalProperties": true,
      "description": "Enkel eller dubbel sträcka.",
      "properties": {
        "kind": {
          "const": "tracks",
          "default": "tracks",
          "title": "Kind",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "tracks": {
          "$ref": "#/$defs/TrackKind"
        }
      },
      "required": [
        "section",
        "tracks"
      ],
      "title": "ChangeSectionTracks",
      "type": "object"
    },
    "ChangeStatus": {
      "enum": [
        "applied",
        "waiting",
        "dropped"
      ],
      "title": "ChangeStatus",
      "type": "string"
    },
    "ChangeTimes": {
      "additionalProperties": true,
      "description": "Ändrade tider (tåg och möten): the whole train, or from a call on, moved some minutes;\nor new times for some calls.",
      "properties": {
        "kind": {
          "const": "times",
          "default": "times",
          "title": "Kind",
          "type": "string"
        },
        "train": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Train",
          "type": "string"
        },
        "minutes": {
          "default": 0,
          "description": "Minuter senare, eller tidigare.",
          "maximum": 720,
          "minimum": -720,
          "title": "Minutes",
          "type": "integer"
        },
        "from_call": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Flytta från avgången här; tomt betyder hela tåget.",
          "title": "From Call"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/CallTime"
          },
          "maxItems": 100,
          "title": "Calls",
          "type": "array"
        }
      },
      "required": [
        "train"
      ],
      "title": "ChangeTimes",
      "type": "object"
    },
    "ChangeTrack": {
      "additionalProperties": true,
      "description": "Ändrat planerat spår: another track for a call.",
      "properties": {
        "kind": {
          "const": "track",
          "default": "track",
          "title": "Kind",
          "type": "string"
        },
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "track": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "call",
        "track"
      ],
      "title": "ChangeTrack",
      "type": "object"
    },
    "Clearance": {
      "additionalProperties": true,
      "properties": {
        "clearance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Clearance Id",
          "type": "string"
        },
        "call": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Call",
          "type": "string"
        },
        "train_number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Train Number",
          "type": "string"
        },
        "section": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Section",
          "type": "string"
        },
        "from_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "From Place",
          "type": "string"
        },
        "to_place": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "To Place",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClearanceStatus"
        },
        "departed": {
          "default": false,
          "title": "Departed",
          "type": "boolean"
        },
        "requested_at": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Requested At",
          "type": "string"
        },
        "reminders": {
          "default": 0,
          "description": "Påminnelser hittills (H39).",
          "minimum": 0,
          "title": "Reminders",
          "type": "integer"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "clearance_id",
        "call",
        "train_number",
        "section",
        "from_place",
        "to_place",
        "status",
        "requested_at",
        "revision"
      ],
      "title": "Clearance",
      "type": "object"
    },
    "ClearanceMode": {
      "description": "Klareringsläge. Requested: the receiving place answers. Direct: Drift answers at once\nif the section is free. The meet has one; a section may have the other (decided 1 Nov).",
      "enum": [
        "requested",
        "direct"
      ],
      "title": "ClearanceMode",
      "type": "string"
    },
    "ClearanceStatus": {
      "enum": [
        "waiting",
        "approved",
        "rejected",
        "cancelled",
        "invalidated"
      ],
      "title": "ClearanceStatus",
      "type": "string"
    },
    "Clock": {
      "additionalProperties": true,
      "properties": {
        "time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "seconds": {
          "description": "Sekunder sedan speldygnets midnatt; kan gå över 24 h.",
          "minimum": 0,
          "title": "Seconds",
          "type": "integer"
        },
        "running": {
          "description": "Falskt betyder stoppad klocka, inte tappad kontakt.",
          "title": "Running",
          "type": "boolean"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        },
        "game_day": {
          "minimum": 1,
          "title": "Game Day",
          "type": "integer"
        }
      },
      "required": [
        "time",
        "seconds",
        "running",
        "speed",
        "game_day"
      ],
      "title": "Clock",
      "type": "object"
    },
    "DayChangeMode": {
      "enum": [
        "manual",
        "automatic"
      ],
      "title": "DayChangeMode",
      "type": "string"
    },
    "DayStatus": {
      "additionalProperties": true,
      "description": "Dygnsskiftet as Nu shows it (F7): when the next game day starts, and whether it is time.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/DayChangeMode"
        },
        "time": {
          "description": "När nästa speldygn börjar, efter midnatt.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "fixed": {
          "description": "Tiden är satt av trafikledningen, inte räknad.",
          "title": "Fixed",
          "type": "boolean"
        },
        "first": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nästa dags första tåg; tomt om dagen saknar tåg.",
          "title": "First"
        },
        "next_game_day": {
          "minimum": 1,
          "title": "Next Game Day",
          "type": "integer"
        },
        "next_traffic_day": {
          "$ref": "#/$defs/Weekday"
        },
        "suggested": {
          "description": "Klockan som Starta ny dag föreslår.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Suggested",
          "type": "string"
        },
        "due": {
          "description": "Manuellt: tiden har passerats, och nästa dag kan startas.",
          "title": "Due",
          "type": "boolean"
        },
        "waiting": {
          "description": "Automatiskt: tiden har passerats, men dagens tåg är ute (högst 30 min).",
          "title": "Waiting",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "time",
        "fixed",
        "next_game_day",
        "next_traffic_day",
        "suggested",
        "due",
        "waiting"
      ],
      "title": "DayStatus",
      "type": "object"
    },
    "DriverAlarm": {
      "additionalProperties": true,
      "description": "Ett tåg står utan förare på linjen (LOK-35): tjänsten släpptes där och ingen har tagit\növer. Utan förarens namn (B13).",
      "properties": {
        "service": {
          "$ref": "#/$defs/ServiceRef"
        },
        "number": {
          "description": "Tjänstens nummer, eller tågets.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "train": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train"
        },
        "train_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Number"
        },
        "section": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "from_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Place"
        },
        "to_place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Place"
        },
        "since": {
          "description": "Modelltiden när tjänsten släpptes.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Since",
          "type": "string"
        },
        "seq": {
          "description": "Drifthändelsen då tjänsten släpptes.",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "service",
        "number",
        "since",
        "seq"
      ],
      "title": "DriverAlarm",
      "type": "object"
    },
    "DriverMessageKind": {
      "description": "Förarens färdiga meddelanden till trafikledningen (LOK-23, DRIFT-38).",
      "enum": [
        "delayed",
        "stopped_on_line",
        "needs_help",
        "engine_trouble"
      ],
      "title": "DriverMessageKind",
      "type": "string"
    },
    "ExternalClockNow": {
      "additionalProperties": true,
      "description": "FastClock som träffens klocka (F12, IMPORT-35): Drift follows it, and Nu says so. Open\nto everyone who looks, so it holds no user or password.",
      "properties": {
        "source": {
          "const": "fastclock",
          "default": "fastclock",
          "title": "Source",
          "type": "string"
        },
        "name": {
          "description": "Klockans namn i FastClock.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "available": {
          "description": "FastClock svarar, och klockan följer den.",
          "title": "Available",
          "type": "boolean"
        },
        "can_control": {
          "description": "Start och stopp i Nu går till FastClock; annars bara i FastClock.",
          "title": "Can Control",
          "type": "boolean"
        },
        "warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Varför klockan står: inget svar, eller ett fel. Senaste tiden står kvar.",
          "title": "Warning"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "FastClocks orsak till paus eller stopp, om den har någon.",
          "title": "Reason"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "FastClocks meddelande, som det står.",
          "title": "Message"
        },
        "completed": {
          "default": false,
          "description": "Dagens spel är slut i FastClock.",
          "title": "Completed",
          "type": "boolean"
        },
        "weekday": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weekday"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "FastClocks veckodag. Den visas, men byter aldrig trafikdag."
        }
      },
      "required": [
        "name",
        "available",
        "can_control"
      ],
      "title": "ExternalClockNow",
      "type": "object"
    },
    "ExtraTrain": {
      "additionalProperties": true,
      "description": "Extratåg (H12): a copy of a train with a new number and time, or from–to with a\ndeparture time, where Drift fills in the places between.",
      "properties": {
        "kind": {
          "const": "extra",
          "default": "extra",
          "title": "Kind",
          "type": "string"
        },
        "number": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "departure": {
          "description": "Avgången från första driftplatsen.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Departure",
          "type": "string"
        },
        "copy_of": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tåget som kopieras.",
          "title": "Copy Of"
        },
        "from_place": {
          "anyOf": [
            {
