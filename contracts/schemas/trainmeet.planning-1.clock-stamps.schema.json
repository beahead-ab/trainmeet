{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.planning-1.clock-stamps.schema.json",
  "title": "trainmeet.planning-1.clock-stamps",
  "$defs": {
    "ClockStamp": {
      "additionalProperties": true,
      "description": "Intyget om rätten att använda tavlan: vem och när, utan personens namn.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "filename": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "by": {
          "description": "pin, eller personens id i TrainMeet ID.",
          "maxLength": 500,
          "minLength": 1,
          "title": "By",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "filename",
        "at",
        "by"
      ],
      "title": "ClockStamp",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "faces": {
      "items": {
        "$ref": "#/$defs/ClockStamp"
      },
      "title": "Faces",
      "type": "array"
    }
  },
  "type": "object"
}
