{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beahead-ab/trainmeet/blob/main/contracts/schemas/trainmeet.id-1.club-page.schema.json",
  "title": "trainmeet.id-1.club-page",
  "$defs": {
    "Club": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ClubRole",
          "description": "The person's role in the club."
        }
      },
      "required": [
        "id",
        "name",
        "role"
      ],
      "title": "Club",
      "type": "object"
    },
    "ClubRole": {
      "description": "A person's role in a club (KONTO-35).",
      "enum": [
        "admin",
        "member"
      ],
      "title": "ClubRole",
      "type": "string"
    },
    "Invitation": {
      "additionalProperties": true,
      "description": "An invitation to a club (KONTO-35) or to a shared fleet (KONTO-29). Gives nothing\nuntil the person it was sent to has said yes.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "title": {
          "description": "What it is about: the club's name, or whose fleet.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "sent_to": {
          "description": "The address, partly hidden to anyone but its owner.",
          "title": "Sent To",
          "type": "string"
        },
        "sent_by": {
          "$ref": "#/$defs/Person"
        },
        "state": {
          "$ref": "#/$defs/InvitationState"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "resource",
        "role",
        "title",
        "sent_to",
        "sent_by",
        "state",
        "at"
      ],
      "title": "Invitation",
      "type": "object"
    },
    "InvitationState": {
      "enum": [
        "waiting",
        "accepted",
        "declined"
      ],
      "title": "InvitationState",
      "type": "string"
    },
    "Meet": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "club": {
          "format": "uuid",
          "title": "Club",
          "type": "string"
        },
        "club_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Club Name",
          "type": "string"
        },
        "roles": {
          "description": "The person's own roles at the meet.",
          "items": {
            "$ref": "#/$defs/MeetRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "club_admin": {
          "default": false,
          "description": "The person is the club's admin, with the admin's say at its meets (KONTO-36). The Hub plans the meet then, as it does for the organizer (#78).",
          "title": "Club Admin",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "starts_on",
        "ends_on",
        "id",
        "club",
        "club_name",
        "roles"
      ],
      "title": "Meet",
      "type": "object"
    },
    "MeetRole": {
      "description": "The roles per meet that ID hands out until the Hub logs in with ID (ID10, KONTO-28).",
      "enum": [
        "organizer",
        "publisher",
        "reader",
        "dispatcher",
        "loco_lead",
        "remote_clearer"
      ],
      "title": "MeetRole",
      "type": "string"
    },
    "Member": {
      "additionalProperties": true,
      "properties": {
        "person": {
          "$ref": "#/$defs/Person"
        },
        "role": {
          "$ref": "#/$defs/ClubRole"
        },
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string"
        }
      },
      "required": [
        "person",
        "role",
        "since"
      ],
      "title": "Member",
      "type": "object"
    },
    "Person": {
      "additionalProperties": true,
      "description": "Someone else, as a member or someone with a role: never their address.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "initials": {
          "maxLength": 3,
          "minLength": 1,
          "title": "Initials",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "initials"
      ],
      "title": "Person",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": true,
      "description": "One thing a role applies to: its kind and its id in the app that owns it.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Resource",
      "type": "object"
    },
    "ResourceKind": {
      "description": "What a role applies to (KONTO-03). ID only holds the reference, never the thing.",
      "enum": [
        "club",
        "fleet",
        "meet",
        "station",
        "module",
        "hub",
        "catalog"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "Role": {
      "description": "The roles ID holds on one place (KONTO-28, KONTO-30, CAT-44, KONTO-35).",
      "enum": [
        "admin",
        "member",
        "organizer",
        "publisher",
        "reader",
        "dispatcher",
        "loco_lead",
        "remote_clearer",
        "reviewer",
        "viewer",
        "editor"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "A club as its members see it. Only the admin sees the waiting invitations.",
  "properties": {
    "club": {
      "$ref": "#/$defs/Club"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/Member"
      },
      "title": "Members",
      "type": "array"
    },
    "invitations": {
      "items": {
        "$ref": "#/$defs/Invitation"
      },
      "title": "Invitations",
      "type": "array"
    },
    "meets": {
      "description": "The club's meets (ID10).",
      "items": {
        "$ref": "#/$defs/Meet"
      },
      "title": "Meets",
      "type": "array"
    }
  },
  "required": [
    "club",
    "members"
  ],
  "type": "object"
}
