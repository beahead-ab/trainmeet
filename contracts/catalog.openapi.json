{
  "openapi": "3.1.0",
  "info": {
    "title": "TrainMeet Catalog · kontrakten",
    "version": "1"
  },
  "paths": {
    "/api/version": {
      "get": {
        "operationId": "catalogVersion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/trainmeet.catalog-1.version"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/1/session": {
      "get": {
        "operationId": "catalogSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/trainmeet.catalog-1.session"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "catalogLogOut",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/trainmeet.catalog-1.session"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/1/trial/accounts": {
      "get": {
        "operationId": "trialAccounts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/trainmeet.catalog-1.account"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/1/trial/login": {
      "post": {
        "operationId": "trialLogIn",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/trainmeet.catalog-1.session"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/trainmeet.catalog-1.trial-login"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "trainmeet.catalog-1.version": {
        "additionalProperties": true,
        "description": "What is running, so a tester can see which change the test environment has.",
        "properties": {
          "product": {
            "const": "TrainMeet Catalog",
            "default": "TrainMeet Catalog",
            "title": "Product",
            "type": "string"
          },
          "version": {
            "description": "The package version, for example 0.1.0.",
            "title": "Version",
            "type": "string"
          },
          "commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The git commit, or null locally.",
            "title": "Commit"
          },
          "pr": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The pull request the change came from.",
            "title": "Pr"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The title of that pull request.",
            "title": "Title"
          },
          "built": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "When the image was built, UTC.",
            "title": "Built"
          }
        },
        "required": [
          "version"
        ],
        "title": "CatalogVersion",
        "type": "object"
      },
      "trainmeet.catalog-1.account": {
        "additionalProperties": true,
        "description": "The person who is logged in, as Catalog knows them. The id comes from the login.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "The name the person shows.",
            "maxLength": 500,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "initials": {
            "description": "For the account button.",
            "maxLength": 3,
            "minLength": 1,
            "title": "Initials",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "initials"
        ],
        "title": "Account",
        "type": "object"
      },
      "trainmeet.catalog-1.session": {
        "additionalProperties": true,
        "description": "Who is logged in, if anyone, and how one logs in here.",
        "properties": {
          "account": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/trainmeet.catalog-1.session.Account"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "login": {
            "$ref": "#/components/schemas/trainmeet.catalog-1.session.LoginKind"
          }
        },
        "required": [
          "login"
        ],
        "title": "Session",
        "type": "object"
      },
      "trainmeet.catalog-1.session.Account": {
        "additionalProperties": true,
        "description": "The person who is logged in, as Catalog knows them. The id comes from the login.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "The name the person shows.",
            "maxLength": 500,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "initials": {
            "description": "For the account button.",
            "maxLength": 3,
            "minLength": 1,
            "title": "Initials",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "initials"
        ],
        "title": "Account",
        "type": "object"
      },
      "trainmeet.catalog-1.session.LoginKind": {
        "description": "How people log in to this Catalog.",
        "enum": [
          "trial",
          "id"
        ],
        "title": "LoginKind",
        "type": "string"
      },
      "trainmeet.catalog-1.trial-login": {
        "additionalProperties": true,
        "description": "Log in as one of the trial login's fixed accounts (GET /api/catalog/1/trial/accounts).",
        "properties": {
          "account": {
            "format": "uuid",
            "title": "Account",
            "type": "string"
          }
        },
        "required": [
          "account"
        ],
        "title": "TrialLogin",
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "catalog_session"
      }
    }
  },
  "security": [
    {
      "session": []
    }
  ]
}
