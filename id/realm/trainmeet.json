{
  "realm": "trainmeet",
  "displayName": "TrainMeet ID",
  "enabled": true,
  "sslRequired": "external",
  "loginTheme": "trainmeet",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "sv",
    "en"
  ],
  "defaultLocale": "sv",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1209600,
  "ssoSessionMaxLifespan": 2592000,
  "browserFlow": "trainmeet-browser",
  "webAuthnPolicyPasswordlessRpEntityName": "TrainMeet",
  "webAuthnPolicyPasswordlessResidentKey": "required",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "smtpServer": {
    "host": "${ID_SMTP_HOST}",
    "port": "${ID_SMTP_PORT}",
    "from": "${ID_SMTP_FROM}",
    "fromDisplayName": "TrainMeet",
    "auth": "${ID_SMTP_AUTH}",
    "user": "${ID_SMTP_USER}",
    "password": "${vault.smtp-password}",
    "ssl": "${ID_SMTP_SSL}",
    "starttls": "${ID_SMTP_STARTTLS}"
  },
  "authenticationFlows": [
    {
      "alias": "trainmeet-browser",
      "description": "Inloggningen med en kod till e-posten, utan lösenord (ID5). Den som redan är inloggad kommer direkt in.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "trainmeet-email-code",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 80,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "catalog",
      "name": "TrainMeet Catalog",
      "description": "Catalog loggar in med ID (KONTO-27) och frågar ID:s API om rätten med en egen token (KONTO-34, #49).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ID_CATALOG_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "redirectUris": [
        "${ID_CATALOG_URL}/api/catalog/1/id/callback"
      ],
      "webOrigins": [
        "${ID_CATALOG_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ID_CATALOG_URL}/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "id",
      "name": "TrainMeet ID",
      "description": "ID:s egen webbapp: klubbar, medlemmar och roller (#67).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ID_APP_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "redirectUris": [
        "${ID_PUBLIC_URL}/api/id/1/login/callback"
      ],
      "webOrigins": [
        "${ID_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ID_PUBLIC_URL}/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "kc-admin-api"
      ]
    },
    {
      "clientId": "hub",
      "name": "TrainMeet Hub",
      "description": "Hubben loggar in med ID (#78) och frågar ID:s API om rollerna på träffen med en egen token (KONTO-34).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ID_HUB_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "redirectUris": [
        "${ID_HUB_URL}/api/hub/id/callback"
      ],
      "webOrigins": [
        "${ID_HUB_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ID_HUB_URL}/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "tkl",
      "name": "TrainMeet TKL",
      "description": "TKL loggar in med ID (#78, TKL18) och sparar stationspaketen i molnhubben med ägarens token (SYNK-30). En publik klient med PKCE: TKL körs också på stationens egen dator, som inte kan hålla en hemlighet.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "${ID_TKL_URL}/api/tkl/1/id/callback",
        "http://localhost:8090/api/tkl/1/id/callback",
        "http://127.0.0.1:8090/api/tkl/1/id/callback"
      ],
      "webOrigins": [
        "${ID_TKL_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ID_TKL_URL}/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "cad",
      "name": "TrainMeet CAD",
      "description": "CAD loggar in med ID (#89) och frågar ID:s API om klubbarna och rollerna med en egen token (KONTO-34), som Catalog.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ID_CAD_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "redirectUris": [
        "${ID_CAD_URL}/api/cad/1/id/callback"
      ],
      "webOrigins": [
        "${ID_CAD_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ID_CAD_URL}/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email"
      ]
    }
  ],
  "attributes": {
    "trainmeetVersion": "8"
  },
  "users": [
    {
      "username": "service-account-id",
      "enabled": true,
      "serviceAccountClientId": "id",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ]
}
